{
    "version": "1.0.0",
    "layout_name": "portfolio/detail",
    "permissions": [],
    "extends": "_user_base",
    "meta": {
        "title": "$t:twentyft.routes.portfolio_detail.title",
        "description": "$t:twentyft.routes.portfolio_detail.description",
        "seo": {
            "enabled": true,
            "page_type": "portfolio_detail",
            "data_sources": ["portfolio_item"],
            "og": {
                "type": "article",
                "title": "{{portfolio_item.data.title ?? 'Portfolio'}} | Portfolio | 20ft",
                "description": "{{portfolio_item.data.summary ?? '20ft가 직접 기획하고 개발한 프로젝트입니다.'}}"
            }
        }
    },
    "data_sources": [
        {
            "id": "portfolio_item",
            "label_key": "$t:twentyft.data_source.portfolio_item",
            "type": "api",
            "endpoint": "/api/modules/twentyft-content/portfolio/projects/{{route.slug}}",
            "method": "GET",
            "auto_fetch": true,
            "loading_strategy": "blocking"
        }
    ],
    "slots": {
        "content": [
            {
                "id": "portfolio_detail",
                "type": "composite",
                "name": "PortfolioDetail",
                "props": {
                    "item": "{{portfolio_item?.data ?? null}}"
                }
            }
        ]
    }
}

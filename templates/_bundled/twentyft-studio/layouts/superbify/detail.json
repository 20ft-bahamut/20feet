{
    "version": "1.0.0",
    "layout_name": "superbify/detail",
    "permissions": [],
    "extends": "_user_base",
    "meta": {
        "title": "$t:twentyft.routes.superbify_detail.title",
        "description": "$t:twentyft.routes.superbify_detail.description",
        "seo": {
            "enabled": true,
            "page_type": "superbify_detail",
            "data_sources": ["superbify_item"],
            "og": {
                "type": "article",
                "title": "{{superbify_item.data.title ?? 'SuperBify'}} | SuperBify | 20ft",
                "description": "{{superbify_item.data.summary ?? '20ft가 만드는 Gnuboard 7 확장 제품입니다.'}}"
            }
        }
    },
    "data_sources": [
        {
            "id": "superbify_item",
            "label_key": "$t:twentyft.data_source.superbify_item",
            "type": "api",
            "endpoint": "/api/modules/twentyft-content/superbify/projects/{{route.slug}}",
            "method": "GET",
            "auto_fetch": true,
            "loading_strategy": "blocking"
        }
    ],
    "slots": {
        "content": [
            {
                "id": "superbify_detail",
                "type": "composite",
                "name": "SuperBifyDetail",
                "props": {
                    "item": "{{superbify_item?.data ?? null}}"
                }
            }
        ]
    }
}

{
    "version": "1.0.0",
    "layout_name": "home",
    "permissions": [],
    "extends": "_user_base",
    "meta": {
        "title": "$t:twentyft.routes.home.title",
        "description": "$t:twentyft.routes.home.description",
        "seo": {
            "enabled": true,
            "page_type": "home",
            "og": {
                "type": "website",
                "title": "$t:twentyft.routes.home.title",
                "description": "$t:twentyft.routes.home.description"
            },
            "structured_data": {
                "@type": "Organization",
                "name": "20ft",
                "description": "$t:twentyft.routes.home.description"
            }
        }
    },
    "data_sources": [
        {
            "id": "portfolio_preview",
            "label_key": "$t:twentyft.data_source.portfolio_preview",
            "type": "api",
            "endpoint": "/api/modules/twentyft-content/portfolio/projects",
            "method": "GET",
            "params": {
                "featured": "1",
                "per_page": "3"
            },
            "auto_fetch": true,
            "loading_strategy": "progressive"
        },
        {
            "id": "superbify_preview",
            "label_key": "$t:twentyft.data_source.superbify_preview",
            "type": "api",
            "endpoint": "/api/modules/twentyft-content/superbify/projects",
            "method": "GET",
            "params": {
                "featured": "1",
                "per_page": "2"
            },
            "auto_fetch": true,
            "loading_strategy": "progressive"
        }
    ],
    "slots": {
        "content": [
            {
                "comment": "F-101: 첫 화면 — 제목·설명·행동만",
                "id": "home_hero",
                "type": "composite",
                "name": "HomeHero"
            },
            {
                "comment": "F-102: 주요 제작 사례 — 실제 화면을 첫 화면 바로 다음에 둔다",
                "id": "home_cases",
                "type": "composite",
                "name": "HomeCases",
                "props": {
                    "items": "{{portfolio_preview?.data ?? null}}",
                    "demos": "{{superbify_preview?.data ?? null}}"
                }
            },
            {
                "comment": "F-103: 제작 서비스 3종 — 제공 내용 한 줄 + 상세 링크",
                "id": "home_services",
                "type": "composite",
                "name": "HomeServices"
            },
            {
                "comment": "F-104: 담당자 경험 — 확인된 경력 + 관련 사례·소개 연결",
                "id": "home_experience",
                "type": "composite",
                "name": "HomeExperience",
                "props": {
                    "cases": "{{portfolio_preview?.data ?? null}}"
                }
            },
            {
                "comment": "F-105: 진행 방법 — 단계마다 한 문장",
                "id": "home_process",
                "type": "composite",
                "name": "HomeProcess"
            },
            {
                "comment": "F-107: 문의",
                "id": "home_inquiry_cta",
                "type": "composite",
                "name": "HomeInquiryCTA"
            }
        ]
    }
}

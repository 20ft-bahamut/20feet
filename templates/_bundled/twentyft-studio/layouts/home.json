{
    "version": "1.0.0",
    "layout_name": "home",
    "permissions": [],
    "extends": "_user_base",
    "meta": {
        "title": "$t:twentyft.routes.home.title",
        "description": "$t:twentyft.routes.home.description",
        "seo": {
            "enabled": true,
            "page_type": "home",
            "og": {
                "type": "website",
                "title": "$t:twentyft.routes.home.title",
                "description": "$t:twentyft.routes.home.description"
            },
            "structured_data": {
                "@type": "Organization",
                "name": "20ft",
                "description": "$t:twentyft.routes.home.description"
            }
        }
    },
    "data_sources": [
        {
            "id": "portfolio_preview",
            "label_key": "$t:twentyft.data_source.portfolio_preview",
            "type": "api",
            "endpoint": "/api/modules/twentyft-content/portfolio/projects",
            "method": "GET",
            "params": {
                "featured": "1",
                "per_page": "3"
            },
            "auto_fetch": true,
            "loading_strategy": "progressive"
        },
        {
            "id": "superbify_preview",
            "label_key": "$t:twentyft.data_source.superbify_preview",
            "type": "api",
            "endpoint": "/api/modules/twentyft-content/superbify/projects",
            "method": "GET",
            "params": {
                "featured": "1",
                "per_page": "3"
            },
            "auto_fetch": true,
            "loading_strategy": "progressive"
        }
    ],
    "slots": {
        "content": [
            {
                "id": "home_hero",
                "type": "composite",
                "name": "HomeHero"
            },
            {
                "id": "home_what_we_build",
                "type": "composite",
                "name": "HomeWhatWeBuild"
            },
            {
                "id": "home_selected_portfolio",
                "type": "composite",
                "name": "SelectedPortfolio",
                "props": {
                    "items": "{{portfolio_preview?.data ?? null}}"
                }
            },
            {
                "id": "home_superbify_preview",
                "type": "composite",
                "name": "SuperBifyPreview",
                "props": {
                    "items": "{{superbify_preview?.data ?? null}}"
                }
            },
            {
                "id": "home_about_preview",
                "type": "composite",
                "name": "AboutPreview"
            },
            {
                "id": "home_how_we_work",
                "type": "composite",
                "name": "HomeHowWeWork"
            },
            {
                "id": "home_inquiry_motto_cta",
                "type": "composite",
                "name": "InquiryMottoCTA"
            }
        ]
    }
}

{
    "version": "1.0.0",
    "layout_name": "about",
    "permissions": [],
    "extends": "_user_base",
    "meta": {
        "title": "$t:twentyft.routes.about.title",
        "description": "$t:twentyft.routes.about.description",
        "seo": {
            "enabled": true,
            "page_type": "about",
            "og": {
                "type": "website",
                "title": "$t:twentyft.routes.about.title",
                "description": "$t:twentyft.routes.about.description"
            }
        }
    },
    "data_sources": [
        {
            "id": "about_cases",
            "label_key": "$t:twentyft.data_source.about_cases",
            "type": "api",
            "endpoint": "/api/modules/twentyft-content/portfolio/projects",
            "method": "GET",
            "params": {
                "per_page": "6"
            },
            "auto_fetch": true,
            "loading_strategy": "progressive"
        }
    ],
    "slots": {
        "content": [
            {
                "comment": "F-401: 이십피트 소개 — 해온 일, 담당 범위, 일하는 방식",
                "id": "about_page",
                "type": "composite",
                "name": "AboutPage",
                "props": {
                    "cases": "{{about_cases?.data ?? null}}"
                }
            }
        ]
    }
}

{
    "version": "1.0.0",
    "layout_name": "shop/notice",
    "permissions": [],
    "extends": "_user_base",
    "meta": {
        "title": "$t:superbify.routes.notice.title",
        "description": "$t:superbify.routes.notice.description"
    },
    "slots": {
        "content": [
            {
                "id": "shop_notice",
                "type": "basic",
                "name": "Section",
                "style": {
                    "paddingBlock": "var(--scm-section-py-md, 3rem)"
                },
                "children": [
                    {
                        "id": "shop_notice_inner",
                        "type": "basic",
                        "name": "Div",
                        "style": {
                            "maxWidth": "var(--scm-max-width, 1200px)",
                            "marginInline": "auto",
                            "paddingInline": "var(--scm-gutter, 1rem)",
                            "display": "flex",
                            "flexDirection": "column",
                            "gap": "var(--scm-spacing-md, 1rem)"
                        },
                        "children": [
                            {
                                "id": "shop_notice_eyebrow",
                                "type": "basic",
                                "name": "Span",
                                "style": {
                                    "fontFamily": "var(--scm-font-body, system-ui)",
                                    "fontSize": "0.75rem",
                                    "color": "var(--scm-text-muted, #8A837B)",
                                    "letterSpacing": "0.08em",
                                    "textTransform": "uppercase"
                                },
                                "text": "$t:superbify.notice.eyebrow"
                            },
                            {
                                "id": "shop_notice_title",
                                "type": "basic",
                                "name": "H1",
                                "style": {
                                    "fontFamily": "var(--scm-font-display, system-ui)",
                                    "fontSize": "1.75rem",
                                    "fontWeight": "700",
                                    "color": "var(--scm-text-primary, #26221E)",
                                    "margin": "0"
                                },
                                "text": "$t:superbify.notice.title"
                            },
                            {
                                "id": "shop_notice_empty",
                                "type": "composite",
                                "name": "EmptyState",
                                "props": {
                                    "title": "$t:superbify.notice.empty_title",
                                    "message": "$t:superbify.notice.empty_message"
                                }
                            }
                        ]
                    }
                ]
            }
        ]
    }
}

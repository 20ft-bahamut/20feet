{
    "version": "1.0.0",
    "layout_name": "shop/story",
    "permissions": [],
    "extends": "_user_base",
    "meta": {
        "title": "$t:superbify.routes.story.title",
        "description": "$t:superbify.routes.story.description"
    },
    "slots": {
        "content": [
            {
                "id": "shop_story",
                "type": "basic",
                "name": "Section",
                "style": {
                    "paddingBlock": "var(--scm-section-py-md, 3rem)"
                },
                "children": [
                    {
                        "id": "shop_story_inner",
                        "type": "basic",
                        "name": "Div",
                        "style": {
                            "maxWidth": "var(--scm-max-width, 1200px)",
                            "marginInline": "auto",
                            "paddingInline": "var(--scm-gutter, 1rem)"
                        },
                        "children": [
                            {
                                "id": "shop_story_component",
                                "type": "composite",
                                "name": "BrandStorySection",
                                "props": {
                                    "eyebrow": "$t:superbify.story.eyebrow",
                                    "heading": "$t:superbify.story.title",
                                    "body": "$t:superbify.story.body",
                                    "mediaSlot": "hero-mood-3"
                                }
                            }
                        ]
                    }
                ]
            }
        ]
    }
}

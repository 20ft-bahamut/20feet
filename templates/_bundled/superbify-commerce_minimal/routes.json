{
    "version": "1.0.0",
    "description": "SuperBify Commerce Minimal 라우트 정의 (Demo D2C store)",
    "routes": [
        {
            "_comment": "=== 홈 ===",
            "path": "/",
            "layout": "home",
            "auth_required": false,
            "meta": {
                "title": "$t:superbify.routes.home.title"
            }
        },
        {
            "_comment": "=== Shop 목록 ===",
            "path": "/shop",
            "layout": "shop/index",
            "auth_required": false,
            "meta": {
                "title": "$t:superbify.routes.shop.title"
            }
        },
        {
            "_comment": "=== 카테고리 ===",
            "path": "/shop/category/:slug",
            "layout": "shop/category",
            "auth_required": false,
            "meta": {
                "title": "$t:superbify.routes.category.title"
            }
        },
        {
            "_comment": "=== 상품 상세 ===",
            "path": "/shop/product/:slug",
            "layout": "shop/product",
            "auth_required": false,
            "meta": {
                "title": "$t:superbify.routes.product.title"
            }
        },
        {
            "_comment": "=== 공지 ===",
            "path": "/shop/notice",
            "layout": "shop/notice",
            "auth_required": false,
            "meta": {
                "title": "$t:superbify.routes.notice.title"
            }
        },
        {
            "_comment": "=== 공지 상세 ===",
            "path": "/shop/notice/:id",
            "layout": "shop/notice-detail",
            "auth_required": false,
            "meta": {
                "title": "$t:superbify.routes.notice_detail.title",
                "description": "$t:superbify.routes.notice_detail.description"
            }
        },
        {
            "_comment": "=== 브랜드 스토리 ===",
            "path": "/shop/story",
            "layout": "shop/story",
            "auth_required": false,
            "meta": {
                "title": "$t:superbify.routes.story.title"
            }
        },
        {
            "_comment": "=== 정책 문서 (config/business-info.json 단일 소스) ===",
            "path": "/shop/terms",
            "layout": "shop/terms",
            "auth_required": false,
            "meta": {
                "title": "$t:superbify.routes.terms.title"
            }
        },
        {
            "path": "/shop/privacy",
            "layout": "shop/privacy",
            "auth_required": false,
            "meta": {
                "title": "$t:superbify.routes.privacy.title"
            }
        },
        {
            "path": "/shop/shipping-policy",
            "layout": "shop/shipping-policy",
            "auth_required": false,
            "meta": {
                "title": "$t:superbify.routes.shipping_policy.title"
            }
        },
        {
            "_comment": "=== 장바구니 ===",
            "path": "/cart",
            "layout": "cart",
            "auth_required": false,
            "meta": {
                "title": "$t:superbify.routes.cart.title"
            }
        },
        {
            "_comment": "=== 결제 ===",
            "path": "/shop/checkout",
            "layout": "shop/checkout",
            "auth_required": false,
            "meta": {
                "title": "$t:superbify.routes.checkout.title"
            }
        },
        {
            "_comment": "=== 주문 완료 ===",
            "path": "/shop/order/complete",
            "layout": "shop/order_complete",
            "auth_required": false,
            "meta": {
                "title": "$t:superbify.routes.order_complete.title"
            }
        },
        {
            "_comment": "=== 주문 완료 (ShopPathResolver 경로) — sirsoft-ecommerce 가 응답 redirect_url 로 돌려주는 표준 경로. route.id = order_number ===",
            "path": "/shop/orders/:order_number/complete",
            "layout": "shop/order_complete",
            "auth_required": false,
            "meta": {
                "title": "$t:superbify.routes.order_complete.title"
            }
        },
        {
            "_comment": "=== 비회원 주문 조회 폼 ===",
            "path": "/shop/guest/orders",
            "layout": "shop/guest_order_form",
            "auth_required": false,
            "meta": {
                "title": "$t:superbify.routes.guest_order_form.title"
            }
        },
        {
            "_comment": "=== 비회원 주문 상세 ===",
            "path": "/shop/guest/orders/:order_number",
            "layout": "shop/guest_order_show",
            "auth_required": false,
            "meta": {
                "title": "$t:superbify.routes.guest_order_show.title"
            }
        },
        {
            "_comment": "=== 인증 (v0.2.0 member features) === auth_required:false — guest_only 엔진 강제가 없어 로그인 상태 진입은 auth partial(_redirect_if_logged_in)이 처리한다.",
            "path": "/login",
            "layout": "auth/login",
            "auth_required": false,
            "meta": {
                "title": "$t:superbify.routes.login"
            }
        },
        {
            "path": "/register",
            "layout": "auth/register",
            "auth_required": false,
            "meta": {
                "title": "$t:superbify.routes.register"
            }
        },
        {
            "path": "/forgot-password",
            "layout": "auth/forgot_password",
            "auth_required": false,
            "meta": {
                "title": "$t:superbify.routes.forgot_password"
            }
        },
        {
            "path": "/reset-password",
            "layout": "auth/reset_password",
            "auth_required": false,
            "meta": {
                "title": "$t:superbify.routes.reset_password"
            }
        },
        {
            "_comment": "=== 마이페이지 (v0.2.0 member features) === 라우트 가드는 Router 가 checkAuth 후 /login?redirect= 로 보낸다 (sirsoft-basic routes.json 의 redirect 스키마와 동일). 개별 탭 레이아웃은 auth WP(WP3/4/6)가 만든다 — 여기서는 경로 등록만 한다.",
            "path": "/mypage",
            "redirect": "/mypage/orders",
            "auth_required": true,
            "meta": {
                "title": "$t:superbify.routes.mypage"
            }
        },
        {
            "path": "/mypage/profile",
            "layout": "mypage/profile",
            "auth_required": true,
            "meta": {
                "title": "$t:superbify.routes.mypage_profile"
            }
        },
        {
            "path": "/mypage/profile/edit",
            "layout": "mypage/profile_edit",
            "auth_required": true,
            "meta": {
                "title": "$t:superbify.routes.mypage_profile_edit"
            }
        },
        {
            "path": "/mypage/change-password",
            "layout": "mypage/change_password",
            "auth_required": true,
            "meta": {
                "title": "$t:superbify.routes.mypage_change_password"
            }
        },
        {
            "path": "/mypage/orders",
            "layout": "mypage/orders",
            "auth_required": true,
            "meta": {
                "title": "$t:superbify.routes.mypage_orders"
            }
        },
        {
            "path": "/mypage/orders/:order_number",
            "layout": "mypage/order_show",
            "auth_required": true,
            "meta": {
                "title": "$t:superbify.routes.mypage_order"
            }
        },
        {
            "path": "/mypage/addresses",
            "layout": "mypage/addresses",
            "auth_required": true,
            "meta": {
                "title": "$t:superbify.routes.mypage_addresses"
            }
        },
        {
            "path": "/mypage/wishlist",
            "layout": "mypage/wishlist",
            "auth_required": true,
            "meta": {
                "title": "$t:superbify.routes.mypage_wishlist"
            }
        },
        {
            "path": "/mypage/coupons",
            "layout": "mypage/coupons",
            "auth_required": true,
            "meta": {
                "title": "$t:superbify.routes.mypage_coupons"
            }
        },
        {
            "path": "/mypage/mileage",
            "layout": "mypage/mileage",
            "auth_required": true,
            "meta": {
                "title": "$t:superbify.routes.mypage_mileage"
            }
        },
        {
            "path": "/mypage/inquiries",
            "layout": "mypage/inquiries",
            "auth_required": true,
            "meta": {
                "title": "$t:superbify.routes.mypage_inquiries"
            }
        },
        {
            "_comment": "=== 재주문 (v0.2.0) — 마이페이지 주문 상세에서 담기 → /cart === 레이아웃은 onMount apiCall POST user/orders/{id}/reorder 로 처리 (WP4).",
            "path": "/reorder/:id",
            "layout": "shop/reorder",
            "auth_required": true,
            "meta": {
                "title": "$t:superbify.routes.reorder"
            }
        },
        {
            "_comment": "=== 에러 페이지 ===",
            "path": "/404",
            "layout": "errors/404",
            "auth_required": false,
            "meta": {
                "title": "$t:superbify.errors.not_found_title"
            }
        },
        {
            "path": "/403",
            "layout": "errors/403",
            "auth_required": false,
            "meta": {
                "title": "$t:superbify.errors.forbidden_title"
            }
        },
        {
            "path": "/500",
            "layout": "errors/500",
            "auth_required": false,
            "meta": {
                "title": "$t:superbify.errors.server_error_title"
            }
        }
    ]
}

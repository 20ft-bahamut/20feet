{
    "version": "1.0.0",
    "layout_name": "cart",
    "permissions": [],
    "extends": "_user_base",
    "meta": {
        "title": "$t:superbify.routes.cart.title",
        "description": "$t:superbify.routes.cart.description"
    },
    "data_sources": [
        {
            "id": "cart",
            "label_key": "$t:superbify.data_source.cart",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/cart",
            "method": "GET",
            "auto_fetch": true,
            "auth_mode": "optional",
            "loading_strategy": "progressive",
            "fallback": { "data": { "items": [], "item_ids": [], "item_count": 0, "calculation": null } }
        }
    ],
    "init_actions": [
        {
            "comment": "CartItemRow 가 발생시키는 scm:cart-qty-change / scm:cart-delete 이벤트 리스너 부착",
            "handler": "scmBindCartPageListeners"
        }
    ],
    "slots": {
        "content": [
            {
                "id": "cart_page",
                "type": "basic",
                "name": "Section",
                "style": {
                    "paddingBlock": "var(--scm-section-py-md, 3rem)"
                },
                "children": [
                    {
                        "id": "cart_page_inner",
                        "type": "basic",
                        "name": "Div",
                        "style": {
                            "maxWidth": "var(--scm-max-width, 1200px)",
                            "marginInline": "auto",
                            "paddingInline": "var(--scm-gutter, 1rem)",
                            "display": "flex",
                            "flexDirection": "column",
                            "gap": "var(--scm-spacing-md, 1rem)"
                        },
                        "children": [
                            {
                                "id": "cart_page_title",
                                "type": "basic",
                                "name": "H1",
                                "style": {
                                    "fontFamily": "var(--scm-font-display, system-ui)",
                                    "fontSize": "1.75rem",
                                    "fontWeight": "700",
                                    "color": "var(--scm-text-primary, #26221E)",
                                    "margin": "0"
                                },
                                "text": "$t:superbify.cart.title"
                            },
                            {
                                "id": "cart_page_empty",
                                "type": "composite",
                                "name": "EmptyState",
                                "if": "{{!cart?.data?.items || (cart.data.items?.length ?? 0) === 0}}",
                                "props": {
                                    "title": "$t:superbify.cart.empty_title",
                                    "message": "$t:superbify.cart.empty_message",
                                    "ctaLabel": "$t:superbify.cart.cta_shop",
                                    "ctaHref": "/shop"
                                }
                            },
                            {
                                "id": "cart_page_layout",
                                "if": "{{cart?.data?.items && (cart.data.items?.length ?? 0) > 0}}",
                                "type": "basic",
                                "name": "Div",
                                "style": {
                                    "display": "grid",
                                    "gridTemplateColumns": "1.5fr 1fr",
                                    "gap": "var(--scm-spacing-xl, 2.5rem)",
                                    "alignItems": "start"
                                },
                                "responsive": {
                                    "mobile": {
                                        "style": { "gridTemplateColumns": "1fr", "gap": "var(--scm-spacing-lg, 1.5rem)" }
                                    }
                                },
                                "children": [
                                    {
                                        "id": "cart_page_items",
                                        "type": "basic",
                                        "name": "Div",
                                        "style": {
                                            "display": "flex",
                                            "flexDirection": "column",
                                            "border": "1px solid var(--scm-line, #E4DCCE)",
                                            "borderRadius": "var(--scm-radius, 8px)",
                                            "backgroundColor": "var(--scm-paper, #FAF8F3)",
                                            "padding": "0 var(--scm-spacing-md, 1rem) var(--scm-spacing-md, 1rem)"
                                        },
                                        "children": [
                                            {
                                                "id": "cart_page_items_iter",
                                                "type": "composite",
                                                "name": "CartItemRow",
                                                "iteration": { "source": "{{cart.data.items ?? []}}", "item_var": "item" },
                                                "props": {
                                                    "item": "{{item}}",
                                                    "quantityLabel": "$t:superbify.cart.quantity",
                                                    "deleteLabel": "$t:superbify.cart.delete",
                                                    "applyLabel": "$t:superbify.cart.apply"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "id": "cart_page_summary",
                                        "type": "composite",
                                        "name": "CartSummary",
                                        "props": {
                                            "items": "{{cart.data.items}}",
                                            "itemCount": "{{cart.data.item_count ?? (cart.data.items?.length ?? 0)}}",
                                            "calculation": "{{cart.data.calculation?.summary ?? cart.data.calculation}}",
                                            "summaryTitle": "$t:superbify.cart.summary_title",
                                            "itemsLabel": "$t:superbify.cart.summary_items",
                                            "subtotalLabel": "$t:superbify.cart.summary_subtotal",
                                            "shippingLabel": "$t:superbify.cart.summary_shipping",
                                            "totalLabel": "$t:superbify.cart.summary_total",
                                            "checkoutLabel": "$t:superbify.cart.summary_checkout",
                                            "continueShoppingLabel": "$t:superbify.cart.summary_continue_shopping"
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}

{
    "version": "1.0.0",
    "layout_name": "_user_base",
    "meta": {
        "title": "$t:superbify.base_layout_title",
        "description": "$t:superbify.base_layout_description",
        "is_base": true
    },
    "globalHeaders": [
        {
            "_comment": "이커머스 API에 X-Cart-Key 자동 첨부 — _global.cartKey는 initCartKey 핸들러가 localStorage + 서버 응답 헤더를 통해 주입한다 (sirsoft-basic 패턴과 동일). 미설치 상태에서 X-Cart-Key는 빈 문자열로 전달되어도 서버는 새 게스트 키를 발급한다.",
            "pattern": "/api/modules/sirsoft-ecommerce/*",
            "headers": {
                "X-Cart-Key": "{{_global.cartKey}}"
            }
        },
        {
            "_comment": "인증 API에도 X-Cart-Key 자동 첨부 — 로그인 직후 모듈 MergeCartOnLogin 이 게스트 장바구니를 회원 장바구니로 병합한다. 헤더가 없으면 병합 대상 게스트 키를 서버가 알 수 없다 (v0.2.0 member features).",
            "pattern": "/api/auth/*",
            "headers": {
                "X-Cart-Key": "{{_global.cartKey}}"
            }
        }
    ],
    "init_actions": [
        {
            "_comment": "localStorage의 g7_cart_key → _global.cartKey 주입. 비어 있으면 서버가 새 cart key를 응답 헤더로 내려준다.",
            "handler": "initCartKey"
        },
        {
            "_comment": "shop base URL 주입 — sirsoft-basic 패턴 미러. admin basic_info(no_route/route_path) 변경 시 자동 반영. 모든 shop 링크(헤더/푸터/카테고리/카트/체크아웃)가 동일한 _global.shopBase 를 참조해 회귀 위험을 차단한다.",
            "handler": "setState",
            "params": {
                "target": "global",
                "shopBase": "{{_global.modules?.['sirsoft-ecommerce']?.basic_info?.no_route ? '' : ('/' + (_global.modules?.['sirsoft-ecommerce']?.basic_info?.route_path ?? 'shop'))}}"
            }
        }
    ],
    "data_sources": [
        {
            "_comment": "장바구니 수량 — 헤더의 카운트 뱃지에 사용",
            "id": "cart_count",
            "label_key": "$t:superbify.data_source.cart_count",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/cart/count",
            "method": "GET",
            "auto_fetch": true,
            "auth_mode": "optional",
            "loading_strategy": "progressive",
            "initGlobal": {
                "key": "cartCount",
                "path": "count"
            },
            "fallback": {
                "data": {
                    "count": 0
                }
            }
        },
        {
            "_comment": "로그인 사용자 — StoreHeader 인증 상태(이름/마이페이지/로그아웃)에 사용. 비회원의 401은 정상 상태이므로 suppress 로 레이아웃 에러 전파를 막고 fallback 을 쓴다 (sirsoft-basic _user_base 패턴 복제).",
            "id": "current_user",
            "label_key": "$t:superbify.data_source.current_user",
            "type": "api",
            "endpoint": "/api/auth/user",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "loading_strategy": "progressive",
            "initGlobal": "currentUser",
            "fallback": {
                "data": []
            },
            "errorHandling": {
                "401": {
                    "handler": "suppress"
                }
            }
        }
    ],
    "components": [
        {
            "id": "user_layout_root",
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "user-layout-root"
            },
            "style": {
                "minHeight": "100vh",
                "display": "flex",
                "flexDirection": "column",
                "backgroundColor": "var(--scm-bg-primary, #FAF8F3)",
                "color": "var(--scm-text-primary, #26221E)"
            },
            "children": [
                {
                    "comment": "=== Store Header ===",
                    "id": "store_header",
                    "type": "composite",
                    "name": "StoreHeader",
                    "props": {
                        "brandName": "$t:superbify.brand.name",
                        "tagline": "$t:superbify.brand.tagline",
                        "cartCount": "{{_global.cartCount}}",
                        "user": "{{_global.currentUser ? (_global.currentUser.nick_name ?? _global.currentUser.name ?? _global.currentUser.email) : null}}",
                        "loginLabel": "$t:superbify.auth.login",
                        "signupLabel": "$t:superbify.auth.signup",
                        "mypageLabel": "$t:superbify.mypage.title",
                        "logoutLabel": "$t:superbify.auth.logout",
                        "shopLabel": "$t:superbify.nav.shop",
                        "storyLabel": "$t:superbify.nav.story",
                        "noticeLabel": "$t:superbify.nav.notice",
                        "cartLabel": "$t:superbify.nav.cart"
                    }
                },
                {
                    "comment": "=== Main Content Slot ===",
                    "id": "main_content_area",
                    "type": "basic",
                    "name": "Main",
                    "style": {
                        "flex": "1 1 auto"
                    },
                    "children": [
                        {
                            "id": "main_content",
                            "type": "basic",
                            "name": "Div",
                            "slot": "content",
                            "children": []
                        }
                    ]
                },
                {
                    "comment": "=== Store Footer === 사업자 정보/정책 링크는 config/business-info.json 단일 편집 지점에서 온다. 정책 링크 문구는 lang, 링크 경로는 src/config/businessInfo.ts POLICY_ROUTES.",
                    "id": "store_footer",
                    "type": "composite",
                    "name": "StoreFooter",
                    "props": {
                        "brandName": "$t:superbify.brand.name",
                        "demoNotice": "$t:superbify.business.demo_notice",
                        "termsLabel": "$t:superbify.business.links.terms",
                        "privacyLabel": "$t:superbify.business.links.privacy",
                        "shippingLabel": "$t:superbify.business.links.shipping",
                        "verificationLabel": "$t:superbify.business.links.verification",
                        "shopLabel": "$t:superbify.nav.shop",
                        "storyLabel": "$t:superbify.nav.story",
                        "noticeLabel": "$t:superbify.nav.notice",
                        "cartLabel": "$t:superbify.nav.cart"
                    }
                }
            ]
        }
    ]
}

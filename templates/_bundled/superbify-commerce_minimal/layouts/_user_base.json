{
    "version": "1.0.0",
    "layout_name": "_user_base",
    "meta": {
        "title": "$t:superbify.base_layout_title",
        "description": "$t:superbify.base_layout_description",
        "is_base": true
    },
    "globalHeaders": [
        {
            "_comment": "이커머스 API에 X-Cart-Key 자동 첨부 — _global.cartKey는 initCartKey 핸들러가 localStorage + 서버 응답 헤더를 통해 주입한다 (sirsoft-basic 패턴과 동일). 미설치 상태에서 X-Cart-Key는 빈 문자열로 전달되어도 서버는 새 게스트 키를 발급한다.",
            "pattern": "/api/modules/sirsoft-ecommerce/*",
            "headers": {
                "X-Cart-Key": "{{_global.cartKey}}"
            }
        }
    ],
    "init_actions": [
        {
            "_comment": "localStorage의 g7_cart_key → _global.cartKey 주입. 비어 있으면 서버가 새 cart key를 응답 헤더로 내려준다.",
            "handler": "initCartKey"
        }
    ],
    "data_sources": [
        {
            "_comment": "장바구니 수량 — 헤더의 카운트 뱃지에 사용",
            "id": "cart_count",
            "label_key": "$t:superbify.data_source.cart_count",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/cart/count",
            "method": "GET",
            "auto_fetch": true,
            "auth_mode": "optional",
            "loading_strategy": "progressive",
            "initGlobal": {
                "key": "cartCount",
                "path": "count"
            },
            "fallback": { "data": { "count": 0 } }
        }
    ],
    "components": [
        {
            "id": "user_layout_root",
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "user-layout-root"
            },
            "style": {
                "minHeight": "100vh",
                "display": "flex",
                "flexDirection": "column",
                "backgroundColor": "var(--scm-bg-primary, #FAF8F3)",
                "color": "var(--scm-text-primary, #26221E)"
            },
            "children": [
                {
                    "comment": "=== Store Header ===",
                    "id": "store_header",
                    "type": "composite",
                    "name": "StoreHeader",
                    "props": {
                        "brandName": "$t:superbify.brand.name",
                        "tagline": "$t:superbify.brand.tagline",
                        "cartCount": "{{_global.cartCount}}"
                    }
                },
                {
                    "comment": "=== Main Content Slot ===",
                    "id": "main_content_area",
                    "type": "basic",
                    "name": "Main",
                    "style": {
                        "flex": "1 1 auto"
                    },
                    "children": [
                        {
                            "id": "main_content",
                            "type": "basic",
                            "name": "Div",
                            "slot": "content",
                            "children": []
                        }
                    ]
                },
                {
                    "comment": "=== Store Footer ===",
                    "id": "store_footer",
                    "type": "composite",
                    "name": "StoreFooter",
                    "props": {
                        "brandName": "$t:superbify.brand.name"
                    }
                }
            ]
        }
    ]
}

{
    "version": "1.0.0",
    "layout_name": "mypage/inquiries",
    "extends": "_user_base",
    "permissions": [],
    "computed": {
        "currentTab": "inquiries"
    },
    "fork_source_comment": "templates/_bundled/sirsoft-basic/layouts/mypage/inquiries.json 포크 — myInquiries DS(auth required, per_page 10) 유지. BASIC은 BASIC Pagination을 썼지만 SRC Pagination 으로 치환하고, 읽기 전용 탭이라 수정/삭제(qna_write_modal / inquiry_delete_modal) 모달과 onSuccess showErrorPage 분기는 제외했다. 상품 링크만 유지.",
    "data_sources": [
        {
            "fork_source": "templates/_bundled/sirsoft-basic/layouts/mypage/inquiries.json",
            "id": "myInquiries",
            "label_key": "$t:superbify.mypage.inquiries.title",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/user/inquiries",
            "method": "GET",
            "auto_fetch": true,
            "auth_mode": "required",
            "loading_strategy": "progressive",
            "params": {
                "page": "{{_local.inquiriesPage ?? query.page ?? 1}}",
                "per_page": 10,
                "is_answered": "{{_local.inquiriesFilter ?? ''}}"
            }
        }
    ],
    "init_actions": [
        {
            "handler": "setState",
            "params": {
                "target": "local",
                "inquiriesPage": "{{query.page ?? 1}}",
                "inquiriesFilter": "",
                "openedInquiryId": null
            }
        }
    ],
    "slots": {
        "content": [
            {
                "id": "mypage_inquiries_section",
                "type": "basic",
                "name": "Section",
                "style": {
                    "paddingBlock": "var(--scm-section-py-md, 3rem)"
                },
                "children": [
                    {
                        "id": "mypage_inquiries_wrap",
                        "type": "basic",
                        "name": "Div",
                        "style": {
                            "maxWidth": "var(--scm-max-width, 1320px)",
                            "marginInline": "auto",
                            "paddingInline": "var(--scm-gutter, 1rem)",
                            "display": "flex",
                            "flexDirection": "column",
                            "gap": "var(--scm-spacing-md, 1rem)"
                        },
                        "children": [
                            {
                                "id": "mypage_inquiries_eyebrow",
                                "type": "basic",
                                "name": "Span",
                                "style": {
                                    "fontFamily": "var(--scm-font-body, system-ui)",
                                    "fontSize": "0.75rem",
                                    "color": "var(--scm-text-muted, #8A837B)",
                                    "letterSpacing": "0.08em",
                                    "textTransform": "uppercase"
                                },
                                "text": "$t:superbify.mypage.tabs.inquiries"
                            },
                            {
                                "id": "mypage_inquiries_title",
                                "type": "basic",
                                "name": "H1",
                                "style": {
                                    "fontFamily": "var(--scm-font-display, system-ui)",
                                    "fontSize": "1.75rem",
                                    "fontWeight": "700",
                                    "color": "var(--scm-text-primary, #26221E)",
                                    "margin": "0"
                                },
                                "text": "$t:superbify.mypage.title"
                            },
                            {
                                "partial": "partials/mypage/_tabs.json"
                            },
                            {
                                "id": "mypage_tab_content",
                                "type": "basic",
                                "name": "Div",
                                "children": [
                                    {
                                        "comment": "문의 내역 — 읽기 전용 + 상품 링크",
                                        "partial": "partials/mypage/inquiries/_list.json"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
{
    "version": "1.0.0",
    "layout_name": "mypage/coupons",
    "extends": "_user_base",
    "permissions": [],
    "computed": {
        "currentTab": "coupons"
    },
    "fork_source_comment": "sirsoft-basic 에 대응 mypage/coupons 레이아웃이 없어 신규 작성 — verified endpoint /user/coupons, /user/coupons/available, POST /user/coupons/{id}/download 만 사용. 스타일/빈상태는 공지·배송지 SRC 패턴(scm 토큰 inline + EmptyState)에 맞춘다.",
    "data_sources": [
        {
            "id": "my_coupons",
            "label_key": "$t:superbify.mypage.coupons.title",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/user/coupons",
            "method": "GET",
            "auto_fetch": true,
            "auth_mode": "required",
            "loading_strategy": "progressive"
        },
        {
            "id": "available_coupons",
            "label_key": "$t:superbify.mypage.coupons.available",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/user/coupons/available",
            "method": "GET",
            "auto_fetch": true,
            "auth_mode": "required",
            "loading_strategy": "progressive"
        }
    ],
    "slots": {
        "content": [
            {
                "id": "mypage_coupons_section",
                "type": "basic",
                "name": "Section",
                "style": {
                    "paddingBlock": "var(--scm-section-py-md, 3rem)"
                },
                "children": [
                    {
                        "id": "mypage_coupons_wrap",
                        "type": "basic",
                        "name": "Div",
                        "style": {
                            "maxWidth": "var(--scm-max-width, 1320px)",
                            "marginInline": "auto",
                            "paddingInline": "var(--scm-gutter, 1rem)",
                            "display": "flex",
                            "flexDirection": "column",
                            "gap": "var(--scm-spacing-md, 1rem)"
                        },
                        "children": [
                            {
                                "id": "mypage_coupons_eyebrow",
                                "type": "basic",
                                "name": "Span",
                                "style": {
                                    "fontFamily": "var(--scm-font-body, system-ui)",
                                    "fontSize": "0.75rem",
                                    "color": "var(--scm-text-muted, #8A837B)",
                                    "letterSpacing": "0.08em",
                                    "textTransform": "uppercase"
                                },
                                "text": "$t:superbify.mypage.tabs.coupons"
                            },
                            {
                                "id": "mypage_coupons_title",
                                "type": "basic",
                                "name": "H1",
                                "style": {
                                    "fontFamily": "var(--scm-font-display, system-ui)",
                                    "fontSize": "1.75rem",
                                    "fontWeight": "700",
                                    "color": "var(--scm-text-primary, #26221E)",
                                    "margin": "0"
                                },
                                "text": "$t:superbify.mypage.title"
                            },
                            {
                                "partial": "partials/mypage/_tabs.json"
                            },
                            {
                                "id": "mypage_tab_content",
                                "type": "basic",
                                "name": "Div",
                                "style": {
                                    "display": "flex",
                                    "flexDirection": "column",
                                    "gap": "var(--scm-spacing-lg, 1.5rem)"
                                },
                                "children": [
                                    {
                                        "comment": "보유 쿠폰",
                                        "partial": "partials/mypage/coupons/_list.json"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "transition_overlay": {
        "enabled": true,
        "style": "spinner",
        "wait_for": [
            "my_coupons",
            "available_coupons"
        ],
        "target": "main_content_area",
        "spinner": {
            "component": "PageLoading"
        },
        "_comment": "데이터 로딩 중 빈 empty-state 플래시 방지 — progressive 소스 fetch 동안 콘텐츠 영역에 PageLoading 표시(sirsoft-basic transition_overlay 패턴)."
    }
}

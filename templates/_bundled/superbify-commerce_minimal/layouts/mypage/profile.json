{
    "version": "1.0.0",
    "layout_name": "mypage/profile",
    "extends": "_user_base",
    "permissions": [],
    "computed": {
        "currentTab": "profile"
    },
    "data_sources": [
        {
            "_comment": "sirsoft-basic layouts/mypage/profile.json 의 user DS 포크 — GET /api/me, 회원 전용",
            "fork_source": "templates/_bundled/sirsoft-basic/layouts/mypage/profile.json",
            "id": "user",
            "label_key": "$t:superbify.data_source.current_user",
            "type": "api",
            "endpoint": "/api/me",
            "method": "GET",
            "auto_fetch": true,
            "refetchOnMount": true,
            "auth_mode": "required",
            "loading_strategy": "progressive"
        }
    ],
    "slots": {
        "content": [
            {
                "id": "mypage_profile_section",
                "type": "basic",
                "name": "Section",
                "style": {
                    "paddingBlock": "var(--scm-section-py-md, 3rem)"
                },
                "children": [
                    {
                        "id": "mypage_profile_wrap",
                        "type": "basic",
                        "name": "Div",
                        "style": {
                            "maxWidth": "var(--scm-max-width, 1320px)",
                            "marginInline": "auto",
                            "paddingInline": "var(--scm-gutter, 1rem)",
                            "display": "flex",
                            "flexDirection": "column",
                            "gap": "var(--scm-spacing-md, 1rem)"
                        },
                        "children": [
                            {
                                "comment": "아이보리 상단 눈표기",
                                "id": "mypage_eyebrow",
                                "type": "basic",
                                "name": "Span",
                                "style": {
                                    "fontFamily": "var(--scm-font-body, system-ui)",
                                    "fontSize": "0.75rem",
                                    "color": "var(--scm-text-muted, #8A837B)",
                                    "letterSpacing": "0.08em",
                                    "textTransform": "uppercase"
                                },
                                "text": "$t:superbify.mypage.tabs.profile"
                            },
                            {
                                "id": "mypage_title",
                                "type": "basic",
                                "name": "H1",
                                "style": {
                                    "fontFamily": "var(--scm-font-display, system-ui)",
                                    "fontSize": "1.75rem",
                                    "fontWeight": "700",
                                    "color": "var(--scm-text-primary, #26221E)",
                                    "margin": "0"
                                },
                                "text": "$t:superbify.mypage.title"
                            },
                            {
                                "comment": "마이페이지 공통 탭 네비게이션 (WP1 공용 partial)",
                                "partial": "partials/mypage/_tabs.json"
                            },
                            {
                                "comment": "탭 컨텐츠",
                                "id": "mypage_tab_content",
                                "type": "basic",
                                "name": "Div",
                                "children": [
                                    {
                                        "comment": "프로필 보기",
                                        "partial": "partials/mypage/profile/_view.json"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "transition_overlay": {
        "enabled": true,
        "style": "spinner",
        "wait_for": [
            "user"
        ],
        "target": "main_content_area",
        "spinner": {
            "component": "PageLoading"
        },
        "_comment": "데이터 로딩 중 빈 empty-state 플래시 방지 — progressive 소스 fetch 동안 콘텐츠 영역에 PageLoading 표시(sirsoft-basic transition_overlay 패턴)."
    }
}

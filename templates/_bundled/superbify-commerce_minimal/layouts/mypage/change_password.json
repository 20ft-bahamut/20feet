{
    "version": "1.0.0",
    "layout_name": "mypage/change_password",
    "extends": "_user_base",
    "permissions": [],
    "computed": {
        "currentTab": "password"
    },
    "fork_source_comment": "templates/_bundled/sirsoft-basic/layouts/mypage/change-password.json 포크 — PUT /api/me/password(current_password/password/password_confirmation) 체인 유지. PasswordInput → Input type=password, Icon/스피너 제거, scm 토큰 inline 스타일.",
    "init_actions": [
        {
            "handler": "setState",
            "params": {
                "target": "local",
                "isSubmitting": false,
                "success": false
            }
        }
    ],
    "slots": {
        "content": [
            {
                "id": "mypage_change_password_section",
                "type": "basic",
                "name": "Section",
                "style": {
                    "paddingBlock": "var(--scm-section-py-md, 3rem)"
                },
                "children": [
                    {
                        "id": "mypage_change_password_wrap",
                        "type": "basic",
                        "name": "Div",
                        "style": {
                            "maxWidth": "var(--scm-max-width, 1320px)",
                            "marginInline": "auto",
                            "paddingInline": "var(--scm-gutter, 1rem)",
                            "display": "flex",
                            "flexDirection": "column",
                            "gap": "var(--scm-spacing-md, 1rem)"
                        },
                        "children": [
                            {
                                "id": "mypage_password_eyebrow",
                                "type": "basic",
                                "name": "Span",
                                "style": {
                                    "fontFamily": "var(--scm-font-body, system-ui)",
                                    "fontSize": "0.75rem",
                                    "color": "var(--scm-text-muted, #8A837B)",
                                    "letterSpacing": "0.08em",
                                    "textTransform": "uppercase"
                                },
                                "text": "$t:superbify.mypage.tabs.password"
                            },
                            {
                                "id": "mypage_password_title",
                                "type": "basic",
                                "name": "H1",
                                "style": {
                                    "fontFamily": "var(--scm-font-display, system-ui)",
                                    "fontSize": "1.75rem",
                                    "fontWeight": "700",
                                    "color": "var(--scm-text-primary, #26221E)",
                                    "margin": "0"
                                },
                                "text": "$t:superbify.mypage.title"
                            },
                            {
                                "partial": "partials/mypage/_tabs.json"
                            },
                            {
                                "id": "mypage_tab_content",
                                "type": "basic",
                                "name": "Div",
                                "children": [
                                    {
                                        "comment": "변경 완료 뷰 — BASIC success 뷰 포크",
                                        "type": "basic",
                                        "name": "Div",
                                        "if": "{{_local?.success}}",
                                        "props": { "className": "scm-panel" },
                                        "style": {
                                            "display": "flex",
                                            "flexDirection": "column",
                                            "alignItems": "center",
                                            "gap": "var(--scm-spacing-md, 1rem)",
                                            "textAlign": "center"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "P",
                                                "style": {
                                                    "margin": "0",
                                                    "fontSize": "0.9375rem",
                                                    "color": "var(--scm-text-body, #4A4643)"
                                                },
                                                "text": "$t:superbify.mypage.password.changed"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Button",
                                                "props": { "type": "button" },
                                                "style": {
                                                    "minHeight": "44px",
                                                    "padding": "0 var(--scm-spacing-md, 1rem)",
                                                    "backgroundColor": "var(--scm-charcoal, #26221E)",
                                                    "color": "var(--scm-text-inverse, #FAF8F3)",
                                                    "border": "1px solid var(--scm-charcoal, #26221E)",
                                                    "borderRadius": "var(--scm-radius-sm, 4px)",
                                                    "fontFamily": "var(--scm-font-body, system-ui)",
                                                    "fontSize": "0.875rem",
                                                    "fontWeight": "600",
                                                    "cursor": "pointer"
                                                },
                                                "text": "$t:superbify.mypage.tabs.profile",
                                                "actions": [
                                                    {
                                                        "type": "click",
                                                        "handler": "navigate",
                                                        "params": { "path": "/mypage/profile" }
                                                    }
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "comment": "변경 폼 — BASIC dataKey form 의 current_password/password/password_confirmation 유지",
                                        "type": "basic",
                                        "name": "Form",
                                        "dataKey": "form",
                                        "props": { "id": "changePasswordForm" },
                                        "if": "{{!_local?.success}}",
                                        "style": {
                                            "display": "flex",
                                            "flexDirection": "column",
                                            "gap": "var(--scm-spacing-lg, 1.5rem)"
                                        },
                                        "actions": [
                                            {
                                                "comment": "BASIC PUT /api/me/password 체인 — 성공 시 success state, 실패 시 error toast",
                                                "type": "submit",
                                                "handler": "sequence",
                                                "actions": [
                                                    {
                                                        "handler": "setState",
                                                        "params": { "target": "local", "isSubmitting": true }
                                                    },
                                                    {
                                                        "handler": "apiCall",
                                                        "auth_required": true,
                                                        "target": "/api/me/password",
                                                        "params": {
                                                            "method": "PUT",
                                                            "body": {
                                                                "current_password": "{{form?.current_password}}",
                                                                "password": "{{form?.password}}",
                                                                "password_confirmation": "{{form?.password_confirmation}}"
                                                            }
                                                        },
                                                        "onSuccess": [
                                                            {
                                                                "handler": "setState",
                                                                "params": {
                                                                    "target": "local",
                                                                    "isSubmitting": false,
                                                                    "success": true
                                                                }
                                                            }
                                                        ],
                                                        "onError": [
                                                            {
                                                                "handler": "setState",
                                                                "params": { "target": "local", "isSubmitting": false }
                                                            },
                                                            {
                                                                "handler": "toast",
                                                                "params": { "type": "error", "message": "{{error.message}}" }
                                                            }
                                                        ]
                                                    }
                                                ]
                                            }
                                        ],
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "style": { "display": "flex", "flexDirection": "column", "gap": "var(--scm-spacing-2xs, 0.25rem)" },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "style": { "fontSize": "0.8125rem", "fontWeight": "500", "color": "var(--scm-text-muted, #8A837B)" },
                                                        "text": "$t:superbify.mypage.password.current"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Input",
                                                        "props": {
                                                            "type": "password",
                                                            "name": "current_password",
                                                            "required": true,
                                                            "autocomplete": "current-password",
                                                            "disabled": "{{_local?.isSubmitting ?? false}}"
                                                        },
                                                        "style": {
                                                            "width": "100%",
                                                            "minHeight": "44px",
                                                            "padding": "0 var(--scm-spacing-sm, 0.75rem)",
                                                            "border": "var(--scm-hairline, 1px solid #E4DCCE)",
                                                            "borderRadius": "var(--scm-radius-sm, 4px)",
                                                            "backgroundColor": "var(--scm-bg-primary, #FAF8F3)",
                                                            "color": "var(--scm-text-primary, #26221E)",
                                                            "fontFamily": "var(--scm-font-body, system-ui)",
                                                            "fontSize": "0.9375rem"
                                                        }
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "style": { "display": "flex", "flexDirection": "column", "gap": "var(--scm-spacing-2xs, 0.25rem)" },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "style": { "fontSize": "0.8125rem", "fontWeight": "500", "color": "var(--scm-text-muted, #8A837B)" },
                                                        "text": "$t:superbify.mypage.password.new"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Input",
                                                        "props": {
                                                            "type": "password",
                                                            "name": "password",
                                                            "required": true,
                                                            "minLength": 8,
                                                            "autocomplete": "new-password",
                                                            "disabled": "{{_local?.isSubmitting ?? false}}"
                                                        },
                                                        "style": {
                                                            "width": "100%",
                                                            "minHeight": "44px",
                                                            "padding": "0 var(--scm-spacing-sm, 0.75rem)",
                                                            "border": "var(--scm-hairline, 1px solid #E4DCCE)",
                                                            "borderRadius": "var(--scm-radius-sm, 4px)",
                                                            "backgroundColor": "var(--scm-bg-primary, #FAF8F3)",
                                                            "color": "var(--scm-text-primary, #26221E)",
                                                            "fontFamily": "var(--scm-font-body, system-ui)",
                                                            "fontSize": "0.9375rem"
                                                        }
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "style": { "display": "flex", "flexDirection": "column", "gap": "var(--scm-spacing-2xs, 0.25rem)" },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "style": { "fontSize": "0.8125rem", "fontWeight": "500", "color": "var(--scm-text-muted, #8A837B)" },
                                                        "text": "$t:superbify.mypage.password.confirm"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Input",
                                                        "props": {
                                                            "type": "password",
                                                            "name": "password_confirmation",
                                                            "required": true,
                                                            "autocomplete": "new-password",
                                                            "disabled": "{{_local?.isSubmitting ?? false}}"
                                                        },
                                                        "style": {
                                                            "width": "100%",
                                                            "minHeight": "44px",
                                                            "padding": "0 var(--scm-spacing-sm, 0.75rem)",
                                                            "border": "var(--scm-hairline, 1px solid #E4DCCE)",
                                                            "borderRadius": "var(--scm-radius-sm, 4px)",
                                                            "backgroundColor": "var(--scm-bg-primary, #FAF8F3)",
                                                            "color": "var(--scm-text-primary, #26221E)",
                                                            "fontFamily": "var(--scm-font-body, system-ui)",
                                                            "fontSize": "0.9375rem"
                                                        }
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "style": { "display": "flex", "flexDirection": "column", "gap": "var(--scm-spacing-xs, 0.5rem)" },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Button",
                                                        "props": {
                                                            "type": "submit",
                                                            "disabled": "{{_local?.isSubmitting ?? false}}"
                                                        },
                                                        "style": {
                                                            "width": "100%",
                                                            "minHeight": "44px",
                                                            "backgroundColor": "var(--scm-charcoal, #26221E)",
                                                            "color": "var(--scm-text-inverse, #FAF8F3)",
                                                            "border": "1px solid var(--scm-charcoal, #26221E)",
                                                            "borderRadius": "var(--scm-radius-sm, 4px)",
                                                            "fontFamily": "var(--scm-font-body, system-ui)",
                                                            "fontSize": "0.9375rem",
                                                            "fontWeight": "600",
                                                            "cursor": "pointer"
                                                        },
                                                        "text": "$t:superbify.mypage.password.submit"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Button",
                                                        "props": {
                                                            "type": "button",
                                                            "disabled": "{{_local?.isSubmitting ?? false}}"
                                                        },
                                                        "style": {
                                                            "width": "100%",
                                                            "minHeight": "44px",
                                                            "backgroundColor": "var(--scm-bg-secondary, #F4F0E6)",
                                                            "color": "var(--scm-text-primary, #26221E)",
                                                            "border": "var(--scm-hairline, 1px solid #E4DCCE)",
                                                            "borderRadius": "var(--scm-radius-sm, 4px)",
                                                            "fontFamily": "var(--scm-font-body, system-ui)",
                                                            "fontSize": "0.9375rem",
                                                            "fontWeight": "600",
                                                            "cursor": "pointer"
                                                        },
                                                        "text": "$t:superbify.mypage.cancel",
                                                        "actions": [
                                                            {
                                                                "type": "click",
                                                                "handler": "navigate",
                                                                "params": { "path": "/mypage/profile" }
                                                            }
                                                        ]
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
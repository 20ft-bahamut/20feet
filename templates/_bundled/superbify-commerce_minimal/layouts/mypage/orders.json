{
    "version": "1.0.0",
    "layout_name": "mypage/orders",
    "extends": "_user_base",
    "permissions": [],
    "fork_source_comment": "templates/_bundled/sirsoft-basic/layouts/mypage/orders.json 포크 — 주문 목록 DS(BASIC params query.page → _local.ordersPage)와 partials/mypage/orders/_list.json 를 scm 토큰 인라인 스타일로 재작성했다. BASIC 통계 원형/상태 필터/Icon/classMap 은 제외(SRC 미등록 컴포지트 치환 규칙).",
    "computed": {
        "currentTab": "orders"
    },
    "meta": {
        "title": "$t:superbify.routes.mypage_orders"
    },
    "data_sources": [
        {
            "fork_source": "templates/_bundled/sirsoft-basic/layouts/mypage/orders.json (orders DS)",
            "comment": "파라미터 주석 — params 의 키는 전부 쿼리스트링으로 전송된다. with_items=1 은 주문마다 아이템을 전부 내려달라는 뜻(서버 기본은 대표 1건). page 는 init_actions 가 query.page 에서 세팅한 _local.ordersPage 를 쓰고, Pagination onPageChange 가 setState 후 refetchDataSource 로 갱신한다.",
            "id": "orders",
            "label_key": "$t:superbify.mypage.tabs.orders",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/user/orders",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "loading_strategy": "progressive",
            "params": {
                "with_items": "1",
                "page": "{{_local.ordersPage ?? 1}}",
                "per_page": "10"
            },
            "fallback": { "data": { "data": [], "pagination": {}, "statistics": {} } }
        }
    ],
    "init_actions": [
        {
            "comment": "URL query.page 복원 — 새로고침/뒤로가기 시에도 같은 페이지를 보여준다. 이후 페이지 이동은 _list.json Pagination 의 setState(_local.ordersPage) + refetchDataSource 로 처리한다.",
            "handler": "setState",
            "params": {
                "target": "local",
                "ordersPage": "{{query.page ?? 1}}"
            }
        }
    ],
    "slots": {
        "content": [
            {
                "id": "mypage_orders_section",
                "type": "basic",
                "name": "Section",
                "style": {
                    "paddingBlock": "var(--scm-section-py-md, 3rem)"
                },
                "children": [
                    {
                        "id": "mypage_orders_wrap",
                        "type": "basic",
                        "name": "Div",
                        "style": {
                            "maxWidth": "var(--scm-max-width, 1320px)",
                            "marginInline": "auto",
                            "paddingInline": "var(--scm-gutter, 1rem)",
                            "display": "flex",
                            "flexDirection": "column",
                            "gap": "var(--scm-spacing-md, 1rem)"
                        },
                        "children": [
                            {
                                "comment": "아이보리 상단 눈표기",
                                "id": "mypage_orders_eyebrow",
                                "type": "basic",
                                "name": "Span",
                                "style": {
                                    "fontFamily": "var(--scm-font-body, system-ui)",
                                    "fontSize": "0.75rem",
                                    "color": "var(--scm-text-muted, #8A837B)",
                                    "letterSpacing": "0.08em",
                                    "textTransform": "uppercase"
                                },
                                "text": "$t:superbify.mypage.tabs.orders"
                            },
                            {
                                "id": "mypage_orders_title",
                                "type": "basic",
                                "name": "H1",
                                "style": {
                                    "fontFamily": "var(--scm-font-display, system-ui)",
                                    "fontSize": "1.75rem",
                                    "fontWeight": "700",
                                    "color": "var(--scm-text-primary, #26221E)",
                                    "margin": "0"
                                },
                                "text": "$t:superbify.mypage.title"
                            },
                            {
                                "comment": "마이페이지 공통 탭 네비게이션 (WP1 공용 partial)",
                                "partial": "partials/mypage/_tabs.json"
                            },
                            {
                                "comment": "탭 컨텐츠",
                                "id": "mypage_tab_content",
                                "type": "basic",
                                "name": "Div",
                                "children": [
                                    {
                                        "comment": "주문내역 목록",
                                        "partial": "partials/mypage/orders/_list.json"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
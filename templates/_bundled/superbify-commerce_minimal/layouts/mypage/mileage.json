{
    "version": "1.0.0",
    "layout_name": "mypage/mileage",
    "extends": "_user_base",
    "permissions": [],
    "computed": {
        "currentTab": "mileage"
    },
    "fork_source_comment": "templates/_bundled/sirsoft-basic/layouts/mypage/mileage.json 포크 — mileage_balance(/user/mileage) + mileage_history(/user/mileage/history) DS(auth required) 유지. 페이지·분류 파라미터는 SRC 공지 목록 패턴처럼 query 바인딩으로 옮기고(BASIC Pagination → SRC Paginationnavigate mergeQuery), 4종 요약 카드/5종 필터는 요약 3종(보유/적립/사용) + 필터 3종(전체/적립/사용)으로 축약했다.",
    "data_sources": [
        {
            "fork_source": "templates/_bundled/sirsoft-basic/layouts/mypage/mileage.json",
            "id": "mileage_balance",
            "label_key": "$t:superbify.mypage.mileage.balance",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/user/mileage",
            "method": "GET",
            "auto_fetch": true,
            "auth_mode": "required",
            "loading_strategy": "progressive"
        },
        {
            "id": "mileage_history",
            "label_key": "$t:superbify.mypage.mileage.history",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/user/mileage/history",
            "method": "GET",
            "auto_fetch": true,
            "auth_mode": "required",
            "loading_strategy": "progressive",
            "params": {
                "page": "{{query.page ?? 1}}",
                "category": "{{query.category ?? ''}}",
                "per_page": "{{query.per_page ?? 10}}"
            }
        }
    ],
    "init_actions": [
        {
            "handler": "setState",
            "params": {
                "target": "local",
                "mileageCategory": "{{query.category ?? ''}}"
            }
        }
    ],
    "slots": {
        "content": [
            {
                "id": "mypage_mileage_section",
                "type": "basic",
                "name": "Section",
                "style": {
                    "paddingBlock": "var(--scm-section-py-md, 3rem)"
                },
                "children": [
                    {
                        "id": "mypage_mileage_wrap",
                        "type": "basic",
                        "name": "Div",
                        "style": {
                            "maxWidth": "var(--scm-max-width, 1320px)",
                            "marginInline": "auto",
                            "paddingInline": "var(--scm-gutter, 1rem)",
                            "display": "flex",
                            "flexDirection": "column",
                            "gap": "var(--scm-spacing-md, 1rem)"
                        },
                        "children": [
                            {
                                "id": "mypage_mileage_eyebrow",
                                "type": "basic",
                                "name": "Span",
                                "style": {
                                    "fontFamily": "var(--scm-font-body, system-ui)",
                                    "fontSize": "0.75rem",
                                    "color": "var(--scm-text-muted, #8A837B)",
                                    "letterSpacing": "0.08em",
                                    "textTransform": "uppercase"
                                },
                                "text": "$t:superbify.mypage.tabs.mileage"
                            },
                            {
                                "id": "mypage_mileage_title",
                                "type": "basic",
                                "name": "H1",
                                "style": {
                                    "fontFamily": "var(--scm-font-display, system-ui)",
                                    "fontSize": "1.75rem",
                                    "fontWeight": "700",
                                    "color": "var(--scm-text-primary, #26221E)",
                                    "margin": "0"
                                },
                                "text": "$t:superbify.mypage.title"
                            },
                            {
                                "partial": "partials/mypage/_tabs.json"
                            },
                            {
                                "id": "mypage_tab_content",
                                "type": "basic",
                                "name": "Div",
                                "children": [
                                    {
                                        "partial": "partials/mypage/mileage/_list.json"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
{
    "version": "1.0.0",
    "layout_name": "mypage/profile_edit",
    "extends": "_user_base",
    "permissions": [],
    "computed": {
        "currentTab": "profile"
    },
    "data_sources": [
        {
            "_comment": "BASIC layouts/mypage/profile-edit.json 의 user DS 포크 — initLocal profileEditForm 으로 폼 초기값 주입",
            "fork_source": "templates/_bundled/sirsoft-basic/layouts/mypage/profile-edit.json",
            "id": "user",
            "label_key": "$t:superbify.data_source.current_user",
            "type": "api",
            "endpoint": "/api/me",
            "method": "GET",
            "auto_fetch": true,
            "refetchOnMount": true,
            "auth_mode": "required",
            "loading_strategy": "progressive",
            "initLocal": "profileEditForm"
        }
    ],
    "init_actions": [
        {
            "comment": "BASIC 2-step flow state — 비밀번호 확인 전에는 수정 폼을 렌더하지 않는다",
            "handler": "setState",
            "params": {
                "target": "local",
                "isPasswordVerified": false,
                "verifyPassword": "",
                "isVerifyingPassword": false,
                "verifyPasswordError": false,
                "isSavingProfile": false,
                "profileErrors": null
            }
        }
    ],
    "slots": {
        "content": [
            {
                "id": "mypage_profile_edit_section",
                "type": "basic",
                "name": "Section",
                "style": {
                    "paddingBlock": "var(--scm-section-py-md, 3rem)"
                },
                "children": [
                    {
                        "id": "mypage_profile_edit_wrap",
                        "type": "basic",
                        "name": "Div",
                        "style": {
                            "maxWidth": "var(--scm-max-width, 1320px)",
                            "marginInline": "auto",
                            "paddingInline": "var(--scm-gutter, 1rem)",
                            "display": "flex",
                            "flexDirection": "column",
                            "gap": "var(--scm-spacing-md, 1rem)"
                        },
                        "children": [
                            {
                                "id": "mypage_edit_eyebrow",
                                "type": "basic",
                                "name": "Span",
                                "style": {
                                    "fontFamily": "var(--scm-font-body, system-ui)",
                                    "fontSize": "0.75rem",
                                    "color": "var(--scm-text-muted, #8A837B)",
                                    "letterSpacing": "0.08em",
                                    "textTransform": "uppercase"
                                },
                                "text": "$t:superbify.mypage.tabs.profile"
                            },
                            {
                                "id": "mypage_edit_title",
                                "type": "basic",
                                "name": "H1",
                                "style": {
                                    "fontFamily": "var(--scm-font-display, system-ui)",
                                    "fontSize": "1.75rem",
                                    "fontWeight": "700",
                                    "color": "var(--scm-text-primary, #26221E)",
                                    "margin": "0"
                                },
                                "text": "$t:superbify.mypage.profile.edit_title"
                            },
                            {
                                "partial": "partials/mypage/_tabs.json"
                            },
                            {
                                "comment": "탭 컨텐츠 — 비밀번호 확인 → 수정 폼 (BASIC 2-step)",
                                "id": "mypage_tab_content",
                                "type": "basic",
                                "name": "Div",
                                "children": [
                                    {
                                        "partial": "partials/mypage/profile/_password_verify_section.json"
                                    },
                                    {
                                        "partial": "partials/mypage/profile/_edit.json"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
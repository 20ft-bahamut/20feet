{
    "version": "1.0.0",
    "layout_name": "auth/login",
    "extends": "_user_base",
    "meta": {
        "title": "$t:superbify.routes.login",
        "guest_only": true,
        "fork_source": "templates/_bundled/sirsoft-basic/layouts/auth/login.json"
    },
    "slots": {
        "content": [
            {
                "comment": "Editorial split auth page — lifestyle visual LEFT / login form RIGHT (>=1024px). Mobile 은 compact 16:9 banner 위에 form 이 이어진다. Grid/spacing/반응형은 design-tokens.css 의 .scm-auth-* 이 담당하고 layout JSON 은 구조와 계약만 가진다.",
                "id": "auth_login_section",
                "type": "basic",
                "name": "Section",
                "children": [
                    {
                        "id": "auth_login_shell",
                        "type": "basic",
                        "name": "Div",
                        "blur_until_loaded": "{{_global?.currentUser?.uuid}}",
                        "children": [
                            {
                                "partial": "partials/auth/_redirect_if_logged_in.json"
                            },
                            {
                                "id": "auth_login_split",
                                "type": "basic",
                                "name": "Div",
                                "children": [
                                    {
                                        "comment": "LEFT — Still Form 라이프스타일 비주얼. 원본 docs/template_seed_2nd/4.png 를 훼손 없이 번들한 seed2/4.jpg 를 object-fit: cover 로 사용한다. dark overlay/gradient/텍스트 라벨 없이 사진 그대로 — 브랜드 식별은 Header 로고가 담당한다.",
                                        "id": "auth_login_visual",
                                        "type": "basic",
                                        "name": "Div",
                                        "children": [
                                            {
                                                "id": "auth_login_visual_img",
                                                "type": "basic",
                                                "name": "Img",
                                                "props": {
                                                    "src": "/api/templates/assets/superbify-commerce_minimal?file=images/demo/seed2/4.jpg",
                                                    "alt": "무드등이 켜진 Still Form 조명 라이프스타일"
                                                },
                                                "style": {
                                                    "width": "100%",
                                                    "height": "100%",
                                                    "objectFit": "cover",
                                                    "display": "block"
                                                }
                                            }
                                        ],
                                        "props": {
                                            "className": "scm-auth-visual"
                                        }
                                    },
                                    {
                                        "comment": "RIGHT — form panel. bordered card 대신 paper 위에 직접 놓인 절제된 폼. 내부 계약(heading 구조, _login_form partial, guest_continue, bottom links)은 v0.2.0 과 동일하다.",
                                        "id": "auth_login_panel",
                                        "type": "basic",
                                        "name": "Div",
                                        "children": [
                                            {
                                                "id": "auth_login_panel_inner",
                                                "type": "basic",
                                                "name": "Div",
                                                "children": [
                                                    {
                                                        "id": "auth_login_heading",
                                                        "type": "basic",
                                                        "name": "Div",
                                                        "children": [
                                                            {
                                                                "type": "basic",
                                                                "name": "H1",
                                                                "style": {
                                                                    "margin": 0,
                                                                    "fontFamily": "var(--scm-font-display, system-ui)",
                                                                    "fontSize": "clamp(1.625rem, 2.5vw, 1.875rem)",
                                                                    "fontWeight": 700,
                                                                    "letterSpacing": "-0.01em",
                                                                    "lineHeight": 1.2,
                                                                    "color": "var(--scm-text-primary, #26221E)"
                                                                },
                                                                "text": "$t:superbify.auth.login_form.title"
                                                            },
                                                            {
                                                                "type": "basic",
                                                                "name": "P",
                                                                "style": {
                                                                    "margin": "0.375rem 0 0",
                                                                    "fontSize": "0.9375rem",
                                                                    "lineHeight": 1.6,
                                                                    "color": "var(--scm-text-muted, #8A837B)"
                                                                },
                                                                "text": "$t:superbify.auth.login_form.subtitle"
                                                            }
                                                        ]
                                                    },
                                                    {
                                                        "partial": "partials/auth/_login_form.json"
                                                    },
                                                    {
                                                        "comment": "비회원 주문 진입 — redirect 가 checkout 일 때만 노출. Form 바깥에 두어 submit 으로 가로채지 않는다(BASIC 동일). 임시주문은 cartKey(localStorage)로 이미 생성됐으므로 비회원 주문 조회 페이지로 안내한다.",
                                                        "id": "auth_login_guest_continue",
                                                        "type": "basic",
                                                        "name": "Div",
                                                        "if": "{{query.redirect && query.redirect.includes('checkout')}}",
                                                        "style": {
                                                            "marginTop": "var(--scm-spacing-md, 1rem)",
                                                            "paddingTop": "var(--scm-spacing-md, 1rem)",
                                                            "borderTop": "var(--scm-hairline, 1px solid #E4DCCE)",
                                                            "display": "flex",
                                                            "flexDirection": "column",
                                                            "gap": "var(--scm-spacing-2xs, 0.5rem)"
                                                        },
                                                        "children": [
                                                            {
                                                                "type": "basic",
                                                                "name": "P",
                                                                "style": {
                                                                    "margin": 0,
                                                                    "fontSize": "0.875rem",
                                                                    "fontWeight": 600,
                                                                    "color": "var(--scm-text-primary, #26221E)"
                                                                },
                                                                "text": "$t:superbify.auth.guest_continue.title"
                                                            },
                                                            {
                                                                "type": "basic",
                                                                "name": "P",
                                                                "style": {
                                                                    "margin": 0,
                                                                    "fontSize": "0.8125rem",
                                                                    "color": "var(--scm-text-muted, #8A837B)"
                                                                },
                                                                "text": "$t:superbify.auth.guest_continue.hint"
                                                            },
                                                            {
                                                                "type": "basic",
                                                                "name": "A",
                                                                "id": "auth_login_guest_continue_cta",
                                                                "props": {
                                                                    "href": "{{_global.shopBase ?? '/shop'}}/guest/orders"
                                                                },
                                                                "style": {
                                                                    "minHeight": "44px",
                                                                    "display": "inline-flex",
                                                                    "alignItems": "center",
                                                                    "justifyContent": "center",
                                                                    "padding": "0.625rem 1rem",
                                                                    "backgroundColor": "var(--scm-paper, #FAF8F3)",
                                                                    "color": "var(--scm-text-primary, #26221E)",
                                                                    "border": "1px solid var(--scm-line, #E4DCCE)",
                                                                    "borderRadius": "var(--scm-radius, 8px)",
                                                                    "fontWeight": 600,
                                                                    "fontSize": "0.9375rem",
                                                                    "textDecoration": "none",
                                                                    "cursor": "pointer"
                                                                },
                                                                "text": "$t:superbify.auth.guest_continue.cta",
                                                                "actions": [
                                                                    {
                                                                        "type": "click",
                                                                        "handler": "navigate",
                                                                        "params": {
                                                                            "path": "/shop/guest/orders"
                                                                        }
                                                                    }
                                                                ]
                                                            }
                                                        ]
                                                    },
                                                    {
                                                        "comment": "하단 링크 — 비밀번호 찾기 / 회원가입",
                                                        "id": "auth_login_bottom_links",
                                                        "type": "basic",
                                                        "name": "Div",
                                                        "style": {
                                                            "marginTop": "var(--scm-spacing-sm, 0.75rem)",
                                                            "display": "flex",
                                                            "alignItems": "center",
                                                            "justifyContent": "space-between",
                                                            "gap": "var(--scm-spacing-sm, 0.75rem)"
                                                        },
                                                        "children": [
                                                            {
                                                                "type": "basic",
                                                                "name": "A",
                                                                "id": "auth_login_forgot_link",
                                                                "props": {
                                                                    "href": "/forgot-password"
                                                                },
                                                                "style": {
                                                                    "minHeight": "44px",
                                                                    "display": "inline-flex",
                                                                    "alignItems": "center",
                                                                    "fontSize": "0.875rem",
                                                                    "color": "var(--scm-text-muted, #8A837B)",
                                                                    "textDecoration": "underline",
                                                                    "textUnderlineOffset": "3px",
                                                                    "cursor": "pointer"
                                                                },
                                                                "text": "$t:superbify.auth.forgot_password_link",
                                                                "actions": [
                                                                    {
                                                                        "type": "click",
                                                                        "handler": "navigate",
                                                                        "params": {
                                                                            "path": "/forgot-password"
                                                                        }
                                                                    }
                                                                ]
                                                            },
                                                            {
                                                                "type": "basic",
                                                                "name": "A",
                                                                "id": "auth_login_register_link",
                                                                "props": {
                                                                    "href": "/register"
                                                                },
                                                                "style": {
                                                                    "minHeight": "44px",
                                                                    "display": "inline-flex",
                                                                    "alignItems": "center",
                                                                    "fontSize": "0.875rem",
                                                                    "fontWeight": 600,
                                                                    "color": "var(--scm-text-primary, #26221E)",
                                                                    "textDecoration": "underline",
                                                                    "textUnderlineOffset": "3px",
                                                                    "cursor": "pointer"
                                                                },
                                                                "text": "$t:superbify.auth.register_link",
                                                                "actions": [
                                                                    {
                                                                        "type": "click",
                                                                        "handler": "navigate",
                                                                        "params": {
                                                                            "path": "/register"
                                                                        }
                                                                    }
                                                                ]
                                                            }
                                                        ]
                                                    }
                                                ],
                                                "props": {
                                                    "className": "scm-auth-panel-inner"
                                                }
                                            }
                                        ],
                                        "props": {
                                            "className": "scm-auth-panel"
                                        }
                                    }
                                ],
                                "props": {
                                    "className": "scm-auth-split"
                                }
                            }
                        ],
                        "props": {
                            "className": "scm-auth-shell"
                        }
                    }
                ],
                "props": {
                    "className": "scm-auth-page"
                }
            }
        ]
    }
}
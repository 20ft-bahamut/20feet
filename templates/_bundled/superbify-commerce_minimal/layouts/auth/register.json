{
    "version": "1.0.0",
    "layout_name": "auth/register",
    "extends": "_user_base",
    "meta": {
        "title": "$t:superbify.routes.register",
        "guest_only": true,
        "fork_source": "templates/_bundled/sirsoft-basic/layouts/auth/register.json"
    },
    "data_sources": [
        {
            "id": "termsContent",
            "label_key": "$t:superbify.data_source.termsContent",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-page/pages/terms",
            "method": "GET",
            "auto_fetch": false,
            "auth_mode": "optional"
        },
        {
            "id": "privacyContent",
            "label_key": "$t:superbify.data_source.privacyContent",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-page/pages/privacy",
            "method": "GET",
            "auto_fetch": false,
            "auth_mode": "optional"
        }
    ],
    "init_actions": [
        {
            "comment": "registerForm 초기 상태 시드 — BASIC 과 동일. Select 언어 기본값은 _register_form.json 의 Select value 표현식이 렌더 시점에 $locale 로 채운다.",
            "handler": "setState",
            "params": {
                "target": "local",
                "isRegistering": false,
                "registerError": null,
                "errors": null,
                "registerForm": {}
            }
        }
    ],
    "slots": {
        "content": [
            {
                "comment": "Editorial split auth page — login 과 동일한 AuthShell 재사용. Register 는 폼이 길어 desktop 에서 visual 을 sticky 로 두고 form panel 이 스크롤을 따라간다. Mobile 은 compact 16:9 banner 위에 form. Grid/spacing/반응형은 design-tokens.css 의 .scm-auth-* 가 담당.",
                "id": "auth_register_section",
                "type": "basic",
                "name": "Section",
                "props": {
                    "className": "scm-auth-page"
                },
                "children": [
                    {
                        "id": "auth_register_shell",
                        "type": "basic",
                        "name": "Div",
                        "blur_until_loaded": "{{_global?.currentUser?.uuid}}",
                        "props": {
                            "className": "scm-auth-shell"
                        },
                        "children": [
                            {
                                "partial": "partials/auth/_redirect_if_logged_in.json"
                            },
                            {
                                "id": "auth_register_split",
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "scm-auth-split scm-auth-split--register"
                                },
                                "children": [
                                    {
                                        "comment": "LEFT — Still Form 라이프스타일 비주얼(login 과 동일 에셋). Register 는 폼이 길어 desktop 에서 sticky 로 고정한다.",
                                        "id": "auth_register_visual",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "scm-auth-visual scm-auth-visual--register"
                                        },
                                        "children": [
                                            {
                                                "id": "auth_register_visual_img",
                                                "type": "basic",
                                                "name": "Img",
                                                "props": {
                                                    "src": "/api/templates/assets/superbify-commerce_minimal/images/demo/seed2/4.jpg",
                                                    "alt": "무드등이 켜진 Still Form 조명 라이프스타일"
                                                },
                                                "style": {
                                                    "width": "100%",
                                                    "height": "100%",
                                                    "objectFit": "cover",
                                                    "display": "block"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "comment": "RIGHT — form panel. Register 는 입력+약관이 길어 panel 폭을 login 보다 넓게(480px) 확장한 modifier 를 쓴다.",
                                        "id": "auth_register_panel",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "scm-auth-panel scm-auth-panel--register"
                                        },
                                        "children": [
                                            {
                                                "id": "auth_register_panel_inner",
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "scm-auth-panel-inner scm-auth-panel-inner--register"
                                                },
                                                "children": [
                                                    {
                                                        "id": "auth_register_heading",
                                                        "type": "basic",
                                                        "name": "Div",
                                                        "style": {
                                                            "textAlign": "center"
                                                        },
                                                        "children": [
                                                            {
                                                                "type": "basic",
                                                                "name": "H1",
                                                                "style": {
                                                                    "margin": 0,
                                                                    "fontFamily": "var(--scm-font-display, system-ui)",
                                                                    "fontSize": "clamp(1.625rem, 2.5vw, 1.875rem)",
                                                                    "fontWeight": 700,
                                                                    "letterSpacing": "-0.01em",
                                                                    "lineHeight": 1.2,
                                                                    "color": "var(--scm-text-primary, #26221E)"
                                                                },
                                                                "text": "$t:superbify.auth.register.title"
                                                            },
                                                            {
                                                                "type": "basic",
                                                                "name": "P",
                                                                "style": {
                                                                    "margin": "0.375rem 0 0",
                                                                    "fontSize": "0.9375rem",
                                                                    "lineHeight": 1.6,
                                                                    "color": "var(--scm-text-muted, #8A837B)"
                                                                },
                                                                "text": "$t:superbify.auth.register.subtitle"
                                                            }
                                                        ]
                                                    },
                                                    {
                                                        "partial": "partials/auth/_register_form.json"
                                                    },
                                                    {
                                                        "id": "auth_register_bottom_links",
                                                        "type": "basic",
                                                        "name": "Div",
                                                        "style": {
                                                            "marginTop": "var(--scm-spacing-md, 1rem)",
                                                            "display": "flex",
                                                            "alignItems": "center",
                                                            "justifyContent": "center",
                                                            "gap": "var(--scm-spacing-3xs, 0.25rem)"
                                                        },
                                                        "children": [
                                                            {
                                                                "type": "basic",
                                                                "name": "Span",
                                                                "style": {
                                                                    "fontSize": "0.875rem",
                                                                    "color": "var(--scm-text-muted, #8A837B)"
                                                                },
                                                                "text": "$t:superbify.auth.register.has_account"
                                                            },
                                                            {
                                                                "type": "basic",
                                                                "name": "A",
                                                                "id": "auth_register_login_link",
                                                                "props": {
                                                                    "href": "/login"
                                                                },
                                                                "style": {
                                                                    "minHeight": "44px",
                                                                    "display": "inline-flex",
                                                                    "alignItems": "center",
                                                                    "fontSize": "0.875rem",
                                                                    "fontWeight": 600,
                                                                    "color": "var(--scm-text-primary, #26221E)",
                                                                    "textDecoration": "underline",
                                                                    "textUnderlineOffset": "3px",
                                                                    "cursor": "pointer"
                                                                },
                                                                "text": "$t:superbify.auth.login",
                                                                "actions": [
                                                                    {
                                                                        "type": "click",
                                                                        "handler": "navigate",
                                                                        "params": {
                                                                            "path": "/login"
                                                                        }
                                                                    }
                                                                ]
                                                            }
                                                        ]
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "modals": [
        {
            "partial": "partials/auth/_modal_terms.json"
        },
        {
            "partial": "partials/auth/_modal_privacy.json"
        }
    ]
}
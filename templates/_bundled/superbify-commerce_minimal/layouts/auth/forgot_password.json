{
    "version": "1.0.0",
    "layout_name": "auth/forgot_password",
    "extends": "_user_base",
    "meta": {
        "title": "$t:superbify.routes.forgot_password",
        "guest_only": true,
        "fork_source": "templates/_bundled/sirsoft-basic/layouts/auth/forgot_password.json"
    },
    "slots": {
        "content": [
            {
                "comment": "Editorial split auth page — login/register 와 동일한 AuthShell. 폼이 짧아 visual 은 sticky 없이 login 과 같이 중앙 정렬 panel. 성공 시 BASIC 의 inline success 패널 대신 toast 성공 알림 후 로그인 페이지로 이동한다(AuthManager 토큰 규격은 동일).",
                "id": "auth_forgot_section",
                "type": "basic",
                "name": "Section",
                "props": {
                    "className": "scm-auth-page"
                },
                "children": [
                    {
                        "id": "auth_forgot_shell",
                        "type": "basic",
                        "name": "Div",
                        "blur_until_loaded": "{{_global?.currentUser?.uuid}}",
                        "props": {
                            "className": "scm-auth-shell"
                        },
                        "children": [
                            {
                                "partial": "partials/auth/_redirect_if_logged_in.json"
                            },
                            {
                                "id": "auth_forgot_split",
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "scm-auth-split"
                                },
                                "children": [
                                    {
                                        "comment": "LEFT — Still Form 라이프스타일 비주얼(login/register 동일 에셋).",
                                        "id": "auth_forgot_visual",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "scm-auth-visual"
                                        },
                                        "children": [
                                            {
                                                "id": "auth_forgot_visual_img",
                                                "type": "basic",
                                                "name": "Img",
                                                "props": {
                                                    "src": "/api/templates/assets/superbify-commerce_minimal/images/demo/seed2/4.jpg",
                                                    "alt": "무드등이 켜진 Still Form 조명 라이프스타일"
                                                },
                                                "style": {
                                                    "width": "100%",
                                                    "height": "100%",
                                                    "objectFit": "cover",
                                                    "display": "block"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "comment": "RIGHT — form panel. 짧은 폼이므로 login 과 동일 400px panel.",
                                        "id": "auth_forgot_panel",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "scm-auth-panel"
                                        },
                                        "children": [
                                            {
                                                "id": "auth_forgot_panel_inner",
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "scm-auth-panel-inner"
                                                },
                                                "children": [
                                                    {
                                                        "id": "auth_forgot_heading",
                                                        "type": "basic",
                                                        "name": "Div",
                                                        "children": [
                                                            {
                                                                "type": "basic",
                                                                "name": "H1",
                                                                "style": {
                                                                    "margin": 0,
                                                                    "fontFamily": "var(--scm-font-display, system-ui)",
                                                                    "fontSize": "clamp(1.625rem, 2.5vw, 1.875rem)",
                                                                    "fontWeight": 700,
                                                                    "letterSpacing": "-0.01em",
                                                                    "lineHeight": 1.2,
                                                                    "color": "var(--scm-text-primary, #26221E)"
                                                                },
                                                                "text": "$t:superbify.auth.forgot_password.title"
                                                            },
                                                            {
                                                                "type": "basic",
                                                                "name": "P",
                                                                "style": {
                                                                    "margin": "0.375rem 0 0",
                                                                    "fontSize": "0.9375rem",
                                                                    "lineHeight": 1.6,
                                                                    "color": "var(--scm-text-muted, #8A837B)"
                                                                },
                                                                "text": "$t:superbify.auth.forgot_password.subtitle"
                                                            }
                                                        ]
                                                    },
                                                    {
                                                        "comment": "비밀번호 찾기 폼 — POST /api/auth/forgot-password",
                                                        "id": "auth_forgot_form",
                                                        "type": "basic",
                                                        "name": "Form",
                                                        "style": {
                                                            "display": "flex",
                                                            "flexDirection": "column",
                                                            "gap": "var(--scm-spacing-md, 1rem)",
                                                            "marginTop": "var(--scm-spacing-md, 1rem)"
                                                        },
                                                        "children": [
                                                            {
                                                                "id": "auth_forgot_email_field",
                                                                "type": "basic",
                                                                "name": "Div",
                                                                "style": {
                                                                    "display": "flex",
                                                                    "flexDirection": "column",
                                                                    "gap": "0.375rem"
                                                                },
                                                                "children": [
                                                                    {
                                                                        "type": "basic",
                                                                        "name": "Label",
                                                                        "props": {
                                                                            "htmlFor": "auth_forgot_email"
                                                                        },
                                                                        "style": {
                                                                            "fontSize": "0.8125rem",
                                                                            "fontWeight": 600,
                                                                            "color": "var(--scm-text-primary, #26221E)"
                                                                        },
                                                                        "text": "$t:superbify.auth.forgot_password.email"
                                                                    },
                                                                    {
                                                                        "type": "basic",
                                                                        "name": "Input",
                                                                        "id": "auth_forgot_email",
                                                                        "props": {
                                                                            "type": "email",
                                                                            "name": "email",
                                                                            "placeholder": "$t:superbify.auth.forgot_password.email_placeholder",
                                                                            "required": true,
                                                                            "autocomplete": "email",
                                                                            "disabled": "{{_local.isSubmitting ?? false}}"
                                                                        },
                                                                        "style": {
                                                                            "minHeight": "44px",
                                                                            "padding": "0.625rem 0.75rem",
                                                                            "border": "1px solid var(--scm-line, #E4DCCE)",
                                                                            "borderRadius": "var(--scm-radius, 8px)",
                                                                            "backgroundColor": "#FFFFFF",
                                                                            "color": "var(--scm-text-primary, #26221E)",
                                                                            "fontSize": "0.9375rem",
                                                                            "fontFamily": "var(--scm-font-body, system-ui)"
                                                                        }
                                                                    }
                                                                ]
                                                            },
                                                            {
                                                                "id": "auth_forgot_submit",
                                                                "type": "basic",
                                                                "name": "Button",
                                                                "props": {
                                                                    "type": "submit",
                                                                    "disabled": "{{_local.isSubmitting ?? false}}"
                                                                },
                                                                "style": {
                                                                    "minHeight": "44px",
                                                                    "padding": "0.75rem 1rem",
                                                                    "backgroundColor": "var(--scm-charcoal, #26221E)",
                                                                    "color": "var(--scm-text-inverse, #FAF8F3)",
                                                                    "border": "1px solid var(--scm-charcoal, #26221E)",
                                                                    "borderRadius": "var(--scm-radius, 8px)",
                                                                    "fontWeight": 600,
                                                                    "cursor": "pointer",
                                                                    "fontFamily": "var(--scm-font-body, system-ui)",
                                                                    "fontSize": "0.9375rem"
                                                                },
                                                                "text": "{{_local.isSubmitting ? '$t:superbify.auth.forgot_password.processing' : '$t:superbify.auth.forgot_password.submit'}}"
                                                            }
                                                        ],
                                                        "actions": [
                                                            {
                                                                "type": "submit",
                                                                "handler": "sequence",
                                                                "actions": [
                                                                    {
                                                                        "handler": "setState",
                                                                        "params": {
                                                                            "target": "local",
                                                                            "isSubmitting": true
                                                                        }
                                                                    },
                                                                    {
                                                                        "handler": "apiCall",
                                                                        "target": "/api/auth/forgot-password",
                                                                        "params": {
                                                                            "method": "POST",
                                                                            "body": {
                                                                                "email": "{{form.email}}"
                                                                            }
                                                                        },
                                                                        "onSuccess": [
                                                                            {
                                                                                "handler": "setState",
                                                                                "params": {
                                                                                    "target": "local",
                                                                                    "isSubmitting": false
                                                                                }
                                                                            },
                                                                            {
                                                                                "handler": "toast",
                                                                                "params": {
                                                                                    "type": "success",
                                                                                    "message": "$t:superbify.auth.forgot_password.success"
                                                                                }
                                                                            },
                                                                            {
                                                                                "handler": "navigate",
                                                                                "params": {
                                                                                    "path": "/login"
                                                                                }
                                                                            }
                                                                        ],
                                                                        "onError": [
                                                                            {
                                                                                "handler": "setState",
                                                                                "params": {
                                                                                    "target": "local",
                                                                                    "isSubmitting": false
                                                                                }
                                                                            },
                                                                            {
                                                                                "handler": "toast",
                                                                                "params": {
                                                                                    "type": "error",
                                                                                    "message": "{{error.message}}"
                                                                                }
                                                                            }
                                                                        ]
                                                                    }
                                                                ]
                                                            }
                                                        ]
                                                    },
                                                    {
                                                        "comment": "로그인 링크",
                                                        "id": "auth_forgot_bottom_links",
                                                        "type": "basic",
                                                        "name": "Div",
                                                        "style": {
                                                            "marginTop": "var(--scm-spacing-sm, 0.75rem)",
                                                            "textAlign": "center"
                                                        },
                                                        "children": [
                                                            {
                                                                "type": "basic",
                                                                "name": "A",
                                                                "id": "auth_forgot_login_link",
                                                                "props": {
                                                                    "href": "/login"
                                                                },
                                                                "style": {
                                                                    "minHeight": "44px",
                                                                    "display": "inline-flex",
                                                                    "alignItems": "center",
                                                                    "fontSize": "0.875rem",
                                                                    "color": "var(--scm-text-muted, #8A837B)",
                                                                    "textDecoration": "underline",
                                                                    "textUnderlineOffset": "3px",
                                                                    "cursor": "pointer"
                                                                },
                                                                "text": "$t:superbify.auth.forgot_password.back_to_login",
                                                                "actions": [
                                                                    {
                                                                        "type": "click",
                                                                        "handler": "navigate",
                                                                        "params": {
                                                                            "path": "/login"
                                                                        }
                                                                    }
                                                                ]
                                                            }
                                                        ]
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
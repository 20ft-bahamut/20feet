{
    "version": "1.0.0",
    "layout_name": "auth/reset_password",
    "extends": "_user_base",
    "meta": {
        "title": "$t:superbify.routes.reset_password",
        "guest_only": true,
        "fork_source": "templates/_bundled/sirsoft-basic/layouts/auth/reset_password.json"
    },
    "comment": "BASIC 의 로그인 상태 분기 Modal(본인 계정/타인 계정 → IdentityChallengeModal 계열)은 SRC 에 Modal 이 없고 _redirect_if_logged_in partial 이 로그인 상태 진입을 홈으로 되돌리므로 생략했다. 토큰 검증 DS와 재설정 POST 체인은 BASIC 그대로다.",
    "data_sources": [
        {
            "id": "tokenValidation",
            "label_key": "$t:superbify.data_source.token_validation",
            "type": "api",
            "endpoint": "/api/auth/validate-reset-token",
            "method": "POST",
            "auto_fetch": true,
            "auth_required": false,
            "params": {
                "token": "{{query.token ?? ''}}",
                "email": "{{query.email ?? ''}}"
            },
            "loading_strategy": "blocking",
            "initLocal": {
                "tokenValid": "{{data.valid ?? false}}"
            },
            "errorHandling": {
                "422": {
                    "handler": "setState",
                    "params": {
                        "target": "local",
                        "tokenError": true
                    }
                },
                "default": {
                    "handler": "setState",
                    "params": {
                        "target": "local",
                        "tokenError": true
                    }
                }
            }
        }
    ],
    "slots": {
        "content": [
            {
                "id": "auth_reset_section",
                "type": "basic",
                "name": "Section",
                "comment": "BASIC 의 Tailwind 카드는 scm-auth-card 로 치환. BASIC 의 Icon(xmark/check) 장식은 SRC 미등록이라 제거하고 텍스트로 대체했다.",
                "style": {
                    "minHeight": "60vh",
                    "display": "flex",
                    "justifyContent": "center",
                    "alignItems": "flex-start",
                    "paddingBlock": "var(--scm-section-py-lg, 4.5rem)",
                    "paddingInline": "var(--scm-gutter, 1rem)"
                },
                "children": [
                    {
                        "id": "auth_reset_wrapper",
                        "type": "basic",
                        "name": "Div",
                        "blur_until_loaded": "{{_global?.currentUser?.uuid}}",
                        "style": {
                            "width": "100%"
                        },
                        "children": [
                            {
                                "partial": "partials/auth/_redirect_if_logged_in.json"
                            },
                            {
                                "id": "auth_reset_card",
                                "type": "basic",
                                "name": "Div",
                                "className": "scm-auth-card",
                                "children": [
                                    {
                                        "id": "auth_reset_heading",
                                        "type": "basic",
                                        "name": "Div",
                                        "style": {
                                            "textAlign": "center",
                                            "marginBottom": "var(--scm-spacing-md, 1rem)"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "H1",
                                                "style": {
                                                    "margin": "0 0 var(--scm-spacing-3xs, 0.25rem)",
                                                    "fontFamily": "var(--scm-font-display, system-ui)",
                                                    "fontSize": "1.375rem",
                                                    "fontWeight": 700,
                                                    "color": "var(--scm-text-primary, #26221E)"
                                                },
                                                "text": "$t:superbify.auth.reset_password.title"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "P",
                                                "style": {
                                                    "margin": 0,
                                                    "fontSize": "0.875rem",
                                                    "color": "var(--scm-text-muted, #8A837B)"
                                                },
                                                "text": "$t:superbify.auth.reset_password.subtitle"
                                            }
                                        ]
                                    },
                                    {
                                        "comment": "토큰 에러 — validate-reset-token 422/기타 오류. BASIC 의 Icon 장식은 텍스트로 대체.",
                                        "id": "auth_reset_token_error",
                                        "type": "basic",
                                        "name": "Div",
                                        "if": "{{_local?.tokenError}}",
                                        "style": {
                                            "textAlign": "center",
                                            "display": "flex",
                                            "flexDirection": "column",
                                            "gap": "var(--scm-spacing-sm, 0.75rem)",
                                            "alignItems": "center"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "P",
                                                "style": {
                                                    "margin": 0,
                                                    "fontSize": "0.875rem",
                                                    "color": "var(--scm-danger, #B3261E)"
                                                },
                                                "text": "$t:superbify.auth.reset_password.token_invalid"
                                            },
                                            {
                                                "id": "auth_reset_token_error_actions",
                                                "type": "basic",
                                                "name": "Div",
                                                "style": {
                                                    "display": "flex",
                                                    "gap": "var(--scm-spacing-sm, 0.75rem)",
                                                    "justifyContent": "center"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Button",
                                                        "props": {
                                                            "type": "button"
                                                        },
                                                        "style": {
                                                            "minHeight": "44px",
                                                            "padding": "0.625rem 1rem",
                                                            "backgroundColor": "var(--scm-charcoal, #26221E)",
                                                            "color": "var(--scm-text-inverse, #FAF8F3)",
                                                            "border": "1px solid var(--scm-charcoal, #26221E)",
                                                            "borderRadius": "var(--scm-radius, 8px)",
                                                            "fontWeight": 600,
                                                            "cursor": "pointer",
                                                            "fontFamily": "var(--scm-font-body, system-ui)",
                                                            "fontSize": "0.9375rem"
                                                        },
                                                        "text": "$t:superbify.auth.reset_password.go_to_login",
                                                        "actions": [
                                                            {
                                                                "type": "click",
                                                                "handler": "navigate",
                                                                "params": {
                                                                    "path": "/login"
                                                                }
                                                            }
                                                        ]
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Button",
                                                        "props": {
                                                            "type": "button"
                                                        },
                                                        "style": {
                                                            "minHeight": "44px",
                                                            "padding": "0.625rem 1rem",
                                                            "backgroundColor": "var(--scm-paper, #FAF8F3)",
                                                            "color": "var(--scm-text-primary, #26221E)",
                                                            "border": "1px solid var(--scm-line, #E4DCCE)",
                                                            "borderRadius": "var(--scm-radius, 8px)",
                                                            "fontWeight": 600,
                                                            "cursor": "pointer",
                                                            "fontFamily": "var(--scm-font-body, system-ui)",
                                                            "fontSize": "0.9375rem"
                                                        },
                                                        "text": "$t:superbify.auth.reset_password.go_to_home",
                                                        "actions": [
                                                            {
                                                                "type": "click",
                                                                "handler": "navigate",
                                                                "params": {
                                                                    "path": "/"
                                                                }
                                                            }
                                                        ]
                                                    }
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "comment": "재설정 폼 — POST /api/auth/reset-password",
                                        "id": "auth_reset_form",
                                        "type": "basic",
                                        "name": "Form",
                                        "dataKey": "form",
                                        "props": {
                                            "id": "form"
                                        },
                                        "if": "{{!_local?.tokenError}}",
                                        "style": {
                                            "display": "flex",
                                            "flexDirection": "column",
                                            "gap": "var(--scm-spacing-md, 1rem)"
                                        },
                                        "children": [
                                            {
                                                "id": "auth_reset_password_field",
                                                "type": "basic",
                                                "name": "Div",
                                                "style": {
                                                    "display": "flex",
                                                    "flexDirection": "column",
                                                    "gap": "0.375rem"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": {
                                                            "htmlFor": "auth_reset_password"
                                                        },
                                                        "style": {
                                                            "fontSize": "0.8125rem",
                                                            "fontWeight": 600,
                                                            "color": "var(--scm-text-primary, #26221E)"
                                                        },
                                                        "text": "$t:superbify.auth.reset_password.password"
                                                    },
                                                    {
                                                        "comment": "BASIC PasswordInput(showToggle/showValidation) 은 SRC 미등록이라 Input type=password 로 치환",
                                                        "type": "basic",
                                                        "name": "Input",
                                                        "id": "auth_reset_password",
                                                        "props": {
                                                            "type": "password",
                                                            "name": "password",
                                                            "placeholder": "$t:superbify.auth.reset_password.password_placeholder|count=8",
                                                            "required": true,
                                                            "minLength": 8,
                                                            "autocomplete": "new-password",
                                                            "disabled": "{{_local?.isSubmitting ?? false}}"
                                                        },
                                                        "style": {
                                                            "minHeight": "44px",
                                                            "padding": "0.625rem 0.75rem",
                                                            "border": "1px solid var(--scm-line, #E4DCCE)",
                                                            "borderRadius": "var(--scm-radius, 8px)",
                                                            "backgroundColor": "#FFFFFF",
                                                            "color": "var(--scm-text-primary, #26221E)",
                                                            "fontSize": "0.9375rem",
                                                            "fontFamily": "var(--scm-font-body, system-ui)"
                                                        }
                                                    }
                                                ]
                                            },
                                            {
                                                "id": "auth_reset_password_confirm_field",
                                                "type": "basic",
                                                "name": "Div",
                                                "style": {
                                                    "display": "flex",
                                                    "flexDirection": "column",
                                                    "gap": "0.375rem"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": {
                                                            "htmlFor": "auth_reset_password_confirm"
                                                        },
                                                        "style": {
                                                            "fontSize": "0.8125rem",
                                                            "fontWeight": 600,
                                                            "color": "var(--scm-text-primary, #26221E)"
                                                        },
                                                        "text": "$t:superbify.auth.reset_password.password_confirm"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Input",
                                                        "id": "auth_reset_password_confirm",
                                                        "props": {
                                                            "type": "password",
                                                            "name": "password_confirmation",
                                                            "placeholder": "$t:superbify.auth.reset_password.password_confirm_placeholder",
                                                            "required": true,
                                                            "autocomplete": "new-password",
                                                            "disabled": "{{_local?.isSubmitting ?? false}}"
                                                        },
                                                        "style": {
                                                            "minHeight": "44px",
                                                            "padding": "0.625rem 0.75rem",
                                                            "border": "1px solid var(--scm-line, #E4DCCE)",
                                                            "borderRadius": "var(--scm-radius, 8px)",
                                                            "backgroundColor": "#FFFFFF",
                                                            "color": "var(--scm-text-primary, #26221E)",
                                                            "fontSize": "0.9375rem",
                                                            "fontFamily": "var(--scm-font-body, system-ui)"
                                                        }
                                                    }
                                                ]
                                            },
                                            {
                                                "id": "auth_reset_submit",
                                                "type": "basic",
                                                "name": "Button",
                                                "props": {
                                                    "type": "submit",
                                                    "disabled": "{{_local?.isSubmitting ?? false}}"
                                                },
                                                "style": {
                                                    "minHeight": "44px",
                                                    "padding": "0.75rem 1rem",
                                                    "backgroundColor": "var(--scm-charcoal, #26221E)",
                                                    "color": "var(--scm-text-inverse, #FAF8F3)",
                                                    "border": "1px solid var(--scm-charcoal, #26221E)",
                                                    "borderRadius": "var(--scm-radius, 8px)",
                                                    "fontWeight": 600,
                                                    "cursor": "pointer",
                                                    "fontFamily": "var(--scm-font-body, system-ui)",
                                                    "fontSize": "0.9375rem"
                                                },
                                                "text": "{{_local?.isSubmitting ? '$t:superbify.auth.reset_password.processing' : '$t:superbify.auth.reset_password.submit'}}"
                                            }
                                        ],
                                        "actions": [
                                            {
                                                "type": "submit",
                                                "handler": "sequence",
                                                "actions": [
                                                    {
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "isSubmitting": true
                                                        }
                                                    },
                                                    {
                                                        "handler": "apiCall",
                                                        "target": "/api/auth/reset-password",
                                                        "params": {
                                                            "method": "POST",
                                                            "body": {
                                                                "token": "{{query.token ?? ''}}",
                                                                "email": "{{query.email ?? ''}}",
                                                                "password": "{{form?.password}}",
                                                                "password_confirmation": "{{form?.password_confirmation}}"
                                                            }
                                                        },
                                                        "onSuccess": [
                                                            {
                                                                "handler": "setState",
                                                                "params": {
                                                                    "target": "local",
                                                                    "isSubmitting": false
                                                                }
                                                            },
                                                            {
                                                                "handler": "toast",
                                                                "params": {
                                                                    "type": "success",
                                                                    "message": "$t:superbify.auth.reset_password.success"
                                                                }
                                                            },
                                                            {
                                                                "handler": "navigate",
                                                                "params": {
                                                                    "path": "/login"
                                                                }
                                                            }
                                                        ],
                                                        "onError": [
                                                            {
                                                                "handler": "setState",
                                                                "params": {
                                                                    "target": "local",
                                                                    "isSubmitting": false
                                                                }
                                                            },
                                                            {
                                                                "handler": "toast",
                                                                "params": {
                                                                    "type": "error",
                                                                    "message": "{{error.message}}"
                                                                }
                                                            }
                                                        ]
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
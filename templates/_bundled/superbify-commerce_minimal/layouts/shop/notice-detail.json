{
    "version": "1.0.0",
    "layout_name": "shop/notice-detail",
    "permissions": [],
    "extends": "_user_base",
    "meta": {
        "title": "$t:superbify.routes.notice_detail.title",
        "description": "$t:superbify.routes.notice_detail.description"
    },
    "data_sources": [
        {
            "id": "notice_post",
            "label_key": "$t:superbify.data_source.notice_posts",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-board/boards/store-notice/posts/{{route.id}}",
            "method": "GET",
            "auto_fetch": true,
            "refetchOnMount": true,
            "auth_mode": "optional",
            "errorHandling": {
                "404": {
                    "handler": "navigate",
                    "params": {
                        "path": "/shop/notice"
                    }
                }
            }
        },
        {
            "_comment": "이전/다음 공지 — sirsoft-board 공식 navigation 엔드포인트 (data.prev / data.next)",
            "id": "notice_navigation",
            "label_key": "$t:superbify.data_source.notice_posts",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-board/boards/store-notice/posts/{{route.id}}/navigation",
            "method": "GET",
            "auto_fetch": true,
            "refetchOnMount": true,
            "auth_mode": "optional"
        }
    ],
    "slots": {
        "content": [
            {
                "id": "shop_notice_detail",
                "type": "basic",
                "name": "Section",
                "style": {
                    "paddingBlock": "var(--scm-section-py-md, 3rem)"
                },
                "children": [
                    {
                        "id": "shop_notice_detail_inner",
                        "type": "basic",
                        "name": "Div",
                        "style": {
                            "maxWidth": "680px",
                            "marginInline": "auto",
                            "paddingInline": "var(--scm-gutter, 1rem)",
                            "display": "flex",
                            "flexDirection": "column",
                            "gap": "var(--scm-spacing-md, 1rem)"
                        },
                        "children": [
                            {
                                "comment": "목록으로",
                                "id": "shop_notice_detail_back",
                                "type": "basic",
                                "name": "A",
                                "props": {
                                    "href": "{{_global.shopBase ?? '/shop'}}/notice",
                                    "className": "scm-notice-back-link"
                                },
                                "style": {
                                    "display": "inline-flex",
                                    "alignSelf": "flex-start",
                                    "alignItems": "center",
                                    "gap": "var(--scm-spacing-3xs, 0.125rem)",
                                    "fontFamily": "var(--scm-font-body, system-ui)",
                                    "fontSize": "0.8125rem",
                                    "color": "var(--scm-text-muted, #8A837B)",
                                    "textDecoration": "none",
                                    "minHeight": "var(--scm-touch-min, 44px)"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "←"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "$t:superbify.notice.back_to_list"
                                    }
                                ]
                            },
                            {
                                "id": "shop_notice_detail_eyebrow",
                                "type": "basic",
                                "name": "Span",
                                "style": {
                                    "fontFamily": "var(--scm-font-body, system-ui)",
                                    "fontSize": "0.75rem",
                                    "color": "var(--scm-text-muted, #8A837B)",
                                    "letterSpacing": "0.08em",
                                    "textTransform": "uppercase"
                                },
                                "text": "$t:superbify.notice.eyebrow"
                            },
                            {
                                "id": "shop_notice_detail_title",
                                "type": "basic",
                                "name": "H1",
                                "if": "{{notice_post?.data?.title}}",
                                "style": {
                                    "fontFamily": "var(--scm-font-display, system-ui)",
                                    "fontSize": "1.5rem",
                                    "fontWeight": "700",
                                    "lineHeight": 1.4,
                                    "color": "var(--scm-text-primary, #26221E)",
                                    "margin": "0"
                                },
                                "text": "{{notice_post?.data?.title ?? ''}}"
                            },
                            {
                                "id": "shop_notice_detail_meta",
                                "type": "basic",
                                "name": "Div",
                                "if": "{{notice_post?.data}}",
                                "style": {
                                    "display": "flex",
                                    "alignItems": "center",
                                    "flexWrap": "wrap",
                                    "gap": "var(--scm-spacing-sm, 0.75rem)",
                                    "paddingBottom": "var(--scm-spacing-md, 1rem)",
                                    "borderBottom": "var(--scm-hairline, 1px solid #E4DCCE)",
                                    "fontFamily": "var(--scm-font-body, system-ui)",
                                    "fontSize": "0.8125rem",
                                    "color": "var(--scm-text-muted, #8A837B)"
                                },
                                "children": [
                                    {
                                        "comment": "고정 badge (공지글만)",
                                        "id": "shop_notice_detail_fixed_badge",
                                        "type": "basic",
                                        "name": "Span",
                                        "if": "{{notice_post?.data?.is_notice === true}}",
                                        "text": "$t:superbify.notice.fixed_badge",
                                        "style": {
                                            "fontSize": "0.6875rem",
                                            "fontWeight": "600",
                                            "letterSpacing": "0.04em",
                                            "color": "var(--scm-text-inverse, #FAF8F3)",
                                            "backgroundColor": "var(--scm-charcoal, #26221E)",
                                            "borderRadius": "var(--scm-radius-sm, 4px)",
                                            "padding": "0.125rem 0.375rem",
                                            "lineHeight": 1.4
                                        }
                                    },
                                    {
                                        "id": "shop_notice_detail_date",
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "{{notice_post?.data?.created_at_formatted ?? ''}}"
                                    },
                                    {
                                        "comment": "조회 수 — 0 이상일 때만 라벨과 함께",
                                        "id": "shop_notice_detail_view_count",
                                        "type": "basic",
                                        "name": "Span",
                                        "if": "{{Number(notice_post?.data?.view_count ?? 0) > 0}}",
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Span",
                                                "text": "{{notice_post?.data?.view_count ?? 0}}"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Span",
                                                "text": "$t:superbify.notice.view_count"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "comment": "본문 — content_mode='html' 은 공식 HtmlContent(DOMPurify) 채널로, 'text' 는 줄바꿈 보존 텍스트로",
                                "id": "shop_notice_detail_content",
                                "type": "composite",
                                "name": "HtmlContent",
                                "props": {
                                    "content": "{{notice_post?.data?.content ?? ''}}",
                                    "isHtml": "{{(notice_post?.data?.content_mode ?? 'text') === 'html'}}",
                                    "className": "scm-rich-content"
                                }
                            },
                            {
                                "comment": "이전/다음 공지 네비게이션 (값이 없는 방향은 렌더하지 않음)",
                                "id": "shop_notice_detail_nav",
                                "type": "basic",
                                "name": "Div",
                                "if": "{{(notice_navigation?.data?.prev?.id ?? null) !== null || (notice_navigation?.data?.next?.id ?? null) !== null}}",
                                "style": {
                                    "display": "flex",
                                    "justifyContent": "space-between",
                                    "gap": "var(--scm-spacing-md, 1rem)",
                                    "marginTop": "var(--scm-spacing-lg, 1.5rem)",
                                    "paddingTop": "var(--scm-spacing-md, 1rem)",
                                    "borderTop": "var(--scm-hairline, 1px solid #E4DCCE)",
                                    "fontFamily": "var(--scm-font-body, system-ui)",
                                    "fontSize": "0.875rem",
                                    "flexWrap": "wrap",
                                    "rowGap": "var(--scm-spacing-xs, 0.5rem)"
                                },
                                "children": [
                                    {
                                        "id": "shop_notice_detail_nav_prev",
                                        "type": "basic",
                                        "name": "A",
                                        "if": "{{notice_navigation?.data?.prev?.id}}",
                                        "props": {
                                            "href": "{{_global.shopBase ?? '/shop'}}/notice/{{notice_navigation?.data?.prev?.id}}",
                                            "className": "scm-notice-nav-link scm-notice-nav-prev",
                                            "title": "{{notice_navigation?.data?.prev?.title ?? ''}}"
                                        },
                                        "style": {
                                            "display": "inline-flex",
                                            "alignItems": "center",
                                            "gap": "var(--scm-spacing-xs, 0.5rem)",
                                            "color": "var(--scm-text-primary, #26221E)",
                                            "textDecoration": "none",
                                            "minHeight": "var(--scm-touch-min, 44px)",
                                            "overflow": "hidden",
                                            "maxWidth": "100%"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Span",
                                                "text": "← $t:superbify.notice.prev_post",
                                                "style": {
                                                    "whiteSpace": "nowrap"
                                                }
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Span",
                                                "text": "{{notice_navigation?.data?.prev?.title ?? ''}}",
                                                "style": {
                                                    "color": "var(--scm-text-muted, #8A837B)",
                                                    "overflow": "hidden",
                                                    "textOverflow": "ellipsis",
                                                    "whiteSpace": "nowrap"
                                                },
                                                "className": " scm-notice-nav-neighbor-title"
                                            }
                                        ]
                                    },
                                    {
                                        "id": "shop_notice_detail_nav_next",
                                        "type": "basic",
                                        "name": "A",
                                        "if": "{{notice_navigation?.data?.next?.id}}",
                                        "props": {
                                            "href": "{{_global.shopBase ?? '/shop'}}/notice/{{notice_navigation?.data?.next?.id}}",
                                            "className": "scm-notice-nav-link scm-notice-nav-next",
                                            "title": "{{notice_navigation?.data?.next?.title ?? ''}}"
                                        },
                                        "style": {
                                            "display": "inline-flex",
                                            "alignItems": "center",
                                            "gap": "var(--scm-spacing-xs, 0.5rem)",
                                            "marginLeft": "auto",
                                            "color": "var(--scm-text-primary, #26221E)",
                                            "textDecoration": "none",
                                            "minHeight": "var(--scm-touch-min, 44px)",
                                            "overflow": "hidden",
                                            "textAlign": "right",
                                            "maxWidth": "100%"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Span",
                                                "text": "{{notice_navigation?.data?.next?.title ?? ''}}",
                                                "style": {
                                                    "color": "var(--scm-text-muted, #8A837B)",
                                                    "overflow": "hidden",
                                                    "textOverflow": "ellipsis",
                                                    "whiteSpace": "nowrap"
                                                },
                                                "className": " scm-notice-nav-neighbor-title"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Span",
                                                "text": "$t:superbify.notice.next_post →",
                                                "style": {
                                                    "whiteSpace": "nowrap"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "transition_overlay": {
        "enabled": true,
        "style": "spinner",
        "wait_for": [
            "notice_post",
            "notice_navigation"
        ],
        "target": "main_content_area",
        "spinner": {
            "component": "PageLoading"
        },
        "_comment": "데이터 로딩 중 빈 empty-state 플래시 방지 — progressive 소스 fetch 동안 콘텐츠 영역에 PageLoading 표시(sirsoft-basic transition_overlay 패턴)."
    }
}

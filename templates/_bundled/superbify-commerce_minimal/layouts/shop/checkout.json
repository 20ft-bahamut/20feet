{
    "version": "1.0.0",
    "layout_name": "shop/checkout",
    "permissions": [],
    "extends": "_user_base",
    "meta": {
        "title": "$t:superbify.routes.checkout.title",
        "description": "$t:superbify.routes.checkout.description"
    },
    "data_sources": [
        {
            "id": "cart",
            "label_key": "$t:superbify.data_source.cart",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/cart",
            "method": "GET",
            "auto_fetch": true,
            "auth_mode": "optional",
            "loading_strategy": "progressive",
            "fallback": { "data": { "items": [], "item_ids": [], "item_count": 0, "calculation": null } }
        }
    ],
    "init_actions": [
        {
            "handler": "scmBindCartPageListeners"
        }
    ],
    "slots": {
        "content": [
            {
                "id": "checkout_page",
                "type": "basic",
                "name": "Section",
                "style": {
                    "paddingBlock": "var(--scm-section-py-md, 3rem)"
                },
                "children": [
                    {
                        "id": "checkout_page_inner",
                        "type": "basic",
                        "name": "Div",
                        "style": {
                            "maxWidth": "var(--scm-max-width, 960px)",
                            "marginInline": "auto",
                            "paddingInline": "var(--scm-gutter, 1rem)",
                            "display": "flex",
                            "flexDirection": "column",
                            "gap": "var(--scm-spacing-md, 1rem)"
                        },
                        "children": [
                            {
                                "id": "checkout_page_title",
                                "type": "basic",
                                "name": "H1",
                                "style": {
                                    "fontFamily": "var(--scm-font-display, system-ui)",
                                    "fontSize": "1.75rem",
                                    "fontWeight": "700",
                                    "color": "var(--scm-text-primary, #26221E)",
                                    "margin": "0"
                                },
                                "text": "$t:superbify.cart.checkout_title"
                            },
                            {
                                "id": "checkout_page_empty",
                                "type": "composite",
                                "name": "EmptyState",
                                "if": "{{!cart?.data?.items || (cart.data.items?.length ?? 0) === 0}}",
                                "props": {
                                    "title": "$t:superbify.cart.empty_title",
                                    "message": "$t:superbify.cart.empty_message",
                                    "ctaLabel": "$t:superbify.cart.cta_shop",
                                    "ctaHref": "/shop"
                                }
                            },
                            {
                                "id": "checkout_page_layout",
                                "if": "{{cart?.data?.items && (cart.data.items?.length ?? 0) > 0}}",
                                "type": "basic",
                                "name": "Div",
                                "style": {
                                    "display": "grid",
                                    "gridTemplateColumns": "1fr",
                                    "gap": "var(--scm-spacing-lg, 1.5rem)"
                                },
                                "responsive": {
                                    "tablet": {
                                        "style": { "gridTemplateColumns": "2fr 1fr" }
                                    }
                                },
                                "children": [
                                    {
                                        "id": "checkout_page_placeholder",
                                        "type": "basic",
                                        "name": "Div",
                                        "style": {
                                            "padding": "var(--scm-spacing-lg, 1.5rem)",
                                            "backgroundColor": "var(--scm-bg-secondary, #F4F0E6)",
                                            "border": "1px dashed var(--scm-line, #E4DCCE)",
                                            "borderRadius": "var(--scm-radius, 8px)",
                                            "display": "flex",
                                            "flexDirection": "column",
                                            "gap": "var(--scm-spacing-sm, 0.75rem)"
                                        },
                                        "children": [
                                            {
                                                "id": "checkout_page_placeholder_title",
                                                "type": "basic",
                                                "name": "H3",
                                                "style": {
                                                    "fontFamily": "var(--scm-font-display, system-ui)",
                                                    "fontSize": "1.05rem",
                                                    "fontWeight": 600,
                                                    "color": "var(--scm-text-primary, #26221E)",
                                                    "margin": 0
                                                },
                                                "text": "$t:superbify.cart.checkout_placeholder_title"
                                            },
                                            {
                                                "id": "checkout_page_placeholder_message",
                                                "type": "basic",
                                                "name": "P",
                                                "style": {
                                                    "fontFamily": "var(--scm-font-body, system-ui)",
                                                    "fontSize": "0.9rem",
                                                    "color": "var(--scm-text-body, #4A4643)",
                                                    "margin": 0,
                                                    "lineHeight": 1.6
                                                },
                                                "text": "$t:superbify.cart.checkout_placeholder_message"
                                            }
                                        ]
                                    },
                                    {
                                        "id": "checkout_page_summary",
                                        "type": "composite",
                                        "name": "CartSummary",
                                        "props": {
                                            "items": "{{cart.data.items}}",
                                            "itemCount": "{{cart.data.item_count ?? (cart.data.items?.length ?? 0)}}",
                                            "calculation": "{{cart.data.calculation}}",
                                            "summaryTitle": "$t:superbify.cart.summary_title",
                                            "itemsLabel": "$t:superbify.cart.summary_items",
                                            "subtotalLabel": "$t:superbify.cart.summary_subtotal",
                                            "shippingLabel": "$t:superbify.cart.summary_shipping",
                                            "totalLabel": "$t:superbify.cart.summary_total",
                                            "checkoutLabel": "$t:superbify.cart.summary_checkout",
                                            "continueShoppingLabel": "$t:superbify.cart.summary_continue_shopping",
                                            "isOrdering": true
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}

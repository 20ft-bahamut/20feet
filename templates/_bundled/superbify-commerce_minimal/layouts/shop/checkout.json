{
    "version": "1.0.0",
    "layout_name": "shop/checkout",
    "permissions": [],
    "extends": "_user_base",
    "meta": {
        "title": "$t:superbify.routes.checkout.title",
        "description": "$t:superbify.routes.checkout.description"
    },
    "data_sources": [
        {
            "_comment": "주문 정보 — temp_order_id 가 응답에 포함되어야 CheckoutPage 가 POST /user/orders 시 첨부한다. POST /checkout 호출은 CheckoutPage 내부에서 수행한다.",
            "id": "checkoutData",
            "label_key": "$t:superbify.data_source.cart",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/checkout",
            "method": "GET",
            "auto_fetch": true,
            "auth_mode": "optional",
            "loading_strategy": "progressive",
            "fallback": { "data": null }
        },
        {
            "_comment": "결제 설정 — 활성 결제 수단 목록 (현재 런타임: dbank 만 활성화됨)",
            "id": "paymentSettings",
            "label_key": "$t:superbify.data_source.cart",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/settings/payment",
            "method": "GET",
            "auto_fetch": true,
            "auth_mode": "optional",
            "loading_strategy": "progressive",
            "fallback": { "data": { "order_settings": { "payment_methods": [], "banks": [], "bank_accounts": [] } } }
        },
        {
            "_comment": "배송 설정 — 기본 국가/해외 배송 가능 여부",
            "id": "shippingSettings",
            "label_key": "$t:superbify.data_source.cart",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/settings/shipping",
            "method": "GET",
            "auto_fetch": true,
            "auth_mode": "optional",
            "loading_strategy": "progressive",
            "fallback": { "data": { "shipping": { "default_country": "KR", "international_shipping_enabled": false } } }
        }
    ],
    "init_actions": [
        {
            "_comment": "카트 키 초기화 (X-Cart-Key globalHeader 주입 패턴). _user_base 의 init_actions 와 중복 실행되지만 멱등.",
            "handler": "initCartKey"
        }
    ],
    "slots": {
        "content": [
            {
                "_comment": "daum 우편번호 extension_point (FORK SOURCE: templates/_bundled/sirsoft-basic/layouts/partials/shop/_checkout_shipping.json:484-543. 우편번호 검색 버튼을 주입받는 sibling 배치 — 플러그인 openPostcode 는 DOM input 에 값을 쓰지 않고 callbackAction($event) 디스패치만 하므로, CheckoutForm(React controlled input)은 _global.checkoutAddress 브리지로만 주소를 받는다. CheckoutForm 은 input name=zipcode/address 를 유지하므로 setFieldReadOnly 가 그대로 동작한다.)",
                "id": "checkout_address_search_slot",
                "type": "extension_point",
                "name": "address_search_slot",
                "props": {
                    "readOnlyFields": ["zipcode", "address"]
                },
                "callbacks": {
                    "onAddressSelect": {
                        "handler": "sequence",
                        "actions": [
                            {
                                "comment": "우편번호/주소를 _global.checkoutAddress 에 기록 — CheckoutForm 이 G7Core.state 구독으로 동기화",
                                "handler": "setState",
                                "params": {
                                    "target": "global",
                                    "checkoutAddress": {
                                        "zipcode": "{{$event.zipcode}}",
                                        "address": "{{$event.address}}",
                                        "region": "{{$event.region}}",
                                        "city": "{{$event.city}}",
                                        "country_code": "{{$event.countryCode ?? 'KR'}}"
                                    }
                                }
                            },
                            {
                                "comment": "배송지 변경 시 checkout API 호출 (도서산간 배송비 재계산)",
                                "handler": "apiCall",
                                "target": "/api/modules/sirsoft-ecommerce/checkout",
                                "auth_mode": "optional",
                                "params": {
                                    "method": "PUT",
                                    "body": {
                                        "zipcode": "{{_global.checkoutAddress?.zipcode ?? ''}}",
                                        "country_code": "{{_global.checkoutAddress?.country_code ?? 'KR'}}"
                                    }
                                },
                                "onSuccess": [
                                    {
                                        "handler": "refetchDataSource",
                                        "params": {
                                            "dataSourceId": "checkoutData"
                                        }
                                    }
                                ],
                                "onError": [
                                    {
                                        "handler": "toast",
                                        "params": {
                                            "type": "error",
                                            "message": "{{error.message}}"
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                }
            },
            {
                "id": "checkout_page_wrapper",
                "type": "composite",
                "name": "CheckoutPage",
                "props": {
                    "_comment": "data source id 를 prop 이름으로 사용해 엔진이 현재 데이터소스 값을 자동으로 평가한다",
                    "checkoutData": "{{checkoutData}}",
                    "paymentSettings": "{{paymentSettings}}",
                    "shippingSettings": "{{shippingSettings}}",
                    "isLoggedIn": "{{_global.currentUser ? true : false}}",
                    "currentUserName": "{{_global.currentUser?.name ?? ''}}",
                    "currentUserPhone": "{{_global.currentUser?.phone ?? ''}}",
                    "currentUserEmail": "{{_global.currentUser?.email ?? ''}}",
                    "locale": "ko",
                    "title": "$t:superbify.checkout.title",
                    "loadingLabel": "$t:superbify.checkout.loading",
                    "emptyTempOrderTitle": "$t:superbify.checkout.empty_title",
                    "backToShopLabel": "$t:superbify.checkout.back_to_cart",
                    "submitErrorTitle": "$t:superbify.checkout.submit_error_title",
                    "orderFailedFallback": "$t:superbify.checkout.order_failed_fallback"
                }
            }
        ]
    }
}
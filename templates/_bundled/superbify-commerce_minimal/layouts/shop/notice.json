{
    "version": "1.0.0",
    "layout_name": "shop/notice",
    "permissions": [],
    "extends": "_user_base",
    "meta": {
        "title": "$t:superbify.routes.notice.title",
        "description": "$t:superbify.routes.notice.description"
    },
    "data_sources": [
        {
            "id": "notice_posts",
            "label_key": "$t:superbify.data_source.notice_posts",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-board/boards/store-notice/posts",
            "method": "GET",
            "params": {
                "per_page": "{{query.per_page ?? 10}}",
                "page": "{{query.page ?? 1}}"
            },
            "auto_fetch": true,
            "refetchOnMount": true,
            "loading_strategy": "progressive",
            "auth_mode": "optional"
        }
    ],
    "slots": {
        "content": [
            {
                "id": "shop_notice",
                "type": "basic",
                "name": "Section",
                "style": {
                    "paddingBlock": "var(--scm-section-py-md, 3rem)"
                },
                "children": [
                    {
                        "id": "shop_notice_inner",
                        "type": "basic",
                        "name": "Div",
                        "style": {
                            "maxWidth": "var(--scm-max-width, 1200px)",
                            "marginInline": "auto",
                            "paddingInline": "var(--scm-gutter, 1rem)",
                            "display": "flex",
                            "flexDirection": "column",
                            "gap": "var(--scm-spacing-md, 1rem)"
                        },
                        "children": [
                            {
                                "id": "shop_notice_eyebrow",
                                "type": "basic",
                                "name": "Span",
                                "style": {
                                    "fontFamily": "var(--scm-font-body, system-ui)",
                                    "fontSize": "0.75rem",
                                    "color": "var(--scm-text-muted, #8A837B)",
                                    "letterSpacing": "0.08em",
                                    "textTransform": "uppercase"
                                },
                                "text": "$t:superbify.notice.eyebrow"
                            },
                            {
                                "id": "shop_notice_title",
                                "type": "basic",
                                "name": "H1",
                                "style": {
                                    "fontFamily": "var(--scm-font-display, system-ui)",
                                    "fontSize": "1.75rem",
                                    "fontWeight": "700",
                                    "color": "var(--scm-text-primary, #26221E)",
                                    "margin": "0"
                                },
                                "text": "$t:superbify.notice.title"
                            },
                            {
                                "id": "shop_notice_list",
                                "type": "composite",
                                "name": "NoticeList",
                                "props": {
                                    "items": "{{notice_posts?.data?.data ?? []}}",
                                    "loading": "{{notice_posts?.loading ?? false}}",
                                    "fixedLabel": "$t:superbify.notice.fixed_badge",
                                    "emptyTitle": "$t:superbify.notice.empty_title",
                                    "emptyMessage": "$t:superbify.notice.empty_message",
                                    "detailBasePath": "/shop/notice",
                                    "rowAriaLabel": "$t:superbify.notice.row_aria"
                                }
                            },
                            {
                                "comment": "공지 페이지네이션 — last_page ≤ 1 이면 컴포넌트 자체가 null 렌더",
                                "id": "shop_notice_pagination",
                                "type": "composite",
                                "name": "Pagination",
                                "props": {
                                    "currentPage": "{{Number(notice_posts?.data?.pagination?.current_page ?? 1)}}",
                                    "totalPages": "{{Number(notice_posts?.data?.pagination?.last_page ?? 1)}}",
                                    "prevLabel": "$t:superbify.notice.prev_page_aria",
                                    "nextLabel": "$t:superbify.notice.next_page_aria",
                                    "pageLabel": "$t:superbify.notice.page_aria"
                                },
                                "actions": [
                                    {
                                        "event": "onPageChange",
                                        "handler": "navigate",
                                        "params": {
                                            "path": "/shop/notice",
                                            "mergeQuery": true,
                                            "query": {
                                                "page": "{{$args[0]}}"
                                            }
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
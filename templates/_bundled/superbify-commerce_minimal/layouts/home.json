{
    "version": "1.0.0",
    "layout_name": "home",
    "permissions": [],
    "extends": "_user_base",
    "meta": {
        "title": "$t:superbify.routes.home.title",
        "description": "$t:superbify.routes.home.description"
    },
    "data_sources": [
        {
            "id": "new_arrivals",
            "label_key": "$t:superbify.data_source.new_arrivals",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/products/new",
            "method": "GET",
            "params": {
                "limit": 8
            },
            "auto_fetch": true,
            "loading_strategy": "progressive"
        },
        {
            "id": "popular_products",
            "label_key": "$t:superbify.data_source.popular_products",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/products/popular",
            "method": "GET",
            "params": {
                "limit": 7
            },
            "auto_fetch": true,
            "loading_strategy": "progressive"
        },
        {
            "id": "featured_categories",
            "label_key": "$t:superbify.data_source.featured_categories",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/categories",
            "method": "GET",
            "auto_fetch": true,
            "loading_strategy": "progressive"
        }
    ],
    "slots": {
        "content": [
            {
                "id": "home_hero",
                "type": "composite",
                "name": "HeroBanner",
                "props": {
                    "eyebrow": "$t:superbify.home.hero.eyebrow",
                    "headline": "$t:superbify.home.hero.headline",
                    "sub": "$t:superbify.home.hero.sub",
                    "primaryCtaLabel": "$t:superbify.home.hero.cta_primary",
                    "primaryCtaHref": "/shop",
                    "secondaryCtaLabel": "$t:superbify.home.hero.cta_secondary",
                    "secondaryCtaHref": "/shop/story",
                    "mediaSlot": "hero-mood-1",
                    "veil": true,
                    "bleed": "full"
                }
            },
            {
                "id": "home_featured_categories",
                "type": "basic",
                "name": "Section",
                "style": {
                    "paddingBlock": "var(--scm-section-py-md, 3.5rem)"
                },
                "children": [
                    {
                        "id": "home_featured_categories_inner",
                        "type": "basic",
                        "name": "Div",
                        "style": {
                            "maxWidth": "var(--scm-max-width, 1320px)",
                            "marginInline": "auto",
                            "paddingInline": "var(--scm-gutter, 1rem)",
                            "display": "flex",
                            "flexDirection": "column",
                            "gap": "var(--scm-spacing-lg, 1.5rem)"
                        },
                        "children": [
                            {
                                "id": "home_featured_categories_strip",
                                "type": "composite",
                                "name": "CategoryPreviewStrip",
                                "props": {
                                    "eyebrow": "$t:superbify.home.featured_categories.eyebrow",
                                    "title": "$t:superbify.home.featured_categories.heading",
                                    "items": "{{featured_categories?.data?.data ?? featured_categories?.data ?? []}}",
                                    "emptyLabel": "$t:superbify.home.featured_categories.empty_label"
                                }
                            }
                        ]
                    }
                ]
            },
            {
                "id": "home_new_arrivals",
                "type": "basic",
                "name": "Section",
                "style": {
                    "paddingBlock": "var(--scm-section-py-lg, 6rem)"
                },
                "children": [
                    {
                        "id": "home_new_arrivals_inner",
                        "type": "basic",
                        "name": "Div",
                        "style": {
                            "maxWidth": "var(--scm-max-width, 1320px)",
                            "marginInline": "auto",
                            "paddingInline": "var(--scm-gutter, 1rem)",
                            "display": "flex",
                            "flexDirection": "column",
                            "gap": "var(--scm-spacing-lg, 1.5rem)"
                        },
                        "children": [
                            {
                                "id": "home_new_arrivals_header",
                                "type": "basic",
                                "name": "Div",
                                "style": {
                                    "display": "flex",
                                    "flexDirection": "column",
                                    "gap": "var(--scm-spacing-2xs, 0.25rem)"
                                },
                                "children": [
                                    {
                                        "id": "home_new_arrivals_eyebrow",
                                        "type": "basic",
                                        "name": "Span",
                                        "style": {
                                            "fontFamily": "var(--scm-font-body, system-ui)",
                                            "fontSize": "0.75rem",
                                            "color": "var(--scm-wood-dark, #A8916F)",
                                            "letterSpacing": "0.14em",
                                            "textTransform": "uppercase",
                                            "fontWeight": 600
                                        },
                                        "text": "$t:superbify.home.new_arrivals.eyebrow"
                                    },
                                    {
                                        "id": "home_new_arrivals_heading",
                                        "type": "basic",
                                        "name": "H2",
                                        "style": {
                                            "fontFamily": "var(--scm-font-display, system-ui)",
                                            "fontSize": "1.75rem",
                                            "fontWeight": 600,
                                            "color": "var(--scm-text-primary, #26221E)",
                                            "margin": 0,
                                            "letterSpacing": "-0.01em"
                                        },
                                        "text": "$t:superbify.home.new_arrivals.heading"
                                    }
                                ]
                            },
                            {
                                "id": "home_new_arrivals_grid",
                                "type": "composite",
                                "name": "ProductGrid",
                                "props": {
                                    "items": "{{(new_arrivals?.data?.data ?? new_arrivals?.data ?? [])}}",
                                    "limit": 8,
                                    "loading": "{{new_arrivals?.loading ?? false}}",
                                    "variant": "standard",
                                    "emptyTitle": "$t:superbify.shop.empty_title",
                                    "emptyMessage": "$t:superbify.shop.empty_message",
                                    "quickAddLabel": "$t:superbify.product.quick_add"
                                }
                            }
                        ]
                    }
                ]
            },
            {
                "id": "home_popular",
                "type": "basic",
                "name": "Section",
                "style": {
                    "paddingBlock": "var(--scm-section-py-lg, 6rem)",
                    "backgroundColor": "var(--scm-bg-secondary, #F4F0E6)"
                },
                "children": [
                    {
                        "id": "home_popular_inner",
                        "type": "basic",
                        "name": "Div",
                        "style": {
                            "maxWidth": "var(--scm-max-width, 1320px)",
                            "marginInline": "auto",
                            "paddingInline": "var(--scm-gutter, 1rem)",
                            "display": "flex",
                            "flexDirection": "column",
                            "gap": "var(--scm-spacing-xl, 2rem)"
                        },
                        "children": [
                            {
                                "id": "home_popular_header",
                                "type": "basic",
                                "name": "Div",
                                "style": {
                                    "display": "flex",
                                    "flexDirection": "column",
                                    "gap": "var(--scm-spacing-2xs, 0.25rem)"
                                },
                                "children": [
                                    {
                                        "id": "home_popular_eyebrow",
                                        "type": "basic",
                                        "name": "Span",
                                        "style": {
                                            "fontFamily": "var(--scm-font-body, system-ui)",
                                            "fontSize": "0.75rem",
                                            "color": "var(--scm-wood-dark, #A8916F)",
                                            "letterSpacing": "0.14em",
                                            "textTransform": "uppercase",
                                            "fontWeight": 600
                                        },
                                        "text": "$t:superbify.home.popular.eyebrow"
                                    },
                                    {
                                        "id": "home_popular_heading",
                                        "type": "basic",
                                        "name": "H2",
                                        "style": {
                                            "fontFamily": "var(--scm-font-display, system-ui)",
                                            "fontSize": "1.875rem",
                                            "fontWeight": 600,
                                            "color": "var(--scm-text-primary, #26221E)",
                                            "margin": 0,
                                            "letterSpacing": "-0.015em"
                                        },
                                        "text": "$t:superbify.home.popular.heading"
                                    }
                                ]
                            },
                            {
                                "id": "home_popular_grid",
                                "type": "composite",
                                "name": "ProductGrid",
                                "props": {
                                    "items": "{{(popular_products?.data?.data ?? popular_products?.data ?? [])}}",
                                    "limit": 7,
                                    "loading": "{{popular_products?.loading ?? false}}",
                                    "variant": "featured",
                                    "emptyTitle": "$t:superbify.shop.empty_title",
                                    "emptyMessage": "$t:superbify.shop.empty_message",
                                    "quickAddLabel": "$t:superbify.product.quick_add",
                                    "featuredCtaLabel": "$t:superbify.product.view_detail",
                                    "featuredEyebrow": "$t:superbify.product.featured_eyebrow"
                                }
                            }
                        ]
                    }
                ]
            },
            {
                "id": "home_brand_story",
                "type": "basic",
                "name": "Section",
                "style": {
                    "paddingBlock": "var(--scm-section-py-lg, 6rem)"
                },
                "children": [
                    {
                        "id": "home_brand_story_inner",
                        "type": "basic",
                        "name": "Div",
                        "style": {
                            "maxWidth": "var(--scm-max-width, 1320px)",
                            "marginInline": "auto",
                            "paddingInline": "var(--scm-gutter, 1rem)"
                        },
                        "children": [
                            {
                                "id": "home_brand_story_component",
                                "type": "composite",
                                "name": "BrandStorySection",
                                "props": {
                                    "eyebrow": "$t:superbify.home.story.eyebrow",
                                    "heading": "$t:superbify.home.story.heading",
                                    "body": "$t:superbify.home.story.body",
                                    "ctaLabel": "$t:superbify.home.hero.cta_secondary",
                                    "ctaHref": "/shop/story",
                                    "mediaSlot": "hero-mood-2",
                                    "layout": "split"
                                }
                            }
                        ]
                    }
                ]
            },
            {
                "id": "home_editorial",
                "type": "basic",
                "name": "Section",
                "style": {
                    "paddingInline": "var(--scm-gutter, 1rem)",
                    "paddingBlock": "var(--scm-section-py-md, 4rem)"
                },
                "children": [
                    {
                        "id": "home_editorial_inner",
                        "type": "basic",
                        "name": "Div",
                        "style": {
                            "maxWidth": "var(--scm-max-width, 1320px)",
                            "marginInline": "auto"
                        },
                        "children": [
                            {
                                "id": "home_editorial_banner",
                                "type": "composite",
                                "name": "EditorialBanner",
                                "props": {
                                    "eyebrow": "$t:superbify.home.editorial.eyebrow",
                                    "heading": "$t:superbify.home.editorial.heading",
                                    "body": "$t:superbify.home.editorial.body",
                                    "ctaLabel": "$t:superbify.home.editorial.cta",
                                    "ctaHref": "/shop",
                                    "variant": "panel",
                                    "mediaSrc": "/api/templates/assets/superbify-commerce_minimal/images/demo/editorial.jpg"
                                }
                            }
                        ]
                    }
                ]
            },
            {
                "id": "home_final_cta",
                "type": "basic",
                "name": "Section",
                "style": {
                    "paddingBlock": "var(--scm-section-py-lg, 5rem)"
                },
                "children": [
                    {
                        "id": "home_final_cta_inner",
                        "type": "basic",
                        "name": "Div",
                        "style": {
                            "maxWidth": "var(--scm-max-width, 1320px)",
                            "marginInline": "auto",
                            "paddingInline": "var(--scm-gutter, 1rem)",
                            "display": "flex",
                            "justifyContent": "center"
                        },
                        "children": [
                            {
                                "id": "home_final_cta_card",
                                "type": "basic",
                                "name": "Div",
                                "style": {
                                    "display": "grid",
                                    "gridTemplateColumns": "minmax(0, 1fr)",
                                    "alignItems": "center",
                                    "gap": "clamp(1.5rem, 4vw, 3rem)",
                                    "width": "100%",
                                    "maxWidth": "960px",
                                    "padding": "clamp(2rem, 5vw, 3.5rem)",
                                    "backgroundColor": "var(--scm-ivory, #F4F0E6)",
                                    "borderRadius": "var(--scm-radius, 8px)",
                                    "border": "1px solid var(--scm-line, #E4DCCE)",
                                    "textAlign": "center"
                                },
                                "children": [
                                    {
                                        "id": "home_final_cta_rule",
                                        "type": "basic",
                                        "name": "Span",
                                        "style": {
                                            "display": "block",
                                            "width": "48px",
                                            "height": "1px",
                                            "backgroundColor": "var(--scm-wood, #C9B08D)",
                                            "marginInline": "auto"
                                        }
                                    },
                                    {
                                        "id": "home_final_cta_eyebrow",
                                        "type": "basic",
                                        "name": "Span",
                                        "style": {
                                            "fontFamily": "var(--scm-font-body, system-ui)",
                                            "fontSize": "0.75rem",
                                            "color": "var(--scm-wood-dark, #A8916F)",
                                            "letterSpacing": "0.18em",
                                            "textTransform": "uppercase",
                                            "fontWeight": 600,
                                            "display": "block"
                                        },
                                        "text": "$t:superbify.home.final_cta.eyebrow"
                                    },
                                    {
                                        "id": "home_final_cta_heading",
                                        "type": "basic",
                                        "name": "H2",
                                        "style": {
                                            "fontFamily": "var(--scm-font-display, system-ui)",
                                            "fontSize": "clamp(1.5rem, 3vw, 2.25rem)",
                                            "fontWeight": 600,
                                            "color": "var(--scm-text-primary, #26221E)",
                                            "margin": 0,
                                            "letterSpacing": "-0.015em",
                                            "lineHeight": 1.2
                                        },
                                        "text": "$t:superbify.home.final_cta.heading"
                                    },
                                    {
                                        "id": "home_final_cta_body",
                                        "type": "basic",
                                        "name": "P",
                                        "style": {
                                            "fontFamily": "var(--scm-font-body, system-ui)",
                                            "fontSize": "1rem",
                                            "color": "var(--scm-text-body, #4A4643)",
                                            "lineHeight": 1.75,
                                            "margin": 0,
                                            "maxWidth": "44ch",
                                            "marginInline": "auto"
                                        },
                                        "text": "$t:superbify.home.final_cta.body"
                                    },
                                    {
                                        "id": "home_final_cta_action",
                                        "type": "basic",
                                        "name": "A",
                                        "style": {
                                            "display": "inline-flex",
                                            "alignItems": "center",
                                            "justifyContent": "center",
                                            "minHeight": "52px",
                                            "padding": "0 2rem",
                                            "borderRadius": "var(--scm-radius, 4px)",
                                            "backgroundColor": "var(--scm-charcoal, #26221E)",
                                            "color": "var(--scm-text-inverse, #FAF8F3)",
                                            "textDecoration": "none",
                                            "fontFamily": "var(--scm-font-body, system-ui)",
                                            "fontSize": "1rem",
                                            "fontWeight": 600,
                                            "letterSpacing": "0.02em",
                                            "marginTop": "var(--scm-spacing-sm, 0.75rem)",
                                            "boxShadow": "0 6px 18px -10px rgba(38, 34, 30, 0.45)"
                                        },
                                        "href": "/shop",
                                        "text": "$t:superbify.home.final_cta.cta"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}

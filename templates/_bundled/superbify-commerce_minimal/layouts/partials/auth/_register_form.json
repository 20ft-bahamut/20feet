                    }
                },
                {
                    "type": "basic",
                    "name": "Span",
                    "if": "{{_local.errors?.name}}",
                    "style": {
                        "fontSize": "0.8125rem",
                        "color": "var(--scm-danger, #B3261E)"
                    },
                    "text": "{{_local.errors?.name?.[0] ?? ''}}"
                }
            ]
        },
        {
            "comment": "닉네임 필드 (선택)",
            "type": "basic",
            "name": "Div",
            "id": "auth_register_nickname_field",
            "style": {
                "display": "flex",
                "flexDirection": "column",
                "gap": "0.375rem"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                        "htmlFor": "auth_register_nickname"
                    },
                    "style": {
                        "fontSize": "0.8125rem",
                        "fontWeight": 600,
                        "color": "var(--scm-text-primary, #26221E)"
                    },
                    "text": "$t:superbify.auth.register.nickname"
                },
                {
                    "type": "basic",
                    "name": "Input",
                    "id": "auth_register_nickname",
                    "props": {
                        "type": "text",
                        "name": "nickname",
                        "placeholder": "$t:superbify.auth.register.nickname_placeholder",
                        "disabled": "{{_local?.isRegistering}}"
                    },
                    "style": {
                        "minHeight": "44px",
                        "padding": "0.625rem 0.75rem",

                        "color": "var(--scm-danger, #B3261E)"
                    },
                    "text": "{{_local.errors?.nickname?.[0] ?? ''}}"
                }
            ]
        },
        {
            "id": "register_extension_fields",
            "comment": "확장 주입 앵커 — 모듈이 layout_extensions 로 가입폼 추가 필드를 주입한다. 미설치 시 빈 슬롯(렌더 영향 없음). BASIC 동일 유지.",
            "type": "basic",
            "name": "Div"
        },
        {
            "comment": "약관 동의 — BASIC 약관/개인정보 모달 대신 스토어 정책 페이지 링크(/shop/terms · /shop/privacy)",
            "type": "basic",
            "name": "Div",
            "id": "auth_register_agreements",
            "style": {
                "display": "flex",
                "flexDirection": "column",
                "gap": "0.25rem",
                "paddingTop": "var(--scm-spacing-2xs, 0.5rem)"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "id": "auth_register_agree_terms_row",
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "style": {
                                "display": "flex",
                                "alignItems": "center",
                                "gap": "0.5rem",
                                "minHeight": "44px"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Input",
                                    "id": "auth_register_agree_terms",
                                    "props": {
                                        "type": "checkbox",
                                        "name": "agree_terms",
                                        "value": "1",
                                        "required": true,
                                        "disabled": "{{_local?.isRegistering}}"
                                    },
                                    "style": {
                                        "width": "18px",
                                        "height": "18px",
                                        "accentColor": "var(--scm-charcoal, #26221E)",
                                        "cursor": "pointer"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Label",
                                    "style": {
                                        "fontSize": "0.875rem",
                                        "color": "var(--scm-text-primary, #26221E)",
                                        "cursor": "pointer"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "text": "$t:superbify.auth.register.terms_agree"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "A",
                                    "id": "auth_register_terms_link",
                                    "props": {
                                        "href": "{{_global.shopBase ?? '/shop'}}/terms",
                                        "target": "_blank",
                                        "rel": "noopener"
                                    },
                                    "style": {
                                        "fontSize": "0.8125rem",
                                        "color": "var(--scm-text-muted, #8A837B)",
                                        "textDecoration": "underline",
                                        "textUnderlineOffset": "3px",
                                        "cursor": "pointer"
                                    },
                                    "text": "$t:superbify.auth.register.terms_link"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "if": "{{_local.errors?.agree_terms}}",
                            "style": {
                                "fontSize": "0.8125rem",
                                "color": "var(--scm-danger, #B3261E)",
                                "paddingLeft": "1.625rem"
                            },
                            "text": "{{_local.errors?.agree_terms?.[0] ?? ''}}"
                        }
                    ]
                },
                {
                    "id": "register_privacy_agreement",
                    "type": "basic",
                    "name": "Div",
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "style": {
                                "display": "flex",
                                "alignItems": "center",
                                "gap": "0.5rem",
                                "minHeight": "44px"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Input",
                                    "id": "auth_register_agree_privacy",
                                    "props": {
                                        "type": "checkbox",
                                        "name": "agree_privacy",
                                        "value": "1",
                                        "required": true,
                                        "disabled": "{{_local?.isRegistering}}"
                                    },
                                    "style": {
                                        "width": "18px",
                                        "height": "18px",
                                        "accentColor": "var(--scm-charcoal, #26221E)",
                                        "cursor": "pointer"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Label",
                                    "style": {
                                        "fontSize": "0.875rem",
                                        "color": "var(--scm-text-primary, #26221E)",
                                        "cursor": "pointer"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "text": "$t:superbify.auth.register.privacy_agree"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "A",
                                    "id": "auth_register_privacy_link",
                                    "props": {
                                        "href": "{{_global.shopBase ?? '/shop'}}/privacy",
                                        "target": "_blank",
                                        "rel": "noopener"
                                    },
                                    "style": {
                                        "fontSize": "0.8125rem",
                                        "color": "var(--scm-text-muted, #8A837B)",
                                        "textDecoration": "underline",
                                        "textUnderlineOffset": "3px",
                                        "cursor": "pointer"
                                    },
                                    "text": "$t:superbify.auth.register.privacy_link"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Span",

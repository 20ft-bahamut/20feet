                            "text": "{{_local.errors?.agree_privacy?.[0] ?? ''}}"
                        }
                    ]
                }
            ]
        },
        {
            "comment": "제출 버튼 — BASIC animate-spin 스피너는 template CSS 에 @keyframes 가 없어 텍스트 전환으로 대체",
            "type": "basic",
            "name": "Button",
            "id": "auth_register_submit",
            "props": {
                "type": "submit",
                "disabled": "{{_local?.isRegistering}}"
            },
            "style": {
                "minHeight": "44px",
                "padding": "0.75rem 1rem",
                "backgroundColor": "var(--scm-charcoal, #26221E)",
                "color": "var(--scm-text-inverse, #FAF8F3)",
                "border": "1px solid var(--scm-charcoal, #26221E)",
                "borderRadius": "var(--scm-radius, 8px)",
                "fontWeight": 600,
                "cursor": "pointer",
                "fontFamily": "var(--scm-font-body, system-ui)",
                "fontSize": "0.9375rem",
                "marginTop": "var(--scm-spacing-sm, 0.75rem)",
                "display": "inline-flex",
                "alignItems": "center",
                "justifyContent": "center",
                "gap": "0.5rem"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Span",
                    "if": "{{!_local?.isRegistering}}",
                    "text": "$t:superbify.auth.register.submit"
                },
                {
                    "type": "basic",
                    "name": "Span",
                    "if": "{{_local?.isRegistering}}",
                    "text": "$t:superbify.auth.register.processing"
                }
            ]
        }
    ],
    "actions": [
        {
            "comment": "BASIC 등록 체인 유지 — 응답에 token 이 있으면 AuthManager 가 자동 로그인 처리한다",
            "type": "submit",
            "handler": "sequence",
            "actions": [
                {
                    "handler": "setState",
                    "params": {
                        "target": "local",
                        "isRegistering": true,
                        "registerError": null,
                        "errors": null
                    }
                },
                {
                    "handler": "apiCall",
                    "target": "/api/auth/register",
                    "params": {
                        "method": "POST",
                        "body": "{{Object.assign({}, _local.registerForm, query.verification_token ? { verification_token: query.verification_token } : {})}}"
                    },
                    "onSuccess": [
                        {
                            "handler": "toast",
                            "params": {
                                "type": "success",
                                "message": "$t:superbify.auth.register_success"
                            }
                        },
                        {
                            "comment": "로그인 화면으로 안내 — BASIC 과 동일(레이아웃 apiCall 은 토큰을 저장하지 않으므로 회원가입 후 명시적으로 로그인한다)",
                            "handler": "navigate",
                            "params": {
                                "path": "/login"
                            }
                        }
                    ],
                    "onError": [
                        {
                            "handler": "setState",
                            "params": {
                                "target": "local",
                                "isRegistering": false,
                                "errors": "{{error.response?.errors ?? error.errors}}",
                                "registerError": "{{error.response?.message ?? error.message}}"
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
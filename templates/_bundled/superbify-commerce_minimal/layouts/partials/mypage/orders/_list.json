{
    "meta": {
        "is_partial": true,
        "description": "마이페이지 주문내역 탭 — 주문 카드 목록 + EmptyState + SRC Pagination",
        "fork_source": "templates/_bundled/sirsoft-basic/layouts/partials/mypage/orders/_list.json — BASIC 통계 원형/상태 셀렉트/mc 통화 라인/Icon/classMap 을 제외하고 날짜·대표 상품 1건·총액·상태·상세 링크 카드로 축약. Pagination 은 SRC Pagination(currentPage/totalPages props, onPageChange → setState ordersPage + refetchDataSource orders)."
    },
    "id": "mypage_orders_list",
    "type": "basic",
    "name": "Div",
    "style": {
        "display": "flex",
        "flexDirection": "column",
        "gap": "var(--scm-spacing-sm, 0.75rem)",
        "marginTop": "var(--scm-spacing-sm, 0.75rem)"
    },
    "children": [
        {
            "comment": "주문 카드 목록",
            "id": "mypage_orders_rows",
            "type": "basic",
            "name": "Div",
            "if": "{{orders?.data?.data && orders.data.data.length > 0}}",
            "style": {
                "display": "flex",
                "flexDirection": "column",
                "gap": "var(--scm-spacing-sm, 0.75rem)"
            },
            "children": [
                {
                    "comment": "주문 카드 1건",
                    "id": "mypage_orders_row",
                    "type": "basic",
                    "name": "Div",
                    "iteration": { "source": "{{orders?.data?.data ?? []}}", "item_var": "order" },
                    "className": "scm-panel",
                    "style": {
                        "display": "flex",
                        "flexDirection": "column",
                        "gap": "var(--scm-spacing-sm, 0.75rem)"
                    },
                    "children": [
                        {
                            "comment": "카드 헤더 — 날짜+주문번호 / 상태",
                            "id": "mypage_orders_row_header",
                            "type": "basic",
                            "name": "Div",
                            "style": {
                                "display": "flex",
                                "alignItems": "flex-start",
                                "justifyContent": "space-between",
                                "gap": "var(--scm-spacing-sm, 0.75rem)"
                            },
                            "children": [
                                {
                                    "id": "mypage_orders_row_issued",
                                    "type": "basic",
                                    "name": "Div",
                                    "style": {
                                        "display": "flex",
                                        "flexDirection": "column",
                                        "gap": "var(--scm-spacing-3xs, 0.125rem)",
                                        "minWidth": "0"
                                    },
                                    "children": [
                                        {
                                            "id": "mypage_orders_row_date",
                                            "type": "basic",
                                            "name": "Span",
                                            "style": {
                                                "fontFamily": "var(--scm-font-body, system-ui)",
                                                "fontSize": "0.8125rem",
                                                "color": "var(--scm-text-muted, #8A837B)",
                                                "fontVariantNumeric": "tabular-nums"
                                            },
                                            "text": "{{order.ordered_at_formatted ?? ''}}"
                                        },
                                        {
                                            "id": "mypage_orders_row_number",
                                            "type": "basic",
                                            "name": "Span",
                                            "style": {
                                                "fontFamily": "var(--scm-font-body, system-ui)",
                                                "fontSize": "0.9375rem",
                                                "fontWeight": 600,
                                                "color": "var(--scm-text-primary, #26221E)",
                                                "fontVariantNumeric": "tabular-nums"
                                            },
                                            "text": "{{order.order_number ?? ''}}"
                                        }
                                    ]
                                },
                                {
                                    "id": "mypage_orders_row_status",
                                    "type": "basic",
                                    "name": "Span",
                                    "style": {
                                        "display": "inline-flex",
                                        "alignItems": "center",
                                        "padding": "var(--scm-spacing-2xs, 0.25rem) var(--scm-spacing-xs, 0.5rem)",
                                        "borderRadius": "var(--scm-radius-pill, 9999px)",
                                        "border": "1px solid var(--scm-line, #E4DCCE)",
                                        "backgroundColor": "var(--scm-bg-secondary, #F4F0E6)",
                                        "fontFamily": "var(--scm-font-body, system-ui)",
                                        "fontSize": "0.75rem",
                                        "fontWeight": 600,
                                        "whiteSpace": "nowrap",
                                        "color": "{{(order.status_variant ?? '') === 'success' ? 'var(--scm-charcoal, #26221E)' : (order.status_variant ?? '') === 'danger' ? 'var(--scm-danger, #B3261E)' : (order.status_variant ?? '') === 'warning' ? 'var(--scm-wood-dark, #A8916F)' : 'var(--scm-accent, #2E3A48)'}}"
                                    },
                                    "text": "{{order.status_label ?? ''}}"
                                }
                            ]
                        },
                        {
                            "comment": "대표 상품 1건 — with_items=1 이면 전체가 오지만 카드에서는 첫 상품만 요약한다",
                            "id": "mypage_orders_row_items",
                            "if": "{{(order.items?.length ?? 0) > 0}}",
                            "type": "basic",
                            "name": "Div",
                            "style": {
                                "display": "flex",
                                "alignItems": "center",
                                "gap": "var(--scm-spacing-sm, 0.75rem)"
                            },
                            "children": [
                                {
                                    "comment": "대표 상품 썸네일",
                                    "id": "mypage_orders_row_thumb",
                                    "type": "basic",
                                    "name": "Div",
                                    "style": {
                                        "width": "56px",
                                        "height": "56px",
                                        "flex": "0 0 auto",
                                        "borderRadius": "var(--scm-radius, 8px)",
                                        "border": "1px solid var(--scm-line, #E4DCCE)",
                                        "overflow": "hidden",
                                        "backgroundColor": "var(--scm-bg-secondary, #F4F0E6)"
                                    },
                                    "children": [
                                        {
                                            "comment": "defensive bind — thumbnail_url 가 문자열일 때만 렌더",
                                            "id": "mypage_orders_row_thumb_img",
                                            "type": "basic",
                                            "name": "Img",
                                            "if": "{{typeof (order.items ?? [])[0]?.thumbnail_url === 'string'}}",
                                            "props": {
                                                "src": "{{(order.items ?? [])[0]?.thumbnail_url ?? ''}}",
                                                "alt": "{{$localized((order.items ?? [])[0]?.product_name) ?? ''}}"
                                            },
                                            "style": {
                                                "width": "100%",
                                                "height": "100%",
                                                "objectFit": "cover",
                                                "display": "block"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "id": "mypage_orders_row_item_info",
                                    "type": "basic",
                                    "name": "Div",
                                    "style": {
                                        "display": "flex",
                                        "flexDirection": "column",
                                        "gap": "var(--scm-spacing-3xs, 0.125rem)",
                                        "minWidth": "0"
                                    },
                                    "children": [
                                        {
                                            "id": "mypage_orders_row_item_name",
                                            "type": "basic",
                                            "name": "P",
                                            "style": {
                                                "fontFamily": "var(--scm-font-body, system-ui)",
                                                "fontSize": "0.9375rem",
                                                "fontWeight": 500,
                                                "color": "var(--scm-text-primary, #26221E)",
                                                "margin": 0,
                                                "overflow": "hidden",
                                                "textOverflow": "ellipsis",
                                                "whiteSpace": "nowrap"
                                            },
                                            "text": "{{$localized((order.items ?? [])[0]?.product_name) ?? ''}}"
                                        },
                                        {
                                            "id": "mypage_orders_row_item_qty",
                                            "type": "basic",
                                            "name": "P",
                                            "style": {
                                                "fontFamily": "var(--scm-font-body, system-ui)",
                                                "fontSize": "0.8125rem",
                                                "color": "var(--scm-text-muted, #8A837B)",
                                                "margin": 0
                                            },
                                            "text": "{{(order.items ?? [])[0]?.quantity ?? 1}}{{((order.items?.length ?? 0) > 1) ? ' + ' + ((order.items?.length ?? 0) - 1) : ''}}"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "comment": "카드 푸터 — 결제금액 / 상세 보기",
                            "id": "mypage_orders_row_footer",
                            "type": "basic",
                            "name": "Div",
                            "style": {
                                "display": "flex",
                                "alignItems": "center",
                                "justifyContent": "space-between",
                                "gap": "var(--scm-spacing-sm, 0.75rem)",
                                "borderTop": "1px solid var(--scm-line, #E4DCCE)",
                                "paddingTop": "var(--scm-spacing-sm, 0.75rem)"
                            },
                            "children": [
                                {
                                    "id": "mypage_orders_row_total",
                                    "type": "basic",
                                    "name": "Span",
                                    "style": {
                                        "fontFamily": "var(--scm-font-body, system-ui)",
                                        "fontSize": "1rem",
                                        "fontWeight": 700,
                                        "color": "var(--scm-text-primary, #26221E)",
                                        "fontVariantNumeric": "tabular-nums"
                                    },
                                    "text": "{{order.total_amount_formatted ?? ''}}"
                                },
                                {
                                    "id": "mypage_orders_row_detail_link",
                                    "type": "basic",
                                    "name": "Button",
                                    "props": { "type": "button" },
                                    "style": {
                                        "display": "inline-flex",
                                        "alignItems": "center",
                                        "justifyContent": "center",
                                        "minHeight": "var(--scm-touch-min, 44px)",
                                        "padding": "0 var(--scm-spacing-md, 1rem)",
                                        "backgroundColor": "transparent",
                                        "border": "1px solid var(--scm-border-strong, #26221E)",
                                        "borderRadius": "var(--scm-radius, 8px)",
                                        "color": "var(--scm-text-primary, #26221E)",
                                        "fontFamily": "var(--scm-font-body, system-ui)",
                                        "fontSize": "0.875rem",
                                        "fontWeight": 600,
                                        "cursor": "pointer"
                                    },
                                    "actions": [
                                        {
                                            "comment": "audit:allow layout-list-context-navigate-merge-query 주문 상세 이동 — 목록 행이 가진 주문번호로 탐색한다. query 를 물려주지 않는다(태그 클러스터가 다른 이동).",
                                            "type": "click",
                                            "handler": "navigate",
                                            "params": { "path": "/mypage/orders/{{order.order_number ?? ''}}" }
                                        }
                                    ],
                                    "text": "$t:superbify.mypage.orders.detail"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "comment": "주문 없음 — SRC EmptyState 컴포지트",
            "id": "mypage_orders_empty",
            "type": "composite",
            "name": "EmptyState",
            "if": "{{orders !== undefined && (orders?.data?.data?.length ?? 0) === 0}}",
            "props": {
                "title": "$t:superbify.mypage.orders.empty",
                "ctaLabel": "$t:superbify.cart.cta_shop",
                "ctaHref": "/shop"
            }
        },
        {
            "comment": "페이지네이션 — SRC Pagination 은 currentPage/totalPages 를 받고 last_page <= 1 이면 렌더하지 않는다",
            "id": "mypage_orders_pagination",
            "type": "composite",
            "name": "Pagination",
            "props": {
                "currentPage": "{{Number(orders?.data?.pagination?.current_page ?? 1)}}",
                "totalPages": "{{Number(orders?.data?.pagination?.last_page ?? 1)}}",
                "prevLabel": "$t:superbify.notice.prev_page_aria",
                "nextLabel": "$t:superbify.notice.next_page_aria",
                "pageLabel": "$t:superbify.notice.page_aria"
            },
            "actions": [
                {
                    "event": "onPageChange",
                    "handler": "sequence",
                    "actions": [
                        {
                            "handler": "setState",
                            "params": { "target": "local", "ordersPage": "{{$args[0]}}" }
                        },
                        {
                            "handler": "refetchDataSource",
                            "params": { "dataSourceId": "orders" }
                        }
                    ]
                }
            ]
        }
    ]
}
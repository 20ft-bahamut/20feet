                },
                {
                    "comment": "국내 주소 — 우편번호(readOnly + daum 검색) + 기본 주소(readOnly)",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{(_local.editingAddress?.country_code ?? 'KR') === 'KR'}}",
                    "style": { "display": "flex", "flexDirection": "column", "gap": "var(--scm-spacing-2xs, 0.25rem)" },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Label",
                            "style": { "fontSize": "0.8125rem", "fontWeight": "500", "color": "var(--scm-text-muted, #8A837B)" },

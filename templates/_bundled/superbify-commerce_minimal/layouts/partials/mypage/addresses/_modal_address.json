                                "backgroundColor": "var(--scm-bg-primary, #FAF8F3)",
                                "color": "var(--scm-text-primary, #26221E)",
                                "fontFamily": "var(--scm-font-body, system-ui)",
                                "fontSize": "0.9375rem"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Input",
                            "props": { "type": "text", "name": "address_line_2", "value": "{{_local.editingAddress?.address_line_2 ?? ''}}" },
                            "style": {
                                "width": "100%",
                                "minHeight": "44px",
                                "padding": "0 var(--scm-spacing-sm, 0.75rem)",
                                "border": "var(--scm-hairline, 1px solid #E4DCCE)",
                                "borderRadius": "var(--scm-radius-sm, 4px)",
                                "backgroundColor": "var(--scm-bg-primary, #FAF8F3)",
                                "color": "var(--scm-text-primary, #26221E)",
                                "fontFamily": "var(--scm-font-body, system-ui)",
                                "fontSize": "0.9375rem"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Input",
                            "props": { "type": "text", "name": "intl_city", "value": "{{_local.editingAddress?.intl_city ?? ''}}" },
                            "style": {
                                "width": "100%",
                                "minHeight": "44px",
                                "padding": "0 var(--scm-spacing-sm, 0.75rem)",
                                "border": "var(--scm-hairline, 1px solid #E4DCCE)",
                                "borderRadius": "var(--scm-radius-sm, 4px)",
                                "backgroundColor": "var(--scm-bg-primary, #FAF8F3)",
                                "color": "var(--scm-text-primary, #26221E)",
                                "fontFamily": "var(--scm-font-body, system-ui)",
                                "fontSize": "0.9375rem"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Input",
                            "props": { "type": "text", "name": "intl_state", "value": "{{_local.editingAddress?.intl_state ?? ''}}" },
                            "style": {
                                "width": "100%",
                                "minHeight": "44px",
                                "padding": "0 var(--scm-spacing-sm, 0.75rem)",
                                "border": "var(--scm-hairline, 1px solid #E4DCCE)",
                                "borderRadius": "var(--scm-radius-sm, 4px)",
                                "backgroundColor": "var(--scm-bg-primary, #FAF8F3)",
                                "color": "var(--scm-text-primary, #26221E)",
                                "fontFamily": "var(--scm-font-body, system-ui)",
                                "fontSize": "0.9375rem"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Input",
                            "props": { "type": "text", "name": "intl_postal_code", "value": "{{_local.editingAddress?.intl_postal_code ?? ''}}" },
                            "style": {
                                "width": "100%",
                                "minHeight": "44px",
                                "padding": "0 var(--scm-spacing-sm, 0.75rem)",
                                "border": "var(--scm-hairline, 1px solid #E4DCCE)",
                                "borderRadius": "var(--scm-radius-sm, 4px)",
                                "backgroundColor": "var(--scm-bg-primary, #FAF8F3)",
                                "color": "var(--scm-text-primary, #26221E)",
                                "fontFamily": "var(--scm-font-body, system-ui)",
                                "fontSize": "0.9375rem"

                            }
                        },
                        {
                            "type": "basic",
                            "name": "Input",
                            "props": {
                                "type": "text",
                                "name": "address_detail",
                                "value": "{{_local.editingAddress?.address_detail ?? ''}}",
                                "placeholder": "$t:superbify.mypage.addresses.address_detail"
                            },
                            "style": {
                                "width": "100%",
                                "minHeight": "44px",
                                "padding": "0 var(--scm-spacing-sm, 0.75rem)",
                                "border": "var(--scm-hairline, 1px solid #E4DCCE)",
                                "borderRadius": "var(--scm-radius-sm, 4px)",
                                "backgroundColor": "var(--scm-bg-primary, #FAF8F3)",
                                "color": "var(--scm-text-primary, #26221E)",
                                "fontFamily": "var(--scm-font-body, system-ui)",
                                "fontSize": "0.9375rem"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "if": "{{_local.addressErrors?.zipcode || _local.addressErrors?.address}}",
                            "style": { "fontSize": "0.75rem", "color": "var(--scm-danger, #B3261E)" },
                            "text": "{{_local.addressErrors?.zipcode?.[0] ?? _local.addressErrors?.address?.[0] ?? ''}}"
                        }
                    ]
                },
                {
                    "comment": "해외 주소 — KR 외 country_code 로 편집 진입 시(BASIC address_line_1/2 + intl_* 필드 매핑 유지, 국가 Select 컴포지트는 SRC 미등록이라 제외)",
                    "type": "basic",

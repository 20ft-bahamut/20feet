                        }
                    ]
                },
                {
                    "comment": "기본 배송지로 설정 — Checkbox → Input type checkbox 치환",
                    "type": "basic",
                    "name": "Div",
                    "style": {
                        "display": "flex",
                        "alignItems": "center",
                        "gap": "var(--scm-spacing-2xs, 0.25rem)"
                    },
                    "children": [
                        {
                            "id": "address_is_default",
                            "type": "basic",
                            "name": "Input",
                            "props": {
                                "type": "checkbox",
                                "name": "is_default",
                                "checked": "{{_local.editingAddress?.is_default === true}}",
                                "aria-label": "$t:superbify.mypage.addresses.set_default"
                            },
                            "style": {
                                "width": "20px",
                                "height": "20px",
                                "minHeight": "20px",
                                "padding": "0",
                                "accentColor": "var(--scm-charcoal, #26221E)",
                                "cursor": "pointer"
                            },
                            "actions": [
                                {
                                    "type": "change",
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "editingAddress.is_default": "{{$event.target.checked}}"
                                    }
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": { "for": "address_is_default" },
                            "style": {
                                "fontSize": "0.875rem",
                                "color": "var(--scm-text-body, #4A4643)",
                                "cursor": "pointer",
                                "minHeight": "44px",
                                "display": "inline-flex",
                                "alignItems": "center"
                            },
                            "text": "$t:superbify.mypage.addresses.set_default"
                        }
                    ]
                }
            ]
        },
        {
            "comment": "저장/취소 — BASIC 저장 시퀀스 setState → apiCall(POST|PUT user/addresses) → 409 overwrite → refetch/toast 유지, closeModal 대신 editingAddress 클리어",
            "type": "basic",
            "name": "Div",
            "style": {
                "display": "flex",
                "justifyContent": "flex-end",
                "gap": "var(--scm-spacing-xs, 0.5rem)",
                "flexWrap": "wrap",
                "paddingTop": "var(--scm-spacing-xs, 0.5rem)",
                "borderTop": "var(--scm-hairline, 1px solid #E4DCCE)"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Button",
                    "props": { "type": "button" },
                    "style": {
                        "minHeight": "44px",
                        "padding": "0 var(--scm-spacing-md, 1rem)",
                        "backgroundColor": "var(--scm-bg-secondary, #F4F0E6)",
                        "color": "var(--scm-text-primary, #26221E)",
                        "border": "var(--scm-hairline, 1px solid #E4DCCE)",
                        "borderRadius": "var(--scm-radius-sm, 4px)",
                        "fontFamily": "var(--scm-font-body, system-ui)",
                        "fontSize": "0.875rem",
                        "fontWeight": "600",
                        "cursor": "pointer"
                    },
                    "text": "$t:superbify.mypage.cancel",
                    "actions": [
                        {
                            "type": "click",
                            "handler": "setState",
                            "params": { "target": "local", "editingAddress": null, "addressErrors": null }
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Button",
                    "props": {
                        "type": "button",
                        "disabled": "{{_local.isSaving ?? false}}",
                        "data-testid": "address-save"
                    },
                    "style": {
                        "minHeight": "44px",
                        "padding": "0 var(--scm-spacing-md, 1rem)",
                        "backgroundColor": "var(--scm-charcoal, #26221E)",
                        "color": "var(--scm-text-inverse, #FAF8F3)",
                        "border": "1px solid var(--scm-charcoal, #26221E)",
                        "borderRadius": "var(--scm-radius-sm, 4px)",
                        "fontFamily": "var(--scm-font-body, system-ui)",
                        "fontSize": "0.875rem",
                        "fontWeight": "600",
                        "cursor": "pointer"
                    },
                    "text": "$t:superbify.mypage.addresses.save",
                    "actions": [
                        {
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": { "target": "local", "isSaving": true, "addressErrors": null }
                                },
                                {
                                    "handler": "apiCall",
                                    "auth_required": true,
                                    "target": "{{_local.editingAddress?.id ? '/api/modules/sirsoft-ecommerce/user/addresses/' + _local.editingAddress.id : '/api/modules/sirsoft-ecommerce/user/addresses'}}",
                                    "params": {
                                        "method": "{{_local.editingAddress?.id ? 'PUT' : 'POST'}}",
                                        "body": "{{_local.editingAddress}}"
                                    },
                                    "onSuccess": [
                                        { "handler": "refetchDataSource", "params": { "dataSourceId": "addresses" } },
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "isSaving": false,
                                                "addressErrors": null,
                                                "editingAddress": null
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": { "type": "success", "message": "$t:superbify.mypage.addresses.saved" }
                                        }
                                    ],
                                    "onError": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "isSaving": false,
                                                "addressErrors": "{{error.errors ?? {}}}"
                                            }
                                        },
                                        {
                                            "comment": "409 = 배송지명 중복 → 덮어쓰기 확인(SRC ConfirmDialog)",
                                            "if": "{{error.status === 409}}",
                                            "handler": "setState",
                                            "params": { "target": "local", "confirmOverwrite": true }
                                        },
                                        {
                                            "if": "{{error.status !== 409}}",
                                            "handler": "toast",
                                            "params": { "type": "error", "message": "{{error.message}}" }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
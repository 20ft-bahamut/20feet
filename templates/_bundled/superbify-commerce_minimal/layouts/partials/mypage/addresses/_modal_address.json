                            "name": "Div",
                            "style": {
                                "display": "flex",
                                "gap": "var(--scm-spacing-xs, 0.5rem)",
                                "alignItems": "center"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Input",
                                    "props": {
                                        "type": "text",
                                        "name": "zipcode",
                                        "value": "{{_local.editingAddress?.zipcode ?? ''}}",
                                        "readOnly": true
                                    },
                                    "style": {
                                        "width": "8rem",
                                        "flex": "0 0 auto",
                                        "minHeight": "44px",
                                        "padding": "0 var(--scm-spacing-sm, 0.75rem)",
                                        "border": "var(--scm-hairline, 1px solid #E4DCCE)",
                                        "borderRadius": "var(--scm-radius-sm, 4px)",
                                        "backgroundColor": "var(--scm-bg-secondary, #F4F0E6)",
                                        "color": "var(--scm-text-body, #4A4643)",
                                        "fontFamily": "var(--scm-font-body, system-ui)",
                                        "fontSize": "0.9375rem"
                                    }
                                },
                                {
                                    "comment": "sirsoft-daum_postcode 확장 — onAddressSelect($event.*) 는 editingAddress.zipcode/address/region/city 에 기입하고, 미지원 엔진용 targetFields 도 함께 전달한다. readOnly 필드는 extension 이 onMount setFieldReadOnly 로 잠근다.",
                                    "id": "modal_address_search_slot",
                                    "type": "extension_point",
                                    "name": "address_search_slot",
                                    "props": {
                                        "readOnlyFields": ["zipcode", "address"],
                                        "targetFields": {
                                            "zipcode": "_local.editingAddress.zipcode",
                                            "address": "_local.editingAddress.address",
                                            "region": "_local.editingAddress.region",
                                            "city": "_local.editingAddress.city"
                                        },
                                        "onAddressSelect": {
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "editingAddress.zipcode": "{{$event.zipcode}}",
                                                "editingAddress.address": "{{$event.address}}",
                                                "editingAddress.region": "{{$event.region}}",
                                                "editingAddress.city": "{{$event.city}}"
                                            }
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Input",
                            "props": {
                                "type": "text",
                                "name": "address",
                                "value": "{{_local.editingAddress?.address ?? ''}}",
                                "readOnly": true
                            },
                            "style": {
                                "width": "100%",
                                "minHeight": "44px",
                                "padding": "0 var(--scm-spacing-sm, 0.75rem)",
                                "border": "var(--scm-hairline, 1px solid #E4DCCE)",
                                "borderRadius": "var(--scm-radius-sm, 4px)",
                                "backgroundColor": "var(--scm-bg-secondary, #F4F0E6)",
                                "color": "var(--scm-text-body, #4A4643)",
                                "fontFamily": "var(--scm-font-body, system-ui)",

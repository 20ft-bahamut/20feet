{
    "meta": {
        "is_partial": true,
        "description": "프로필 수정 전 비밀번호 확인 섹션 (BASIC 2-step flow — /api/me/verify-password POST 성공 시 isPasswordVerified=true). PasswordInput/Icon 을 Input type=password + scm 토큰으로 치환하고 BASIC action chain(verify-password POST + state 세팅)을 그대로 유지했다.",
        "fork_source": "templates/_bundled/sirsoft-basic/layouts/partials/mypage/profile/_password_verify_section.json"
    },
    "type": "basic",
    "name": "Div",
    "if": "{{!_local?.isPasswordVerified}}",
    "props": { "className": "scm-panel" },
    "style": {
        "maxWidth": "26rem",
        "marginInline": "auto",
        "display": "flex",
        "flexDirection": "column",
        "gap": "var(--scm-spacing-md, 1rem)"
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "style": {
                "display": "flex",
                "flexDirection": "column",
                "gap": "var(--scm-spacing-2xs, 0.25rem)",
                "textAlign": "center"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "H2",
                    "style": {
                        "fontFamily": "var(--scm-font-display, system-ui)",
                        "fontSize": "1.125rem",
                        "fontWeight": "600",
                        "color": "var(--scm-text-primary, #26221E)",
                        "margin": "0"
                    },
                    "text": "$t:superbify.mypage.profile.verify_title"
                },
                {
                    "type": "basic",
                    "name": "P",
                    "style": {
                        "fontSize": "0.875rem",
                        "color": "var(--scm-text-muted, #8A837B)",
                        "margin": "0"
                    },
                    "text": "$t:superbify.mypage.profile.verify_message"
                }
            ]
        },
        {
            "comment": "비밀번호 확인 폼 — BASIC verifyPasswordForm 시퀀스 유지",
            "type": "basic",
            "name": "Form",
            "props": { "id": "verifyPasswordForm" },
            "style": {
                "display": "flex",
                "flexDirection": "column",
                "gap": "var(--scm-spacing-md, 1rem)"
            },
            "actions": [
                {
                    "type": "submit",
                    "handler": "sequence",
                    "actions": [
                        {
                            "handler": "setState",
                            "params": {
                                "target": "local",
                                "isVerifyingPassword": true,
                                "verifyPasswordError": false
                            }
                        },
                        {
                            "handler": "apiCall",
                            "auth_required": true,
                            "target": "/api/me/verify-password",
                            "params": {
                                "method": "POST",
                                "body": { "password": "{{_local.verifyPassword}}" }
                            },
                            "onSuccess": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "isVerifyingPassword": false,
                                        "isPasswordVerified": true,
                                        "verifyPassword": ""
                                    }
                                }
                            ],
                            "onError": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "isVerifyingPassword": false,
                                        "verifyPasswordError": true
                                    }
                                }
                            ]
                        }
                    ]
                }
            ],
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "style": {
                        "display": "flex",
                        "flexDirection": "column",
                        "gap": "var(--scm-spacing-2xs, 0.25rem)"
                    },
                    "children": [
                        {
                            "comment": "PasswordInput → Input type=password 치환 (showToggle 미지원)",
                            "type": "basic",
                            "name": "Input",
                            "props": {
                                "type": "password",
                                "name": "password",
                                "value": "{{_local?.verifyPassword ?? ''}}",
                                "required": true,
                                "autocomplete": "current-password"
                            },
                            "style": {
                                "width": "100%",
                                "minHeight": "44px",
                                "padding": "0 var(--scm-spacing-sm, 0.75rem)",
                                "border": "var(--scm-hairline, 1px solid #E4DCCE)",
                                "borderRadius": "var(--scm-radius-sm, 4px)",
                                "backgroundColor": "var(--scm-bg-primary, #FAF8F3)",
                                "color": "var(--scm-text-primary, #26221E)",
                                "fontFamily": "var(--scm-font-body, system-ui)",
                                "fontSize": "0.9375rem"
                            },
                            "actions": [
                                {
                                    "type": "change",
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "verifyPassword": "{{$event.target.value}}"
                                    }
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "if": "{{_local?.verifyPasswordError}}",
                            "style": {
                                "fontSize": "0.8125rem",
                                "color": "var(--scm-danger, #B3261E)",
                                "margin": "0"
                            },
                            "text": "$t:superbify.mypage.profile.verify_error"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "style": {
                        "display": "flex",
                        "gap": "var(--scm-spacing-xs, 0.5rem)",
                        "flexWrap": "wrap"
                    },
                    "children": [
                        {
                            "comment": "취소 — BASIC /mypage/profile navigate 유지",
                            "type": "basic",
                            "name": "Button",
                            "props": { "type": "button" },
                            "style": {
                                "flex": "1 1 0",
                                "minHeight": "44px",
                                "backgroundColor": "var(--scm-bg-secondary, #F4F0E6)",
                                "color": "var(--scm-text-primary, #26221E)",
                                "border": "var(--scm-hairline, 1px solid #E4DCCE)",
                                "borderRadius": "var(--scm-radius-sm, 4px)",
                                "fontFamily": "var(--scm-font-body, system-ui)",
                                "fontSize": "0.875rem",
                                "fontWeight": "600",
                                "cursor": "pointer"
                            },
                            "text": "$t:superbify.mypage.cancel",
                            "actions": [
                                {
                                    "type": "click",
                                    "handler": "navigate",
                                    "params": { "path": "/mypage/profile" }
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Button",
                            "props": {
                                "type": "submit",
                                "form": "verifyPasswordForm",
                                "disabled": "{{_local.isVerifyingPassword || !_local.verifyPassword}}"
                            },
                            "style": {
                                "flex": "1 1 0",
                                "minHeight": "44px",
                                "backgroundColor": "var(--scm-charcoal, #26221E)",
                                "color": "var(--scm-text-inverse, #FAF8F3)",
                                "border": "1px solid var(--scm-charcoal, #26221E)",
                                "borderRadius": "var(--scm-radius-sm, 4px)",
                                "fontFamily": "var(--scm-font-body, system-ui)",
                                "fontSize": "0.875rem",
                                "fontWeight": "600",
                                "cursor": "pointer"
                            },
                            "text": "$t:superbify.mypage.profile.verify_submit"
                        }
                    ]
                }
            ]
        }
    ]
}
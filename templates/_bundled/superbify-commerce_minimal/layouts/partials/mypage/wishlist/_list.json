{
    "meta": {
        "is_partial": true,
        "description": "마이페이지 찜 목록 — BASIC wishlist/_list.json 포크. Grid layout 컴포지트는 scm grid Div로, BASIC Pagination은 SRC Pagination(다른 props: currentPage/totalPages/prevLabel/nextLabel/pageLabel + onPageChange)으로 치환했다. 찜 해제 action chain(DELETE wishlist/{id} → refetch + toast)은 그대로. ProductCard prop은 product → item 으로(SRC ProductCard 시그니처).",
        "fork_source": "templates/_bundled/sirsoft-basic/layouts/partials/mypage/wishlist/_list.json"
    },
    "type": "basic",
    "name": "Div",
    "style": {
        "display": "flex",
        "flexDirection": "column",
        "gap": "var(--scm-spacing-lg, 1.5rem)"
    },
    "children": [
        {
            "comment": "찜 카드 그리드",
            "type": "basic",
            "name": "Div",
            "if": "{{(wishlist?.data?.data ?? []).length > 0}}",
            "style": {
                "display": "grid",
                "gridTemplateColumns": "repeat(auto-fill, minmax(160px, 1fr))",
                "gap": "var(--scm-spacing-md, 1rem)"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "iteration": { "source": "{{wishlist?.data?.data ?? []}}", "item_var": "item", "index_var": "wishIdx" },
                    "style": {
                        "position": "relative",
                        "display": "flex",
                        "flexDirection": "column",
                        "gap": "var(--scm-spacing-2xs, 0.25rem)"
                    },
                    "children": [
                        {
                            "comment": "SRC ProductCard — prop 이름은 BASIC(product)과 달리 item 이다",
                            "type": "composite",
                            "name": "ProductCard",
                            "props": {
                                "item": "{{item.product ?? item}}"
                            }
                        },
                        {
                            "comment": "찜 해제 — BASIC DELETE wishlist/{item.id} onSuccess refetch + toast 체인 유지",
                            "id": "wishlist_remove_button",
                            "type": "basic",
                            "name": "Button",
                            "props": {
                                "type": "button",
                                "aria-label": "$t:superbify.mypage.wishlist.remove",
                                "data-testid": "wishlist-remove"
                            },
                            "style": {
                                "position": "absolute",
                                "top": "var(--scm-spacing-2xs, 0.25rem)",
                                "right": "var(--scm-spacing-2xs, 0.25rem)",
                                "zIndex": 10,
                                "width": "44px",
                                "height": "44px",
                                "display": "inline-flex",
                                "alignItems": "center",
                                "justifyContent": "center",
                                "backgroundColor": "var(--scm-bg-primary, #FAF8F3)",
                                "color": "var(--scm-danger, #B3261E)",
                                "border": "var(--scm-hairline, 1px solid #E4DCCE)",
                                "borderRadius": "var(--scm-radius-pill, 9999px)",
                                "fontFamily": "var(--scm-font-body, system-ui)",
                                "fontSize": "0.75rem",
                                "fontWeight": "600",
                                "cursor": "pointer"
                            },
                            "text": "×",
                            "actions": [
                                {
                                    "type": "click",
                                    "handler": "apiCall",
                                    "auth_required": true,
                                    "auth_mode": "required",
                                    "target": "/api/modules/sirsoft-ecommerce/wishlist/{{item.id}}",
                                    "params": { "method": "DELETE" },
                                    "onSuccess": [
                                        { "handler": "refetchDataSource", "params": { "dataSourceId": "wishlist" } },
                                        {
                                            "handler": "toast",
                                            "params": { "type": "success", "message": "$t:superbify.mypage.wishlist.removed" }
                                        }
                                    ],
                                    "onError": [
                                        {
                                            "handler": "toast",
                                            "params": { "type": "error", "message": "{{error.message}}" }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "comment": "빈 상태 — SRC EmptyState (BASIC go_shopping 버튼 대신 안내 문구)",
            "type": "composite",
            "name": "EmptyState",
            "if": "{{!(wishlist?.data?.data ?? []).length}}",
            "props": {
                "title": "$t:superbify.mypage.wishlist.title",
                "message": "$t:superbify.mypage.wishlist.empty"
            }
        },
        {
            "type": "basic",
            "name": "P",
            "if": "{{(wishlist?.data?.data ?? []).length > 0}}",
            "style": {
                "margin": "0",
                "fontSize": "0.8125rem",
                "color": "var(--scm-text-muted, #8A837B)"
            },
            "text": "$t:superbify.mypage.wishlist.add_to_cart_note"
        },
        {
            "comment": "SRC Pagination — BASIC onPageChange setState+refetch 체인 유지",
            "type": "composite",
            "name": "Pagination",
            "id": "wishlist_pagination",
            "props": {
                "currentPage": "{{Number(wishlist?.data?.pagination?.current_page ?? 1)}}",
                "totalPages": "{{Number(wishlist?.data?.pagination?.last_page ?? 1)}}",
                "prevLabel": "$t:superbify.notice.prev_page_aria",
                "nextLabel": "$t:superbify.notice.next_page_aria",
                "pageLabel": "$t:superbify.notice.page_aria"
            },
            "actions": [
                {
                    "event": "onPageChange",
                    "handler": "sequence",
                    "actions": [
                        {
                            "handler": "setState",
                            "params": { "target": "local", "wishlistPage": "{{$args[0]}}" }
                        },
                        {
                            "handler": "refetchDataSource",
                            "params": { "dataSourceId": "wishlist" }
                        }
                    ]
                }
            ]
        }
    ]
}
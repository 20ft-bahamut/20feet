{
    "version": "1.0.0",
    "layout_name": "admin_site_form",
    "permissions": [
        "pinkbro-contents.site.read"
    ],
    "extends": "_admin_base",
    "meta": {
        "title": "$t:pinkbro-contents.menu.site",
        "description": "$t:pinkbro-contents.description"
    },
    "state": {
        "isSaving": false,
        "errors": null
    },
    "data_sources": [
        {
            "id": "site",
            "label_key": "$t:pinkbro-contents.menu.site",
            "type": "api",
            "endpoint": "/api/modules/pinkbro-contents/admin/site",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "initLocal": "form",
            "loading_strategy": "blocking",
            "errorHandling": {
                "404": {
                    "handler": "showErrorPage",
                    "params": {
                        "target": "content"
                    }
                },
                "403": {
                    "handler": "showErrorPage",
                    "params": {
                        "target": "content"
                    }
                }
            }
        }
    ],
    "slots": {
        "content": [
            {
                "id": "site_wrapper",
                "type": "basic",
                "name": "Div",
                "dataKey": "form",
                "props": {
                    "className": "admin-page-content"
                },
                "children": [
                    {
                        "id": "page_header",
                        "type": "composite",
                        "name": "PageHeader",
                        "props": {
                            "title": "$t:pinkbro-contents.menu.site",
                            "description": "$t:pinkbro-contents.description"
                        },
                        "children": [
                            {
                                "id": "back_to_dashboard",
                                "type": "basic",
                                "name": "A",
                                "props": {
                                    "href": "/admin/pinkbro-contents",
                                    "className": "px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 bg-gray-100 dark:bg-gray-700 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors no-underline"
                                },
                                "text": "$t:pinkbro-contents.menu.dashboard"
                            },
                            {
                                "type": "basic",
                                "name": "Button",
                                "props": {
                                    "disabled": "{{_local.isSaving}}",
                                    "className": "px-4 py-2 text-sm font-medium text-white bg-blue-600 dark:bg-blue-500 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                },
                                "actions": [
                                    {
                                        "type": "click",
                                        "handler": "sequence",
                                        "params": {
                                            "actions": [
                                                {
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "local",
                                                        "isSaving": true,
                                                        "errors": null
                                                    }
                                                },
                                                {
                                                    "handler": "apiCall",
                                                    "auth_required": true,
                                                    "target": "/api/modules/pinkbro-contents/admin/site",
                                                    "params": {
                                                        "method": "PUT",
                                                        "body": "{{ {brand_name: _local.form?.brand_name ?? '', brand_name_en: _local.form?.brand_name_en ?? '', tagline: _local.form?.tagline ?? '', eyebrow: _local.form?.eyebrow ?? '', phone: _local.form?.phone ?? '', kakao_channel: _local.form?.kakao_channel ?? '', region: _local.form?.region ?? ''} }}"
                                                    },
                                                    "onSuccess": [
                                                        {
                                                            "handler": "setState",
                                                            "params": {
                                                                "target": "local",
                                                                "isSaving": false,
                                                                "errors": null
                                                            }
                                                        },
                                                        {
                                                            "handler": "toast",
                                                            "params": {
                                                                "type": "success",
                                                                "message": "저장했습니다."
                                                            }
                                                        },
                                                        {
                                                            "handler": "navigate",
                                                            "params": {
                                                                "path": "/admin/pinkbro-contents/site",
                                                                "mergeQuery": true,
                                                                "query": {}
                                                            }
                                                        }
                                                    ],
                                                    "onError": [
                                                        {
                                                            "handler": "setState",
                                                            "params": {
                                                                "target": "local",
                                                                "isSaving": false,
                                                                "errors": "{{error.errors}}"
                                                            }
                                                        },
                                                        {
                                                            "handler": "toast",
                                                            "params": {
                                                                "type": "error",
                                                                "message": "{{error.message ?? '저장에 실패했습니다.'}}"
                                                            }
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    }
                                ],
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "{{_local.isSaving ? '저장 중...' : '저장'}}"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "site_form_card",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "mt-6 p-6 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl space-y-4"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "H3",
                                "props": {
                                    "className": "text-lg font-semibold text-gray-900 dark:text-white mb-4"
                                },
                                "text": "$t:pinkbro-contents.menu.site"
                            },
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "grid grid-cols-1 md:grid-cols-2 gap-4"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "space-y-1"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Label",
                                                "props": {
                                                    "className": "text-sm font-medium text-gray-700 dark:text-gray-300"
                                                },
                                                "text": "브랜드 이름"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Input",
                                                "props": {
                                                    "name": "brand_name",
                                                    "className": "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-sm",
                                                    "type": "text"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "space-y-1"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Label",
                                                "props": {
                                                    "className": "text-sm font-medium text-gray-700 dark:text-gray-300"
                                                },
                                                "text": "브랜드 영문명"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Input",
                                                "props": {
                                                    "name": "brand_name_en",
                                                    "className": "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-sm",
                                                    "type": "text"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "space-y-1"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Label",
                                                "props": {
                                                    "className": "text-sm font-medium text-gray-700 dark:text-gray-300"
                                                },
                                                "text": "태그라인"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Input",
                                                "props": {
                                                    "name": "tagline",
                                                    "className": "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-sm",
                                                    "type": "text"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "space-y-1"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Label",
                                                "props": {
                                                    "className": "text-sm font-medium text-gray-700 dark:text-gray-300"
                                                },
                                                "text": "아이브로우"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Input",
                                                "props": {
                                                    "name": "eyebrow",
                                                    "className": "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-sm",
                                                    "type": "text"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "space-y-1"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Label",
                                                "props": {
                                                    "className": "text-sm font-medium text-gray-700 dark:text-gray-300"
                                                },
                                                "text": "대표 전화"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Input",
                                                "props": {
                                                    "name": "phone",
                                                    "className": "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-sm",
                                                    "type": "text"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "space-y-1"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Label",
                                                "props": {
                                                    "className": "text-sm font-medium text-gray-700 dark:text-gray-300"
                                                },
                                                "text": "카카오채널 URL"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Input",
                                                "props": {
                                                    "name": "kakao_channel",
                                                    "className": "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-sm",
                                                    "type": "text"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "space-y-1"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Label",
                                                "props": {
                                                    "className": "text-sm font-medium text-gray-700 dark:text-gray-300"
                                                },
                                                "text": "출장 지역"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Input",
                                                "props": {
                                                    "name": "region",
                                                    "className": "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-sm",
                                                    "type": "text"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "type": "basic",
                                "name": "P",
                                "props": {
                                    "className": "text-sm text-gray-500 dark:text-gray-400"
                                },
                                "text": "공유 이미지(og:image)는 미디어 화면의 site_og 슬롯에서 관리합니다."
                            }
                        ]
                    }
                ]
            }
        ]
    }
}

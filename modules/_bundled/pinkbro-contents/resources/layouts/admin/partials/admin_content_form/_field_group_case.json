{
  "meta": {
    "is_partial": true,
    "description": "case 도메인 필드 그룹 — SPEC §4.5 키: title, summary, blog_url, cover_slot, sort"
  },
  "id": "field_group_case",
  "type": "basic",
  "name": "Div",
  "if": "{{route.domain === 'case'}}",
  "children": [
    {
      "id": "case_basic_card",
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "mt-6 p-6 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl space-y-4"
      },
      "children": [
        {
          "type": "basic",
          "name": "H3",
          "props": {
            "className": "text-lg font-semibold text-gray-900 dark:text-white mb-4"
          },
          "text": "기본 정보"
        },
        {
          "id": "field_case_title",
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "space-y-1"
          },
          "children": [
            {
              "type": "basic",
              "name": "Label",
              "props": {
                "className": "text-sm font-medium text-gray-700 dark:text-gray-300"
              },
              "text": "제목 (필수)"
            },
            {
              "type": "basic",
              "name": "Input",
              "props": {
                "type": "text",
                "className": "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-sm",
                "value": "{{_local.form.title ?? ''}}"
              },
              "actions": [
                {
                  "type": "change",
                  "handler": "setState",
                  "params": {
                    "target": "_local",
                    "form.title": "{{$event.target.value}}"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "field_case_summary",
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "space-y-1"
          },
          "children": [
            {
              "type": "basic",
              "name": "Label",
              "props": {
                "className": "text-sm font-medium text-gray-700 dark:text-gray-300"
              },
              "text": "요약"
            },
            {
              "type": "basic",
              "name": "Textarea",
              "props": {
                "rows": 3,
                "className": "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-sm",
                "value": "{{_local.form.summary ?? ''}}"
              },
              "actions": [
                {
                  "type": "change",
                  "handler": "setState",
                  "params": {
                    "target": "_local",
                    "form.summary": "{{$event.target.value}}"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "field_case_blog_url",
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "space-y-1"
          },
          "children": [
            {
              "type": "basic",
              "name": "Label",
              "props": {
                "className": "text-sm font-medium text-gray-700 dark:text-gray-300"
              },
              "text": "블로그 URL"
            },
            {
              "type": "basic",
              "name": "Input",
              "props": {
                "type": "text",
                "className": "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-sm",
                "value": "{{_local.form.blog_url ?? ''}}"
              },
              "actions": [
                {
                  "type": "change",
                  "handler": "setState",
                  "params": {
                    "target": "_local",
                    "form.blog_url": "{{$event.target.value}}"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "field_case_cover_slot",
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "space-y-1"
          },
          "children": [
            {
              "type": "basic",
              "name": "Label",
              "props": {
                "className": "text-sm font-medium text-gray-700 dark:text-gray-300"
              },
              "text": "커버 슬롯"
            },
            {
              "type": "basic",
              "name": "Input",
              "props": {
                "type": "text",
                "className": "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-sm",
                "value": "{{_local.form.cover_slot ?? ''}}"
              },
              "actions": [
                {
                  "type": "change",
                  "handler": "setState",
                  "params": {
                    "target": "_local",
                    "form.cover_slot": "{{$event.target.value}}"
                  }
                }
              ]
            },
            {
              "type": "basic",
              "name": "P",
              "props": {
                "className": "text-xs text-gray-500 dark:text-gray-400"
              },
              "text": "미디어 슬롯 키 (예: case_1) — 비어 있으면 랜딩 폴백이 표시됩니다."
            }
          ]
        },
        {
          "id": "field_case_sort",
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "space-y-1"
          },
          "children": [
            {
              "type": "basic",
              "name": "Label",
              "props": {
                "className": "text-sm font-medium text-gray-700 dark:text-gray-300"
              },
              "text": "정렬"
            },
            {
              "type": "basic",
              "name": "Input",
              "props": {
                "type": "number",
                "className": "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-sm",
                "value": "{{_local.form.sort ?? 0}}"
              },
              "actions": [
                {
                  "type": "change",
                  "handler": "setState",
                  "params": {
                    "target": "_local",
                    "form.sort": "{{$event.target.value === '' ? null : Number($event.target.value)}}"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
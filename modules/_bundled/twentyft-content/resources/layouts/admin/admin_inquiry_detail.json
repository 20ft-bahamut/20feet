                                                "props": {
                                                    "className": "text-sm font-medium text-gray-700 dark:text-gray-300"
                                                },
                                                "text": "$t:twentyft-content.admin.fields.internal_status"
                                            },
                                            {
                                                "type": "composite",
                                                "name": "Select",
                                                "props": {
                                                    "name": "internalStatus",
                                                    "options": [
                                                        {
                                                            "value": "NEW",
                                                            "label": "$t:twentyft-content.admin.inquiry_status.new"
                                                        },
                                                        {
                                                            "value": "REVIEWING",
                                                            "label": "$t:twentyft-content.admin.inquiry_status.reviewing"
                                                        },
                                                        {
                                                            "value": "REPLIED",
                                                            "label": "$t:twentyft-content.admin.inquiry_status.replied"
                                                        },
                                                        {
                                                            "value": "MEETING",
                                                            "label": "$t:twentyft-content.admin.inquiry_status.meeting"
                                                        },
                                                        {
                                                            "value": "ESTIMATING",
                                                            "label": "$t:twentyft-content.admin.inquiry_status.estimating"
                                                        },
                                                        {
                                                            "value": "CLOSED",
                                                            "label": "$t:twentyft-content.admin.inquiry_status.closed"
                                                        }
                                                    ],
                                                    "className": "w-full"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "space-y-1"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Label",
                                                "props": {
                                                    "className": "text-sm font-medium text-gray-700 dark:text-gray-300"
                                                },
                                                "text": "$t:twentyft-content.admin.fields.current_status"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "text-sm font-medium text-gray-900 dark:text-white"
                                                },
                                                "text": "{{_local.form?.internalStatusLabel || '-'}}"
                                            }
                                        ]
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "space-y-1"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Button",
                                                "props": {
                                                    "disabled": "{{_local.isSaving}}",
                                                    "className": "w-full px-4 py-2 text-sm font-medium text-white bg-blue-600 dark:bg-blue-500 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                                },
                                                "actions": [
                                                    {
                                                        "type": "click",
                                                        "handler": "sequence",
                                                        "params": {
                                                            "actions": [
                                                                {
                                                                    "handler": "setState",
                                                                    "params": {
                                                                        "target": "local",
                                                                        "isSaving": true,
                                                                        "errors": null
                                                                    }
                                                                },
                                                                {
                                                                    "handler": "apiCall",
                                                                    "auth_required": true,
                                                                    "target": "/api/modules/twentyft-content/admin/inquiries/{{route.post_id}}/status",
                                                                    "params": {
                                                                        "method": "PATCH",
                                                                        "body": {
                                                                            "status": "{{_local.form.internalStatus}}"
                                                                        }
                                                                    },
                                                                    "onSuccess": [
                                                                        {
                                                                            "handler": "setState",
                                                                            "params": {
                                                                                "target": "local",
                                                                                "isSaving": false,
                                                                                "errors": null
                                                                            }
                                                                        },
                                                                        {
                                                                            "handler": "toast",
                                                                            "params": {
                                                                                "type": "success",
                                                                                "message": "$t:twentyft-content.admin.messages.status_success"
                                                                            }
                                                                        },
                                                                        {
                                                                            "handler": "navigate",
                                                                            "params": {
                                                                                "path": "/admin/20ft-content/inquiries",
                                                                                "mergeQuery": true,
                                                                                "query": {}
                                                                            }
                                                                        }
                                                                    ],
                                                                    "onError": [
                                                                        {
                                                                            "handler": "setState",
                                                                            "params": {
                                                                                "target": "local",
                                                                                "isSaving": false,
                                                                                "errors": "{{error.errors}}"
                                                                            }
                                                                        },
                                                                        {
                                                                            "handler": "toast",
                                                                            "params": {
                                                                                "type": "error",
                                                                                "message": "{{error.message ?? '$t:twentyft-content.admin.messages.status_failed'}}"
                                                                            }
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    }
                                                ],
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "text": "{{_local.isSaving ? '$t:twentyft-content.common.saving' : '$t:twentyft-content.admin.status.update'}}"
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}

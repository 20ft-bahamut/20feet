    "entries": [
        {"location": "lang/ko.json:393 / en.json:393", "page": "home", "key": "home.promo.title", "text_ko": "오늘의 한 권", "text_en": "One piece at a time", "kind": "heading", "flag": ""},
        {"location": "lang/ko.json:394 / en.json:394", "page": "home", "key": "home.promo.description", "text_ko": "책꽂이 위에 머무는 단행본 한 권처럼, 일상에 한 점 더해지는 물건을 소개합니다.", "text_en": "Like a single volume on a shelf — objects earn their place by being used, day after day.", "kind": "policy/longform", "flag": ""},
        {"location": "lang/ko.json:397 / en.json:397", "page": "home", "key": "home.final_cta.eyebrow", "text_ko": "EXPLORE", "text_en": "EXPLORE", "kind": "label", "flag": ""},
        {"location": "lang/ko.json:398 / en.json:398", "page": "home", "key": "home.final_cta.heading", "text_ko": "조용한 일상의 모든 물건을 한 자리에서", "text_en": "Everyday quiet objects, in one place", "kind": "heading", "flag": ""},
        {"location": "lang/ko.json:399 / en.json:399", "page": "home", "key": "home.final_cta.body", "text_ko": "지금 전체 Shop을 둘러보고, 오래 머무를 한 가지 물건을 골라보세요.", "text_en": "Browse the full Shop and find one piece that will stay with you for years.", "kind": "policy/longform", "flag": ""},
